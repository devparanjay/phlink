# build/gn-args/mac.gn
#
# macOS build args. Imports the common baseline.

target_os = "mac"
# Apple Silicon is the assumed dev target; override on x86_64 hosts via
# `gn gen --args='target_cpu="x64"'`.
target_cpu = "arm64"

# Don't bundle proprietary codecs by default.
proprietary_codecs = false
ffmpeg_branding = "Chromium"

# Don't sign by default (signing happens in Phase 10).
mac_deployment_target = "11.0"
