# build/gn-args/common.gni
#
# Shared GN argument baseline for phlink builds across all platforms.
#
# Per-platform files (linux.gn, mac.gn, win.gn) source these defaults and add
# platform-specific tweaks. Lines beginning with '#' are stripped by the
# scripts/gn-gen.{sh,ps1} wrappers before being passed to `gn gen`.
#
# Phase 1 keeps this minimal — telemetry/branding/privacy flags layer in
# Phases 3, 4, 6.

# Build mode
is_debug = false
is_component_build = false
symbol_level = 1
blink_symbol_level = 0

# Disable Native Client (deprecated, not needed)
enable_nacl = false

# Don't fail builds on warnings (we may add new ones during phlink work)
treat_warnings_as_errors = false

# Skip Profile-Guided Optimization for fast iteration; production builds
# will turn this on in a later phase.
chrome_pgo_phase = 0

# We don't ship Google API keys. Phase 3 will also strip Google services
# wholesale; this just makes sure no upstream defaults leak in.
use_official_google_api_keys = false
google_api_key = ""
google_default_client_id = ""
google_default_client_secret = ""

# We're not Google's distribution
is_chrome_branded = false

# Defensive: never enable the Chrome-for-Testing branding lane either.
is_chrome_for_testing_branded = false

# External contributors don't have access to Reclient
use_remoteexec = false

# Use sccache as a compile-cache wrapper. Required for incremental builds to
# stay sane on a single workstation; install via `brew install sccache` on
# macOS or `cargo install sccache` elsewhere. Make sure SCCACHE_DIR has
# enough headroom (Chromium needs ~50 GB cold).
cc_wrapper = "sccache"

# ---------------------------------------------------------------------------
# Phase 3 — Identity & services strip
#
# These pin the no-Google-services posture from PRD §10.1 even if upstream
# Chromium changes its defaults. Most are already implied by
# is_chrome_branded=false but we keep them explicit so a future rebase can't
# silently re-enable them.

# Safe Browsing: kept at upstream default. Brave-style safe_browsing_mode=0
# breaks dep resolution for unit_tests/browser_tests targets (~30 patch
# files needed to fix the assertions). Runtime SB pings already need
# Google API keys (which we don't ship) and are neutered by Phase 4
# enable_reporting=false. A dedicated phase will revisit a full strip.
# safe_browsing_mode = 0  (deferred)

# No bundled Widevine CDM by default. (Already false when unbranded; pinned.)
enable_widevine = false

# No Chrome Remote Desktop / remoting host.
enable_remoting = false

# No Hangouts services extension (legacy GoogleMeet hooks).
enable_hangout_services_extension = false

# enable_supervised_users: left at upstream default (true). Setting it
# false is asserted on by 6+ //chrome/ BUILD.gn files; the surface is
# already inert when is_chrome_branded=false (no Family Link sign-in,
# no Google API keys). Revisit in a later phase as a binary-size lever.

# No field-trial testing config baked into the binary (would phone home).
disable_fieldtrial_testing_config = true

# No bundled Cast Receiver: cast_allow_developer_certificate was removed
# upstream (no longer in declare_args). Cast sender (the chrome://cast UI)
# is governed by chrome_branded; we already have is_chrome_branded=false.

# ---------------------------------------------------------------------------
# Phase 4 — Telemetry-Free Defaults
#
# These pin the "no phone-home" posture (PRD §3.5, TELM-01..TELM-04).
# Source-side patches in patches/0050-* and patches/0060-* layer on top so
# even pref corruption can't re-enable upload.

# No metrics/crash uploader pipeline. The histogram macros still build
# (components rely on them) but the uploader path is dead.
enable_reporting = false

# No bundled "Send feedback" uploader.
enable_feedback_service = false
