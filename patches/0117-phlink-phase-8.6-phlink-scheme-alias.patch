+#ifndef CHROME_COMMON_PHLINK_URL_CONSTANTS_H_
+#define CHROME_COMMON_PHLINK_URL_CONSTANTS_H_
+
+#include <string_view>
+
+namespace phlink {
+
+// The phlink-branded WebUI URL scheme. Aliased to chrome:// internally
+// (see ChromeContentBrowserClient::BrowserURLHandlerCreated). All
+// phlink:// URLs are rewritten to chrome:// before navigation commit;
+// chrome:// URLs are rewritten back to phlink:// for omnibox display
+// when the host is in the canonical allow-list.
+//
+// Phase 8.6 — BRND-02 (PRD §3.6).
+inline constexpr char kPhlinkUIScheme[] = "phlink";
+
+// Hosts whose chrome:// form should be reverse-rewritten to phlink://
+// for display purposes. Any chrome://X not in this list is left as-is
+// (e.g. internal dev surfaces like chrome://internals/).
+inline constexpr std::string_view kPhlinkCanonicalHosts[] = {
+    "settings",   "flags",      "version",   "about",   "newtab",
+    "components", "extensions", "history",   "bookmarks",
+    "downloads",  "inspect",    "policy",
+};
+
+}  // namespace phlink
+
+#endif  // CHROME_COMMON_PHLINK_URL_CONSTANTS_H_
