@@ -30,6 +30,7 @@
 #include "chrome/common/chrome_switches.h"
 #include "chrome/common/crash_keys.h"
 #include "chrome/common/media/cdm_registration.h"
+#include "chrome/common/phlink_url_constants.h"
 #include "chrome/common/url_constants.h"
 #include "chrome/grit/common_resources.h"
 #include "chrome/grit/generated_resources.h"
@@ -204,6 +205,13 @@ void ChromeContentClient::AddAdditionalSchemes(Schemes* schemes) {
   for (auto* standard_scheme : kChromeStandardURLSchemes)
     schemes->standard_schemes.push_back(standard_scheme);
 
+  // phlink: scheme — alias of chrome:// for branded WebUI URLs.
+  // See chrome/common/phlink_url_constants.h and
+  // ChromeContentBrowserClient::BrowserURLHandlerCreated for the
+  // bidirectional rewrite. Phase 8.6 — BRND-02 (PRD §3.6).
+  schemes->standard_schemes.push_back(phlink::kPhlinkUIScheme);
+  schemes->secure_schemes.push_back(phlink::kPhlinkUIScheme);
+
 #if BUILDFLAG(IS_ANDROID)
   schemes->referrer_schemes.push_back(content::kAndroidAppScheme);
   schemes->referrer_schemes.push_back(dom_distiller::kDomDistillerScheme);
diff --git a/chrome/common/phlink_url_constants.h b/chrome/common/phlink_url_constants.h
new file mode 100644
index 0000000000000..9a4cb6c49f255
--- /dev/null
+++ b/chrome/common/phlink_url_constants.h
@@ -0,0 +1,32 @@
