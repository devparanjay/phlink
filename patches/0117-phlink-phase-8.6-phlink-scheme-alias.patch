From ed1c1d7e31606054ddf649bbeca0ae13948942db Mon Sep 17 00:00:00 2001
From: phlink <phlink@local>
Date: Wed, 29 Apr 2026 20:44:19 +0530
Subject: [PATCH] phlink: phase 8.6 phlink:// scheme alias
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Add `phlink://` as a display+entry alias of `chrome://` for branded
WebUI URLs. The internal scheme constant `kChromeUIScheme` is left
unchanged ("chrome") to preserve compatibility with the ~4,700 sites
across the tree that hardcode it; phlink:// is implemented as a
bidirectional URL rewrite at the BrowserURLHandler layer (same hook
pattern Chromium itself uses for about:→chrome:).

Decisions: see .planning/phases/08.6-phlink-scheme-alias/08.6-CONTEXT.md.

Files:
  chrome/common/phlink_url_constants.h        (new) scheme + canonical hosts
  chrome/common/chrome_content_client.cc      register standard+secure scheme
  chrome/common/BUILD.gn                      include new header
  chrome/browser/chrome_content_browser_client.cc
                                              forward+reverse rewrite pair

Verification (Phase 8.6 BRND-02):
  tests/branding-audit/runtime-audit.py extended with SURFACES_PHLINK.
  28/28 surfaces PASS (chrome:// + phlink://).

Refs PRD §3.6 BRND-02. Phase 8.6.
---
 .../browser/chrome_content_browser_client.cc  | 48 +++++++++++++++++++
 chrome/common/BUILD.gn                        |  1 +
 chrome/common/chrome_content_client.cc        |  8 ++++
 chrome/common/phlink_url_constants.h          | 32 +++++++++++++
 4 files changed, 89 insertions(+)
 create mode 100644 chrome/common/phlink_url_constants.h

diff --git a/chrome/browser/chrome_content_browser_client.cc b/chrome/browser/chrome_content_browser_client.cc
index 9a0d5fc91edc8..402e14b69e7e0 100644
--- a/chrome/browser/chrome_content_browser_client.cc
+++ b/chrome/browser/chrome_content_browser_client.cc
@@ -216,6 +216,7 @@
 #include "chrome/common/renderer_configuration.mojom.h"
 #include "chrome/common/request_header_integrity/buildflags.h"
 #include "chrome/common/secure_origin_allowlist.h"
+#include "chrome/common/phlink_url_constants.h"
 #include "chrome/common/url_constants.h"
 #include "chrome/common/webui_url_constants.h"
 #include "chrome/common/webui_url_utils.h"
@@ -864,6 +865,46 @@ bool HandleNewTabPageLocationOverride(
   return true;
 }
 
+// phlink: scheme rewrite — Phase 8.6 (BRND-02).
+//
+// Forward: phlink://X  →  chrome://X (always).
+bool HandlePhlinkSchemeRewrite(GURL* url,
+                               content::BrowserContext* browser_context) {
+  if (!url->SchemeIs(phlink::kPhlinkUIScheme)) {
+    return false;
+  }
+  GURL::Replacements replacements;
+  replacements.SetSchemeStr(content::kChromeUIScheme);
+  *url = url->ReplaceComponents(replacements);
+  // Returning false continues the rewrite chain so the chrome:// handlers
+  // (HandleWebUI etc.) see the rewritten URL and dispatch normally.
+  return false;
+}
+
+// Reverse: chrome://X  →  phlink://X for allow-listed canonical hosts.
+// Used by the omnibox / location-bar display path.
+bool HandlePhlinkSchemeReverse(GURL* url,
+                               content::BrowserContext* browser_context) {
+  if (!url->SchemeIs(content::kChromeUIScheme)) {
+    return false;
+  }
+  const std::string_view host = url->host();
+  bool allowed = false;
+  for (std::string_view canonical : phlink::kPhlinkCanonicalHosts) {
+    if (host == canonical) {
+      allowed = true;
+      break;
+    }
+  }
+  if (!allowed) {
+    return false;
+  }
+  GURL::Replacements replacements;
+  replacements.SetSchemeStr(phlink::kPhlinkUIScheme);
+  *url = url->ReplaceComponents(replacements);
+  return true;
+}
+
 #if !BUILDFLAG(IS_ANDROID)
 bool IsFileOrDirectoryPickerWithoutGestureAllowed(
     content::WebContents* contents) {
@@ -5075,6 +5116,13 @@ bool ChromeContentBrowserClient::
 
 void ChromeContentBrowserClient::BrowserURLHandlerCreated(
     BrowserURLHandler* handler) {
+  // phlink: scheme alias — Phase 8.6 (BRND-02). Must run before the
+  // chrome: handlers so phlink://X is rewritten to chrome://X before
+  // any other rewriter (NTP override, about-rewrite, WebUI dispatch)
+  // sees the URL.
+  handler->AddHandlerPair(&HandlePhlinkSchemeRewrite,
+                          &HandlePhlinkSchemeReverse);
+
   // The group policy NTP URL handler must be registered before the other NTP
   // URL handlers below. Also register it before the "parts" handlers, so the
   // NTP policy takes precedence over extensions that override the NTP.
