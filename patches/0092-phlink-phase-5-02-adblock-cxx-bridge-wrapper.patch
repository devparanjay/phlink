diff --git a/chrome/browser/phlink/adblock/phlink_adblock.cc b/chrome/browser/phlink/adblock/phlink_adblock.cc
new file mode 100644
index 0000000000000..b6f613d4e6399
--- /dev/null
+++ b/chrome/browser/phlink/adblock/phlink_adblock.cc
@@ -0,0 +1,55 @@
+// Copyright 2026 The phlink Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/phlink/adblock/phlink_adblock.h"
+
+#include <string>
+#include <utility>
+
+namespace phlink::adblock {
+
+namespace {
+
+// `cxx` exposes `&str` parameters as `::rust::Str`. Wrap a `string_view`
+// without copying.
+::rust::Str ToRustStr(std::string_view sv) {
+  return ::rust::Str(sv.data(), sv.size());
+}
+
+}  // namespace
+
+Engine::Engine(::rust::Box<EngineHandle> handle) : handle_(std::move(handle)) {}
+
+Engine::~Engine() = default;
+
+// static
+std::unique_ptr<Engine> Engine::CreateEmpty() {
+  return std::unique_ptr<Engine>(new Engine(engine_new_empty()));
+}
+
+// static
+std::unique_ptr<Engine> Engine::CreateFromRules(std::string_view rules) {
+  return std::unique_ptr<Engine>(
+      new Engine(engine_new_from_rules(ToRustStr(rules))));
+}
+
+Engine::Decision Engine::ShouldBlock(std::string_view url,
+                                     std::string_view source_url,
+                                     std::string_view request_type) const {
+  BlockDecision raw = engine_should_block(*handle_, ToRustStr(url),
+                                          ToRustStr(source_url),
+                                          ToRustStr(request_type));
+  Decision out;
+  out.matched = raw.matched;
+  out.important = raw.important;
+  if (raw.has_redirect) {
+    out.redirect = std::string(raw.redirect);
+  }
+  if (raw.has_exception) {
+    out.exception = std::string(raw.exception);
+  }
+  return out;
+}
+
+}  // namespace phlink::adblock
diff --git a/chrome/browser/phlink/adblock/phlink_adblock.h b/chrome/browser/phlink/adblock/phlink_adblock.h
new file mode 100644
index 0000000000000..e2fbbfb7efe66
--- /dev/null
+++ b/chrome/browser/phlink/adblock/phlink_adblock.h
@@ -0,0 +1,71 @@
+// Copyright 2026 The phlink Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_PHLINK_ADBLOCK_PHLINK_ADBLOCK_H_
+#define CHROME_BROWSER_PHLINK_ADBLOCK_PHLINK_ADBLOCK_H_
+
+#include <memory>
+#include <string>
+#include <string_view>
+
+// Pulls in `::rust::Box` and the cxx-generated `phlink::adblock::EngineHandle`
+// opaque type used as `Box`'s template parameter below.
+#include "chrome/browser/phlink/adblock/phlink_adblock_ffi.rs.h"
+
+namespace phlink::adblock {
+
+// Thin C++ owner of an `adblock::Engine` constructed in Rust.
+//
+// Phase 5-02 surface: just enough to answer "should this URL be blocked
+// under these rules?" so plan 5-03 can plug it into a URLLoaderThrottle.
+//
+// Thread-safety: this build of `adblock-rust` is compiled with
+// `default-features = false` (i.e. without `single-thread`), so the
+// underlying engine wraps its mutable state in `std::sync::Mutex`.
+// `Engine` therefore makes `&self` calls safe from multiple threads;
+// concurrent calls will serialize on the mutex. That is acceptable for
+// 5-02 (correctness over throughput); 5-03 may layer a per-thread cached
+// `Engine` if benchmarks justify it.
+class Engine {
+ public:
+  // Decision returned by `ShouldBlock`. Mirrors the Rust-side
+  // `BlockDecision`, but in plain C++ types so callers don't need to
+  // touch `cxx::String`.
+  struct Decision {
+    bool matched = false;
+    bool important = false;
+    std::string redirect;   // Empty if none.
+    std::string exception;  // Empty if none.
+  };
+
+  // Builds an empty engine. `ShouldBlock` will always return
+  // `matched=false`. Useful for tests and for the
+  // "adblock-disabled-but-wired" runtime state.
+  static std::unique_ptr<Engine> CreateEmpty();
+
+  // Builds an engine from a textual filter list (one rule per line, in the
+  // EasyList / uBO syntax that `adblock-rust` accepts). Parsing is
+  // total: malformed lines are silently skipped by the Rust side.
+  static std::unique_ptr<Engine> CreateFromRules(std::string_view rules);
+
+  Engine(const Engine&) = delete;
+  Engine& operator=(const Engine&) = delete;
+  ~Engine();
+
+  // Asks the engine whether `url` (loaded from `source_url`, with the
+  // adblock-rust `request_type` vocabulary, e.g. `"script"`) should be
+  // blocked. On a malformed URL the call fails open: `matched=false`.
+  Decision ShouldBlock(std::string_view url,
+                       std::string_view source_url,
+                       std::string_view request_type) const;
+
+ private:
+  explicit Engine(::rust::Box<EngineHandle> handle);
+
+  ::rust::Box<EngineHandle> handle_;
+};
+
+}  // namespace phlink::adblock
+
+#endif  // CHROME_BROWSER_PHLINK_ADBLOCK_PHLINK_ADBLOCK_H_
