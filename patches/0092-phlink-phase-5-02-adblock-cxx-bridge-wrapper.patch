diff --git a/chrome/browser/phlink/adblock/phlink_adblock_ffi.rs b/chrome/browser/phlink/adblock/phlink_adblock_ffi.rs
new file mode 100644
index 0000000000000..b5443a5bb75e2
--- /dev/null
+++ b/chrome/browser/phlink/adblock/phlink_adblock_ffi.rs
@@ -0,0 +1,118 @@
+// Copyright 2026 The phlink Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+//! `cxx::bridge` glue between phlink's C++ adblock surface and the
+//! vendored [`adblock`] crate (Brave's `adblock-rust`, MPL-2.0).
+//!
+//! Phase 5-02 deliverable: a minimal, single-thread-safe (because we use the
+//! `Mutex`-protected, non-`single-thread` build of the engine) wrapper that
+//! lets C++ ask "should this network request be blocked?" given a set of
+//! filter-list rules. Higher-level concerns (URL-loader interception,
+//! cosmetic filtering, list management, prefs) land in 5-03..05.
+
+use adblock::lists::ParseOptions;
+use adblock::request::Request;
+use adblock::Engine;
+
+#[cxx::bridge(namespace = "phlink::adblock")]
+mod ffi {
+    /// Result of consulting the engine for a single network request.
+    ///
+    /// Only `matched` is consumed by callers in 5-02; the additional fields
+    /// are surfaced now so the Mojo / interceptor work in 5-03 doesn't need
+    /// another FFI roundtrip when it starts honoring `important` and
+    /// `redirect`.
+    #[derive(Debug)]
+    pub struct BlockDecision {
+        pub matched: bool,
+        pub important: bool,
+        pub has_redirect: bool,
+        pub redirect: String,
+        pub has_exception: bool,
+        pub exception: String,
+    }
+
+    extern "Rust" {
+        type EngineHandle;
+
+        /// Builds a new engine from a `\n`-separated rule list (the same
+        /// textual format used by EasyList / EasyPrivacy / uBO defaults).
+        ///
+        /// Returns an opaque handle. The Rust side performs all parsing and
+        /// optimization; the C++ side never sees the engine's internals.
+        fn engine_new_from_rules(rules: &str) -> Box<EngineHandle>;
+
+        /// Builds an empty engine — useful for tests and for the "adblock
+        /// disabled, but the wrapper is still wired" runtime state.
+        fn engine_new_empty() -> Box<EngineHandle>;
+
+        /// Asks the engine whether a request should be blocked.
+        ///
+        /// `request_type` follows adblock-rust's vocabulary
+        /// (`document`, `subdocument`, `script`, `stylesheet`, `image`,
+        /// `font`, `xmlhttprequest`, `websocket`, `media`, `ping`, `other`).
+        ///
+        /// On a malformed URL the call returns a `BlockDecision` with
+        /// `matched = false` so the caller fails open (allow). Per
+        /// PRD §6, blocking failures must never break navigation.
+        fn engine_should_block(
+            engine: &EngineHandle,
+            url: &str,
+            source_url: &str,
+            request_type: &str,
+        ) -> BlockDecision;
+    }
+}
+
+/// Newtype wrapper so `cxx` can pass an opaque type across the bridge
+/// without exposing `adblock::Engine`'s public surface to C++.
+pub struct EngineHandle(Engine);
+
+fn engine_new_empty() -> Box<EngineHandle> {
+    Box::new(EngineHandle(Engine::default()))
+}
+
+fn engine_new_from_rules(rules: &str) -> Box<EngineHandle> {
+    let lines: Vec<&str> = rules.lines().collect();
+    let engine = Engine::from_rules(lines, ParseOptions::default());
+    Box::new(EngineHandle(engine))
+}
+
+fn engine_should_block(
+    engine: &EngineHandle,
+    url: &str,
+    source_url: &str,
+    request_type: &str,
+) -> ffi::BlockDecision {
+    let request = match Request::new(url, source_url, request_type) {
+        Ok(r) => r,
+        Err(_) => {
+            return ffi::BlockDecision {
+                matched: false,
+                important: false,
+                has_redirect: false,
+                redirect: String::new(),
+                has_exception: false,
+                exception: String::new(),
+            };
+        }
+    };
+    let r = engine.0.check_network_request(&request);
+    let (has_redirect, redirect) = match r.redirect {
+        Some(s) => (true, s),
+        None => (false, String::new()),
+    };
+    let (has_exception, exception) = match r.exception {
+        Some(s) => (true, s),
+        None => (false, String::new()),
+    };
+    ffi::BlockDecision {
+        matched: r.matched,
+        important: r.important,
+        has_redirect,
+        redirect,
+        has_exception,
+        exception,
+    }
+}
diff --git a/chrome/browser/phlink/adblock/phlink_adblock_unittest.cc b/chrome/browser/phlink/adblock/phlink_adblock_unittest.cc
new file mode 100644
index 0000000000000..93eba10004b82
--- /dev/null
+++ b/chrome/browser/phlink/adblock/phlink_adblock_unittest.cc
@@ -0,0 +1,67 @@
+// Copyright 2026 The phlink Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/phlink/adblock/phlink_adblock.h"
+
+#include <memory>
+
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace phlink::adblock {
+namespace {
+
+TEST(PhlinkAdblockEngineTest, EmptyEngineBlocksNothing) {
+  auto engine = Engine::CreateEmpty();
+  ASSERT_TRUE(engine);
+  auto decision = engine->ShouldBlock("https://example.com/script.js",
+                                      "https://example.com/", "script");
+  EXPECT_FALSE(decision.matched);
+  EXPECT_FALSE(decision.important);
+  EXPECT_TRUE(decision.redirect.empty());
+  EXPECT_TRUE(decision.exception.empty());
+}
+
+TEST(PhlinkAdblockEngineTest, MalformedUrlFailsOpen) {
+  auto engine = Engine::CreateEmpty();
+  // adblock-rust rejects malformed URLs; the wrapper must not propagate
+  // that as a "block" decision (per PRD §6: never break navigation).
+  auto decision = engine->ShouldBlock("not a url", "also not a url", "script");
+  EXPECT_FALSE(decision.matched);
+}
+
+TEST(PhlinkAdblockEngineTest, SimpleHostBlock) {
+  // EasyList-style host rule: block every request to ad.example.invalid.
+  auto engine = Engine::CreateFromRules("||ad.example.invalid^");
+  ASSERT_TRUE(engine);
+
+  auto blocked = engine->ShouldBlock("https://ad.example.invalid/track.js",
+                                     "https://news.example.test/", "script");
+  EXPECT_TRUE(blocked.matched);
+
+  auto allowed = engine->ShouldBlock("https://news.example.test/article.js",
+                                     "https://news.example.test/", "script");
+  EXPECT_FALSE(allowed.matched);
+}
+
+TEST(PhlinkAdblockEngineTest, ExceptionRuleAllowsRequest) {
+  // Block all script on the host, then add an exception for one path.
+  auto engine = Engine::CreateFromRules(
+      "||tracker.example.invalid^$script\n"
+      "@@||tracker.example.invalid/legit.js^$script");
+  ASSERT_TRUE(engine);
+
+  auto blocked = engine->ShouldBlock(
+      "https://tracker.example.invalid/spy.js",
+      "https://news.example.test/", "script");
+  EXPECT_TRUE(blocked.matched);
+
+  auto allowed = engine->ShouldBlock(
+      "https://tracker.example.invalid/legit.js",
+      "https://news.example.test/", "script");
+  EXPECT_FALSE(allowed.matched);
+  EXPECT_FALSE(allowed.exception.empty());
+}
+
+}  // namespace
+}  // namespace phlink::adblock
