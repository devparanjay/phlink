+# Copyright 2026 The phlink Authors
+# Use of this source code is governed by a BSD-style license that can be
+# found in the LICENSE file.
+
+import("//chrome/browser/phlink/updater/phlink_updater.gni")
+import("//testing/test.gni")
+
+# Canonical-JSON encoder used both by the runtime client and unit tests.
+# OLPC / TUF flavour: sorted keys, no whitespace, integer numbers only.
+source_set("canonical_json") {
+  sources = [
+    "canonical_json.cc",
+    "canonical_json.h",
+  ]
+  deps = [ "//base" ]
+}
+
+# Pure C++ TUF v1.0.32 metadata client. No Rust crate, no `hyper`, no
+# `ring` -- backed by `crypto::sign::Verify(ED25519, ...)` (boringssl) and
+# `base::JSONReader`. See docs/dev/update-protocol.md.
+source_set("metadata") {
+  sources = [
+    "metadata_client.cc",
+    "metadata_client.h",
+  ]
+  deps = [
+    ":canonical_json",
+    "//base",
+    "//crypto",
+    "//third_party/boringssl",
+  ]
+}
+
+# Dev-only trust root. `phlink_updater_dev_root` (in phlink_updater.gni)
+# selects this. Production builds will replace it with `prod_root.json` in
+# Phase 10 plan 10-08.
+if (phlink_updater_dev_root) {
+  copy("dev_root_json") {
+    sources = [ "keys/dev_root.json" ]
+    outputs = [ "$root_out_dir/phlink/keys/{{source_file_part}}" ]
+  }
+}
+
+source_set("unit_tests") {
+  testonly = true
+  sources = [ "metadata_client_unittest.cc" ]
+  deps = [
+    ":canonical_json",
+    ":metadata",
+    "//base",
+    "//crypto",
+    "//testing/gtest",
+    "//third_party/boringssl",
+  ]
+}
+
+test("phlink_updater_unittests") {
+  deps = [
+    ":unit_tests",
+    "//base/test:run_all_unittests",
+  ]
+}
diff --git a/chrome/browser/phlink/updater/canonical_json.cc b/chrome/browser/phlink/updater/canonical_json.cc
new file mode 100644
index 0000000000000..a42d1b845dc37
--- /dev/null
+++ b/chrome/browser/phlink/updater/canonical_json.cc
@@ -0,0 +1,112 @@
+// Copyright 2026 The phlink Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/phlink/updater/canonical_json.h"
+
+#include <algorithm>
+#include <string_view>
+#include <vector>
+
+#include "base/strings/string_number_conversions.h"
+#include "base/values.h"
+
+namespace phlink::updater {
+
+namespace {
+
+bool Encode(const base::Value& value, std::string& out);
+
+void EncodeString(std::string_view s, std::string& out) {
+  out.push_back('"');
+  for (char c : s) {
+    if (c == '"' || c == '\\') {
+      out.push_back('\\');
+    }
+    out.push_back(c);
+  }
+  out.push_back('"');
+}
+
+bool EncodeDict(const base::DictValue& dict, std::string& out) {
+  // Sort keys by lexicographic byte order.
+  std::vector<std::string_view> keys;
+  keys.reserve(dict.size());
+  for (const auto kv : dict) {
+    keys.emplace_back(kv.first);
+  }
+  std::sort(keys.begin(), keys.end());
+
+  out.push_back('{');
+  bool first = true;
+  for (auto k : keys) {
+    if (!first) {
+      out.push_back(',');
+    }
+    first = false;
+    EncodeString(k, out);
+    out.push_back(':');
+    const base::Value* v = dict.Find(k);
+    if (!v || !Encode(*v, out)) {
+      return false;
+    }
+  }
+  out.push_back('}');
+  return true;
+}
+
+bool EncodeList(const base::ListValue& list, std::string& out) {
+  out.push_back('[');
+  bool first = true;
+  for (const base::Value& v : list) {
+    if (!first) {
+      out.push_back(',');
+    }
+    first = false;
+    if (!Encode(v, out)) {
+      return false;
+    }
+  }
+  out.push_back(']');
+  return true;
+}
+
+bool Encode(const base::Value& value, std::string& out) {
+  switch (value.type()) {
+    case base::Value::Type::NONE:
+      out.append("null");
+      return true;
+    case base::Value::Type::BOOLEAN:
+      out.append(value.GetBool() ? "true" : "false");
+      return true;
+    case base::Value::Type::INTEGER: {
+      out.append(base::NumberToString(value.GetInt()));
+      return true;
+    }
+    case base::Value::Type::DOUBLE:
+      // TUF canonical JSON forbids floats.
+      return false;
+    case base::Value::Type::STRING:
+      EncodeString(value.GetString(), out);
+      return true;
+    case base::Value::Type::DICT:
+      return EncodeDict(value.GetDict(), out);
+    case base::Value::Type::LIST:
+      return EncodeList(value.GetList(), out);
+    case base::Value::Type::BINARY:
+      return false;
+  }
+}
+
+}  // namespace
+
+std::optional<std::string> EncodeCanonicalJson(const base::Value& value) {
+  std::string out;
+  out.reserve(256);
+  if (!Encode(value, out)) {
+    return std::nullopt;
+  }
+  return out;
+}
+
+}  // namespace phlink::updater
diff --git a/chrome/browser/phlink/updater/canonical_json.h b/chrome/browser/phlink/updater/canonical_json.h
