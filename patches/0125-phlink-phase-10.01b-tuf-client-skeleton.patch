+// Copyright 2026 The phlink Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_PHLINK_UPDATER_METADATA_CLIENT_H_
+#define CHROME_BROWSER_PHLINK_UPDATER_METADATA_CLIENT_H_
+
+#include <array>
+#include <cstdint>
+#include <map>
+#include <memory>
+#include <optional>
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include "base/containers/span.h"
+#include "base/time/time.h"
+#include "base/types/expected.h"
+#include "base/values.h"
+
+namespace phlink::updater {
+
+// Result of any TUF metadata operation. Map onto user-visible logging in
+// `update.log` per docs/dev/update-protocol.md §9.
+enum class TufError {
+  kOk,
+  kBadJson,           // not parseable as JSON, or wrong shape.
+  kBadSignature,      // signature did not verify under the role's keyset.
+  kThresholdNotMet,   // fewer valid signatures than the role's threshold.
+  kExpired,           // metadata `expires` is in the past.
+  kRollback,          // server tried to serve a lower version than cached.
+  kVersionMismatch,   // snapshot/timestamp pinned a version that does
+                      // not match the role we just parsed.
+  kLengthMismatch,    // snapshot.json declared length != actual bytes.
+  kHashMismatch,      // snapshot.json declared sha256 != actual bytes.
+  kUnsupportedSpec,   // spec_version outside what we implement.
+  kUnknownRole,       // referenced role was not declared in root.
+  kMissingField,      // required JSON field absent.
+};
+
+// One entry from `targets.json`'s `targets` map. v1.0 alpha only carries
+// length + sha256; the `custom` block is parsed into `platform`/`arch`/
+// `channel` if present (see protocol §4.2).
+struct TargetMeta {
+  TargetMeta();
+  TargetMeta(const TargetMeta&);
+  TargetMeta(TargetMeta&&);
+  TargetMeta& operator=(const TargetMeta&);
+  TargetMeta& operator=(TargetMeta&&);
+  ~TargetMeta();
+
+  std::string name;
+  uint64_t length = 0;
+  std::array<uint8_t, 32> sha256{};
+  std::string platform;
+  std::string arch;
+  std::string channel;
+};
+
+// In-memory pure-C++ TUF v1.0.32 client.
+//
+// Construction: parse a trust-pinned root.json (e.g. the dev_root.json
+// shipped under `keys/`).
+//
+// Use: feed `IngestTimestamp` -> `IngestSnapshot` -> `IngestTargets` in
+// order. Each step verifies signatures, expirations, and version
+// monotonicity against the cached state.
+//
+// No I/O. No threading. The caller is responsible for fetching the bytes
+// (`network::SimpleURLLoader` in production; in-memory blobs in tests)
+// and for persisting cached versions across runs (10-02 will wire that).
+class TufClient {
+ public:
+  TufClient(TufClient&&);
+  TufClient& operator=(TufClient&&);
+  ~TufClient();
+
+  // Parse + verify the trust-pinned root. `now` is the wall-clock reference
+  // for `expires` checks (unit tests inject a fixed value).
+  static base::expected<TufClient, TufError> CreateWithRoot(
+      base::span<const uint8_t> root_json,
+      base::Time now);
+
+  TufError IngestTimestamp(base::span<const uint8_t> timestamp_json);
+  TufError IngestSnapshot(base::span<const uint8_t> snapshot_json);
+  TufError IngestTargets(base::span<const uint8_t> targets_json);
+
+  std::optional<TargetMeta> LookupTarget(std::string_view name) const;
+
+  uint64_t timestamp_version() const { return timestamp_version_; }
+  uint64_t snapshot_version() const { return snapshot_version_; }
+  uint64_t targets_version() const { return targets_version_; }
+
+ private:
+  // Per-role public-key entry parsed out of root.json.
+  struct KeyEntry {
+    std::array<uint8_t, 32> public_key;
+  };
+
+  struct RoleSpec {
+    RoleSpec();
+    RoleSpec(const RoleSpec&);
+    RoleSpec(RoleSpec&&);
+    RoleSpec& operator=(const RoleSpec&);
+    RoleSpec& operator=(RoleSpec&&);
+    ~RoleSpec();
+
+    std::vector<std::string> keyids;
+    int threshold = 0;
+  };
+
+  TufClient();
+
+  TufError VerifyRoleSignedBlock(const std::string& role_name,
+                                 const base::DictValue& outer);
+
+  base::Time now_;
+  std::map<std::string, KeyEntry> keys_;
+  std::map<std::string, RoleSpec> roles_;
+
+  uint64_t timestamp_version_ = 0;
+  uint64_t snapshot_version_ = 0;
+  uint64_t targets_version_ = 0;
+
+  // Pinned by timestamp.json so snapshot.json can be length+hash gated.
+  uint64_t expected_snapshot_version_ = 0;
+  uint64_t expected_snapshot_length_ = 0;
+  std::array<uint8_t, 32> expected_snapshot_sha256_{};
+  bool snapshot_pin_set_ = false;
+
+  // Pinned by snapshot.json.
+  uint64_t expected_targets_version_ = 0;
+  bool targets_pin_set_ = false;
+
+  std::map<std::string, TargetMeta> targets_;
+};
+
+}  // namespace phlink::updater
+
+#endif  // CHROME_BROWSER_PHLINK_UPDATER_METADATA_CLIENT_H_
diff --git a/chrome/browser/phlink/updater/metadata_client_unittest.cc b/chrome/browser/phlink/updater/metadata_client_unittest.cc
