index 0000000000000..8f472f128e064
--- /dev/null
+++ b/chrome/browser/phlink/updater/canonical_json.h
@@ -0,0 +1,31 @@
+// Copyright 2026 The phlink Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_PHLINK_UPDATER_CANONICAL_JSON_H_
+#define CHROME_BROWSER_PHLINK_UPDATER_CANONICAL_JSON_H_
+
+#include <optional>
+#include <string>
+
+#include "base/values.h"
+
+namespace phlink::updater {
+
+// Encodes `value` per the OLPC / TUF "canonical JSON" rules:
+//   * UTF-8 byte stream, no whitespace.
+//   * Object keys sorted by lexicographic byte order, no duplicate keys.
+//   * Strings JSON-escape only `\"` and `\\`; all other characters emitted
+//     as raw UTF-8 (no `\uXXXX`).
+//   * Numbers are integer-only; floats and exponents are rejected.
+//   * Booleans / null emitted as `true`/`false`/`null`.
+//
+// Returns std::nullopt if the value is not representable in canonical JSON
+// (e.g. contains a float or a non-string object key). Used for both
+// signature verification (re-canonicalize the parsed `signed` block before
+// hashing) and key-id derivation.
+std::optional<std::string> EncodeCanonicalJson(const base::Value& value);
+
+}  // namespace phlink::updater
+
+#endif  // CHROME_BROWSER_PHLINK_UPDATER_CANONICAL_JSON_H_
