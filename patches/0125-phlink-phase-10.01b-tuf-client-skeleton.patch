diff --git a/chrome/browser/phlink/updater/metadata_client.cc b/chrome/browser/phlink/updater/metadata_client.cc
new file mode 100644
index 0000000000000..0f3dae9630657
--- /dev/null
+++ b/chrome/browser/phlink/updater/metadata_client.cc
@@ -0,0 +1,526 @@
+// Copyright 2026 The phlink Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/phlink/updater/metadata_client.h"
+
+#include <algorithm>
+#include <set>
+#include <utility>
+
+#include "base/json/json_reader.h"
+#include "base/memory/raw_ptr.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/strings/string_util.h"
+#include "chrome/browser/phlink/updater/canonical_json.h"
+#include "crypto/keypair.h"
+#include "crypto/sign.h"
+#include "third_party/boringssl/src/include/openssl/sha.h"
+
+namespace phlink::updater {
+
+namespace {
+
+constexpr size_t kEd25519SignatureLen = 64;
+constexpr size_t kSha256Len = 32;
+constexpr std::string_view kSpecPrefix = "1.0.";
+
+bool DecodeHexFixed(std::string_view hex, base::span<uint8_t> out) {
+  if (hex.size() != out.size() * 2) {
+    return false;
+  }
+  std::vector<uint8_t> decoded;
+  if (!base::HexStringToBytes(hex, &decoded) || decoded.size() != out.size()) {
+    return false;
+  }
+  std::copy(decoded.begin(), decoded.end(), out.begin());
+  return true;
+}
+
+bool ParseExpires(const std::string& s, base::Time* out) {
+  return base::Time::FromUTCString(s.c_str(), out);
+}
+
+bool ParseUint64(const base::Value& v, uint64_t* out) {
+  if (!v.is_int()) {
+    return false;
+  }
+  int n = v.GetInt();
+  if (n < 0) {
+    return false;
+  }
+  *out = static_cast<uint64_t>(n);
+  return true;
+}
+
+}  // namespace
+
+TufClient::TufClient() = default;
+TufClient::TufClient(TufClient&&) = default;
+TufClient& TufClient::operator=(TufClient&&) = default;
+TufClient::~TufClient() = default;
+TargetMeta::TargetMeta() = default;
+TargetMeta::TargetMeta(const TargetMeta&) = default;
+TargetMeta::TargetMeta(TargetMeta&&) = default;
+TargetMeta& TargetMeta::operator=(const TargetMeta&) = default;
+TargetMeta& TargetMeta::operator=(TargetMeta&&) = default;
+TargetMeta::~TargetMeta() = default;
+
+TufClient::RoleSpec::RoleSpec() = default;
+TufClient::RoleSpec::RoleSpec(const RoleSpec&) = default;
+TufClient::RoleSpec::RoleSpec(RoleSpec&&) = default;
+TufClient::RoleSpec& TufClient::RoleSpec::operator=(const RoleSpec&) = default;
+TufClient::RoleSpec& TufClient::RoleSpec::operator=(RoleSpec&&) = default;
+TufClient::RoleSpec::~RoleSpec() = default;
+
+
+// Parse an outer `{ "signed": ..., "signatures": [...] }` envelope into its
+// two halves. Returns kBadJson on any structural problem.
+namespace {
+
+struct Envelope {
+  raw_ptr<const base::Value> signed_value;
+  raw_ptr<const base::ListValue> signatures;
+};
+
+std::optional<base::DictValue> ParseTopLevel(
+    base::span<const uint8_t> json_bytes) {
+  std::string_view sv(reinterpret_cast<const char*>(json_bytes.data()),
+                      json_bytes.size());
+  std::optional<base::Value> parsed =
+      base::JSONReader::Read(sv, base::JSON_PARSE_RFC);
+  if (!parsed || !parsed->is_dict()) {
+    return std::nullopt;
+  }
+  return std::move(*parsed).TakeDict();
+}
+
+TufError ExtractEnvelope(const base::DictValue& outer, Envelope* out) {
+  const base::Value* signed_value = outer.Find("signed");
+  const base::ListValue* signatures = outer.FindList("signatures");
+  if (!signed_value || !signed_value->is_dict() || !signatures) {
+    return TufError::kBadJson;
+  }
+  out->signed_value = signed_value;
+  out->signatures = signatures;
+  return TufError::kOk;
+}
+
+TufError CheckSpecAndType(const base::DictValue& signed_dict,
+                          std::string_view expected_type) {
+  const std::string* type = signed_dict.FindString("_type");
+  const std::string* spec = signed_dict.FindString("spec_version");
+  if (!type || !spec || *type != expected_type) {
+    return TufError::kBadJson;
+  }
+  if (!base::StartsWith(*spec, kSpecPrefix)) {
+    return TufError::kUnsupportedSpec;
+  }
+  return TufError::kOk;
+}
+
+}  // namespace
+
+// Implements the verify step. Signs over canonical-JSON of `signed_dict`
+// and accepts iff at least `threshold` distinct keyids in `role_keyids`
+// produced a valid signature.
+TufError TufClient::VerifyRoleSignedBlock(const std::string& role_name,
+                                          const base::DictValue& outer) {
+  auto role_it = roles_.find(role_name);
+  if (role_it == roles_.end()) {
+    return TufError::kUnknownRole;
+  }
+  const RoleSpec& role = role_it->second;
+
+  const base::Value* signed_value = outer.Find("signed");
+  const base::ListValue* signatures = outer.FindList("signatures");
+  if (!signed_value || !signed_value->is_dict() || !signatures) {
+    return TufError::kBadJson;
+  }
+
+  std::optional<std::string> canonical = EncodeCanonicalJson(*signed_value);
+  if (!canonical) {
+    return TufError::kBadJson;
+  }
+  base::span<const uint8_t> message = base::as_byte_span(*canonical);
+
+  std::set<std::string> valid_keyids;
+  std::set<std::string> role_keyids(role.keyids.begin(), role.keyids.end());
+
+  for (const base::Value& sig_v : *signatures) {
+    if (!sig_v.is_dict()) {
+      return TufError::kBadJson;
+    }
+    const std::string* keyid = sig_v.GetDict().FindString("keyid");
+    const std::string* sig_hex = sig_v.GetDict().FindString("sig");
+    if (!keyid || !sig_hex) {
+      return TufError::kBadJson;
+    }
+    if (!role_keyids.contains(*keyid)) {
+      continue;  // Not a key the role accepts; ignore (TUF spec).
+    }
+    auto key_it = keys_.find(*keyid);
+    if (key_it == keys_.end()) {
+      continue;
+    }
+    std::array<uint8_t, kEd25519SignatureLen> sig_bytes{};
+    if (!DecodeHexFixed(*sig_hex, sig_bytes)) {
+      return TufError::kBadSignature;
+    }
+    auto pub = crypto::keypair::PublicKey::FromEd25519PublicKey(
+        key_it->second.public_key);
+    if (!crypto::sign::Verify(crypto::sign::ED25519, pub, message,
+                              sig_bytes)) {
+      return TufError::kBadSignature;
+    }
+    valid_keyids.insert(*keyid);
+  }
+
+  if (static_cast<int>(valid_keyids.size()) < role.threshold) {
+    return TufError::kThresholdNotMet;
+  }
+  return TufError::kOk;
+}
+
+// static
+base::expected<TufClient, TufError> TufClient::CreateWithRoot(
+    base::span<const uint8_t> root_json,
+    base::Time now) {
+  std::optional<base::DictValue> outer = ParseTopLevel(root_json);
+  if (!outer) {
+    return base::unexpected(TufError::kBadJson);
+  }
+  Envelope env;
+  if (TufError e = ExtractEnvelope(*outer, &env); e != TufError::kOk) {
+    return base::unexpected(e);
+  }
+  const base::DictValue& signed_dict = env.signed_value->GetDict();
+  if (TufError e = CheckSpecAndType(signed_dict, "root"); e != TufError::kOk) {
+    return base::unexpected(e);
+  }
+
+  // Parse keys + roles BEFORE verifying signatures (root is self-signed).
+  TufClient client;
+  client.now_ = now;
+
+  const base::DictValue* keys_dict = signed_dict.FindDict("keys");
+  const base::DictValue* roles_dict = signed_dict.FindDict("roles");
+  if (!keys_dict || !roles_dict) {
+    return base::unexpected(TufError::kMissingField);
+  }
+
+  for (auto kv : *keys_dict) {
+    const base::DictValue* k = kv.second.GetIfDict();
+    if (!k) {
+      return base::unexpected(TufError::kBadJson);
+    }
+    const std::string* keytype = k->FindString("keytype");
+    const std::string* scheme = k->FindString("scheme");
+    const base::DictValue* keyval = k->FindDict("keyval");
+    if (!keytype || !scheme || !keyval) {
+      return base::unexpected(TufError::kBadJson);
+    }
+    if (*keytype != "ed25519" || *scheme != "ed25519") {
+      // v1.0 alpha is Ed25519-only.
+      return base::unexpected(TufError::kUnsupportedSpec);
+    }
+    const std::string* public_hex = keyval->FindString("public");
+    if (!public_hex) {
+      return base::unexpected(TufError::kBadJson);
+    }
+    KeyEntry entry;
+    if (!DecodeHexFixed(*public_hex, entry.public_key)) {
+      return base::unexpected(TufError::kBadJson);
+    }
+    client.keys_[kv.first] = entry;
+  }
+
+  for (auto rv : *roles_dict) {
+    const base::DictValue* r = rv.second.GetIfDict();
+    if (!r) {
+      return base::unexpected(TufError::kBadJson);
+    }
+    const base::ListValue* keyids = r->FindList("keyids");
+    std::optional<int> threshold = r->FindInt("threshold");
+    if (!keyids || !threshold || *threshold < 1) {
+      return base::unexpected(TufError::kBadJson);
+    }
+    RoleSpec spec;
+    spec.threshold = *threshold;
+    for (const base::Value& k : *keyids) {
+      if (!k.is_string()) {
+        return base::unexpected(TufError::kBadJson);
+      }
+      spec.keyids.push_back(k.GetString());
+    }
+    client.roles_[rv.first] = std::move(spec);
+  }
+
+  // Self-verify root.
+  if (TufError e = client.VerifyRoleSignedBlock("root", *outer);
+      e != TufError::kOk) {
+    return base::unexpected(e);
+  }
+
+  // Expiration check.
+  const std::string* expires = signed_dict.FindString("expires");
+  if (!expires) {
+    return base::unexpected(TufError::kMissingField);
+  }
+  base::Time expiry;
+  if (!ParseExpires(*expires, &expiry)) {
+    return base::unexpected(TufError::kBadJson);
+  }
+  if (expiry <= now) {
+    return base::unexpected(TufError::kExpired);
+  }
+  return client;
+}
+
+TufError TufClient::IngestTimestamp(base::span<const uint8_t> json_bytes) {
+  std::optional<base::DictValue> outer = ParseTopLevel(json_bytes);
+  if (!outer) {
+    return TufError::kBadJson;
+  }
+  Envelope env;
+  if (TufError e = ExtractEnvelope(*outer, &env); e != TufError::kOk) {
+    return e;
+  }
+  const base::DictValue& signed_dict = env.signed_value->GetDict();
+  if (TufError e = CheckSpecAndType(signed_dict, "timestamp");
+      e != TufError::kOk) {
+    return e;
+  }
+  if (TufError e = VerifyRoleSignedBlock("timestamp", *outer);
+      e != TufError::kOk) {
+    return e;
+  }
+
+  const std::string* expires = signed_dict.FindString("expires");
+  const base::Value* version_v = signed_dict.Find("version");
+  if (!expires || !version_v) {
+    return TufError::kMissingField;
+  }
+  base::Time expiry;
+  if (!ParseExpires(*expires, &expiry)) {
+    return TufError::kBadJson;
+  }
+  if (expiry <= now_) {
+    return TufError::kExpired;
+  }
+  uint64_t version = 0;
+  if (!ParseUint64(*version_v, &version)) {
+    return TufError::kBadJson;
+  }
+  if (version < timestamp_version_) {
+    return TufError::kRollback;
+  }
+  timestamp_version_ = version;
+
+  // Pin snapshot.json's expected version + length + sha256.
+  const base::DictValue* meta = signed_dict.FindDict("meta");
+  if (!meta) {
+    return TufError::kMissingField;
+  }
+  const base::DictValue* snap_meta = meta->FindDict("snapshot.json");
+  if (!snap_meta) {
+    return TufError::kMissingField;
+  }
+  const base::Value* snap_version_v = snap_meta->Find("version");
+  std::optional<int> snap_length = snap_meta->FindInt("length");
+  const base::DictValue* snap_hashes = snap_meta->FindDict("hashes");
+  if (!snap_version_v || !snap_length || *snap_length < 0 || !snap_hashes) {
+    return TufError::kMissingField;
+  }
+  uint64_t sv = 0;
+  if (!ParseUint64(*snap_version_v, &sv)) {
+    return TufError::kBadJson;
+  }
+  const std::string* sha256_hex = snap_hashes->FindString("sha256");
+  if (!sha256_hex) {
+    return TufError::kMissingField;
+  }
+  std::array<uint8_t, kSha256Len> sha{};
+  if (!DecodeHexFixed(*sha256_hex, sha)) {
+    return TufError::kBadJson;
+  }
+  expected_snapshot_version_ = sv;
+  expected_snapshot_length_ = static_cast<uint64_t>(*snap_length);
+  expected_snapshot_sha256_ = sha;
+  snapshot_pin_set_ = true;
+  return TufError::kOk;
+}
+
+TufError TufClient::IngestSnapshot(base::span<const uint8_t> json_bytes) {
+  if (!snapshot_pin_set_) {
+    return TufError::kVersionMismatch;
+  }
+  if (json_bytes.size() != expected_snapshot_length_) {
+    return TufError::kLengthMismatch;
+  }
+  std::array<uint8_t, kSha256Len> actual{};
+  ::SHA256(json_bytes.data(), json_bytes.size(), actual.data());
+  if (actual != expected_snapshot_sha256_) {
+    return TufError::kHashMismatch;
+  }
+
+  std::optional<base::DictValue> outer = ParseTopLevel(json_bytes);
+  if (!outer) {
+    return TufError::kBadJson;
+  }
+  Envelope env;
+  if (TufError e = ExtractEnvelope(*outer, &env); e != TufError::kOk) {
+    return e;
+  }
+  const base::DictValue& signed_dict = env.signed_value->GetDict();
+  if (TufError e = CheckSpecAndType(signed_dict, "snapshot");
+      e != TufError::kOk) {
+    return e;
+  }
+  if (TufError e = VerifyRoleSignedBlock("snapshot", *outer);
+      e != TufError::kOk) {
+    return e;
+  }
+
+  const std::string* expires = signed_dict.FindString("expires");
+  const base::Value* version_v = signed_dict.Find("version");
+  if (!expires || !version_v) {
+    return TufError::kMissingField;
+  }
+  base::Time expiry;
+  if (!ParseExpires(*expires, &expiry)) {
+    return TufError::kBadJson;
+  }
+  if (expiry <= now_) {
+    return TufError::kExpired;
+  }
+  uint64_t version = 0;
+  if (!ParseUint64(*version_v, &version)) {
+    return TufError::kBadJson;
+  }
+  if (version != expected_snapshot_version_) {
+    return TufError::kVersionMismatch;
+  }
+  if (version < snapshot_version_) {
+    return TufError::kRollback;
+  }
+  snapshot_version_ = version;
+
+  const base::DictValue* meta = signed_dict.FindDict("meta");
+  if (!meta) {
+    return TufError::kMissingField;
+  }
+  const base::DictValue* tgt_meta = meta->FindDict("targets.json");
+  if (!tgt_meta) {
+    return TufError::kMissingField;
+  }
+  const base::Value* tgt_version_v = tgt_meta->Find("version");
+  if (!tgt_version_v) {
+    return TufError::kMissingField;
+  }
+  uint64_t tv = 0;
+  if (!ParseUint64(*tgt_version_v, &tv)) {
+    return TufError::kBadJson;
+  }
+  expected_targets_version_ = tv;
+  targets_pin_set_ = true;
+  return TufError::kOk;
+}
+
+TufError TufClient::IngestTargets(base::span<const uint8_t> json_bytes) {
+  if (!targets_pin_set_) {
+    return TufError::kVersionMismatch;
+  }
+  std::optional<base::DictValue> outer = ParseTopLevel(json_bytes);
+  if (!outer) {
+    return TufError::kBadJson;
+  }
+  Envelope env;
+  if (TufError e = ExtractEnvelope(*outer, &env); e != TufError::kOk) {
+    return e;
+  }
+  const base::DictValue& signed_dict = env.signed_value->GetDict();
+  if (TufError e = CheckSpecAndType(signed_dict, "targets");
+      e != TufError::kOk) {
+    return e;
+  }
+  if (TufError e = VerifyRoleSignedBlock("targets", *outer);
+      e != TufError::kOk) {
+    return e;
+  }
+
+  const std::string* expires = signed_dict.FindString("expires");
+  const base::Value* version_v = signed_dict.Find("version");
+  if (!expires || !version_v) {
+    return TufError::kMissingField;
+  }
+  base::Time expiry;
+  if (!ParseExpires(*expires, &expiry)) {
+    return TufError::kBadJson;
+  }
+  if (expiry <= now_) {
+    return TufError::kExpired;
+  }
+  uint64_t version = 0;
+  if (!ParseUint64(*version_v, &version)) {
+    return TufError::kBadJson;
+  }
+  if (version != expected_targets_version_) {
+    return TufError::kVersionMismatch;
+  }
+  if (version < targets_version_) {
+    return TufError::kRollback;
+  }
+  targets_version_ = version;
+
+  const base::DictValue* targets_dict = signed_dict.FindDict("targets");
+  if (!targets_dict) {
+    return TufError::kMissingField;
+  }
+  std::map<std::string, TargetMeta> parsed;
+  for (auto kv : *targets_dict) {
+    const base::DictValue* t = kv.second.GetIfDict();
+    if (!t) {
+      return TufError::kBadJson;
+    }
+    std::optional<int> length = t->FindInt("length");
+    const base::DictValue* hashes = t->FindDict("hashes");
+    if (!length || *length < 0 || !hashes) {
+      return TufError::kMissingField;
+    }
+    const std::string* sha256_hex = hashes->FindString("sha256");
+    if (!sha256_hex) {
+      return TufError::kMissingField;
+    }
+    TargetMeta tm;
+    tm.name = kv.first;
+    tm.length = static_cast<uint64_t>(*length);
+    if (!DecodeHexFixed(*sha256_hex, tm.sha256)) {
+      return TufError::kBadJson;
+    }
+    if (const base::DictValue* custom = t->FindDict("custom")) {
+      if (const std::string* p = custom->FindString("platform")) {
+        tm.platform = *p;
+      }
+      if (const std::string* a = custom->FindString("arch")) {
+        tm.arch = *a;
+      }
+      if (const std::string* c = custom->FindString("channel")) {
+        tm.channel = *c;
+      }
+    }
+    parsed[kv.first] = std::move(tm);
+  }
+  targets_ = std::move(parsed);
+  return TufError::kOk;
+}
+
+std::optional<TargetMeta> TufClient::LookupTarget(std::string_view name) const {
+  auto it = targets_.find(std::string(name));
+  if (it == targets_.end()) {
+    return std::nullopt;
+  }
+  return it->second;
+}
+
+}  // namespace phlink::updater
