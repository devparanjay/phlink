@@ -0,0 +1,275 @@
+// Copyright 2026 The phlink Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/phlink/updater/metadata_client.h"
+
+#include <array>
+#include <cstdint>
+#include <string>
+#include <vector>
+
+#include "base/strings/string_number_conversions.h"
+#include "base/strings/string_util.h"
+#include "base/values.h"
+#include "chrome/browser/phlink/updater/canonical_json.h"
+#include "crypto/keypair.h"
+#include "crypto/sign.h"
+#include "testing/gtest/include/gtest/gtest.h"
+#include "third_party/boringssl/src/include/openssl/sha.h"
+
+namespace phlink::updater {
+namespace {
+
+std::string ToHex(base::span<const uint8_t> bytes) {
+  return base::ToLowerASCII(base::HexEncode(bytes));
+}
+
+// A single Ed25519 keypair plus its TUF-style key_id.
+struct TestKey {
+  crypto::keypair::PrivateKey private_key;
+  std::array<uint8_t, 32> public_bytes;
+  std::string keyid;
+};
+
+TestKey MakeTestKey() {
+  crypto::keypair::PrivateKey priv = crypto::keypair::PrivateKey::GenerateEd25519();
+  std::array<uint8_t, 32> pub = priv.ToEd25519PublicKey();
+
+  // Compute keyid = sha256(canonical_json({keytype, keyval{public}, scheme})).
+  base::DictValue keyval;
+  keyval.Set("public", ToHex(pub));
+  base::DictValue key_dict;
+  key_dict.Set("keytype", "ed25519");
+  key_dict.Set("keyval", std::move(keyval));
+  key_dict.Set("scheme", "ed25519");
+  base::Value v(std::move(key_dict));
+  std::string canonical = *EncodeCanonicalJson(v);
+
+  std::array<uint8_t, 32> hash{};
+  ::SHA256(reinterpret_cast<const uint8_t*>(canonical.data()),
+           canonical.size(), hash.data());
+
+  return TestKey{std::move(priv), pub, ToHex(hash)};
+}
+
+// Wraps `signed_value` in a `{ signed, signatures }` envelope, signing it
+// with each of `signers`.
+std::string Envelope(const base::DictValue& signed_value,
+                     const std::vector<const TestKey*>& signers) {
+  base::Value v(signed_value.Clone());
+  std::string canonical = *EncodeCanonicalJson(v);
+  base::span<const uint8_t> message =
+      base::as_byte_span(canonical);
+
+  base::ListValue sigs;
+  for (const TestKey* k : signers) {
+    std::vector<uint8_t> sig =
+        crypto::sign::Sign(crypto::sign::ED25519, k->private_key, message);
+    base::DictValue s;
+    s.Set("keyid", k->keyid);
+    s.Set("sig", ToHex(sig));
+    sigs.Append(std::move(s));
+  }
+
+  base::DictValue outer;
+  outer.Set("signed", signed_value.Clone());
+  outer.Set("signatures", std::move(sigs));
+  // Serialize the outer envelope however; production parses with
+  // base::JSONReader so any valid JSON shape works (signatures are checked
+  // against the canonical-JSON of `signed`, not the on-disk envelope).
+  return *EncodeCanonicalJson(base::Value(std::move(outer)));
+}
+
+base::DictValue BuildRootSigned(const TestKey& root_key,
+                                  const std::string& expires) {
+  base::DictValue keyval;
+  keyval.Set("public", ToHex(root_key.public_bytes));
+  base::DictValue key;
+  key.Set("keytype", "ed25519");
+  key.Set("keyval", std::move(keyval));
+  key.Set("scheme", "ed25519");
+  base::DictValue keys;
+  keys.Set(root_key.keyid, std::move(key));
+
+  auto make_role = [&]() {
+    base::ListValue ids;
+    ids.Append(root_key.keyid);
+    base::DictValue r;
+    r.Set("keyids", std::move(ids));
+    r.Set("threshold", 1);
+    return r;
+  };
+  base::DictValue roles;
+  roles.Set("root", make_role());
+  roles.Set("targets", make_role());
+  roles.Set("snapshot", make_role());
+  roles.Set("timestamp", make_role());
+
+  base::DictValue signed_dict;
+  signed_dict.Set("_type", "root");
+  signed_dict.Set("spec_version", "1.0.32");
+  signed_dict.Set("version", 1);
+  signed_dict.Set("expires", expires);
+  signed_dict.Set("consistent_snapshot", false);
+  signed_dict.Set("keys", std::move(keys));
+  signed_dict.Set("roles", std::move(roles));
+  return signed_dict;
+}
+
+base::DictValue BuildTimestampSigned(int version,
+                                       const std::string& expires,
+                                       int snapshot_version,
+                                       const std::string& snapshot_bytes) {
+  std::array<uint8_t, 32> sha{};
+  ::SHA256(reinterpret_cast<const uint8_t*>(snapshot_bytes.data()),
+           snapshot_bytes.size(), sha.data());
+  base::DictValue hashes;
+  hashes.Set("sha256", ToHex(sha));
+  base::DictValue snap_meta;
+  snap_meta.Set("version", snapshot_version);
+  snap_meta.Set("length", static_cast<int>(snapshot_bytes.size()));
+  snap_meta.Set("hashes", std::move(hashes));
+  base::DictValue meta;
+  meta.Set("snapshot.json", std::move(snap_meta));
+  base::DictValue s;
+  s.Set("_type", "timestamp");
+  s.Set("spec_version", "1.0.32");
+  s.Set("version", version);
+  s.Set("expires", expires);
+  s.Set("meta", std::move(meta));
+  return s;
+}
+
+base::DictValue BuildSnapshotSigned(int version,
+                                      const std::string& expires,
+                                      int targets_version) {
+  base::DictValue tgt_meta;
+  tgt_meta.Set("version", targets_version);
+  base::DictValue meta;
+  meta.Set("targets.json", std::move(tgt_meta));
+  base::DictValue s;
+  s.Set("_type", "snapshot");
+  s.Set("spec_version", "1.0.32");
+  s.Set("version", version);
+  s.Set("expires", expires);
+  s.Set("meta", std::move(meta));
+  return s;
+}
+
+base::DictValue BuildTargetsSigned(int version,
+                                     const std::string& expires) {
+  std::array<uint8_t, 32> fake_sha{};
+  for (size_t i = 0; i < fake_sha.size(); ++i) {
+    fake_sha[i] = static_cast<uint8_t>(i);
+  }
+  base::DictValue hashes;
+  hashes.Set("sha256", ToHex(fake_sha));
+  base::DictValue tgt;
+  tgt.Set("length", 1024);
+  tgt.Set("hashes", std::move(hashes));
+  base::DictValue targets;
+  targets.Set("phlink-1.0.0-mac-arm64.zip", std::move(tgt));
+  base::DictValue s;
+  s.Set("_type", "targets");
+  s.Set("spec_version", "1.0.32");
+  s.Set("version", version);
+  s.Set("expires", expires);
+  s.Set("targets", std::move(targets));
+  return s;
+}
+
+base::span<const uint8_t> Bytes(const std::string& s) {
+  return base::as_byte_span(s);
+}
+
+base::Time SomeNow() {
+  base::Time t;
+  CHECK(base::Time::FromUTCString("2026-05-01T00:00:00Z", &t));
+  return t;
+}
+
+const char kFutureExpires[] = "2099-01-01T00:00:00Z";
+const char kPastExpires[] = "2000-01-01T00:00:00Z";
+
+TEST(TufClientTest, AcceptsValidMetadata) {
+  TestKey root = MakeTestKey();
+  std::string root_json = Envelope(BuildRootSigned(root, kFutureExpires),
+                                   {&root});
+
+  auto client = TufClient::CreateWithRoot(Bytes(root_json), SomeNow());
+  ASSERT_TRUE(client.has_value());
+
+  std::string snap_json =
+      Envelope(BuildSnapshotSigned(1, kFutureExpires, 1), {&root});
+  std::string ts_json =
+      Envelope(BuildTimestampSigned(1, kFutureExpires, 1, snap_json), {&root});
+  std::string tgt_json =
+      Envelope(BuildTargetsSigned(1, kFutureExpires), {&root});
+
+  EXPECT_EQ(TufError::kOk, client->IngestTimestamp(Bytes(ts_json)));
+  EXPECT_EQ(TufError::kOk, client->IngestSnapshot(Bytes(snap_json)));
+  EXPECT_EQ(TufError::kOk, client->IngestTargets(Bytes(tgt_json)));
+  EXPECT_TRUE(client->LookupTarget("phlink-1.0.0-mac-arm64.zip").has_value());
+}
+
+TEST(TufClientTest, RejectsExpiredTimestamp) {
+  TestKey root = MakeTestKey();
+  std::string root_json =
+      Envelope(BuildRootSigned(root, kFutureExpires), {&root});
+  auto client = TufClient::CreateWithRoot(Bytes(root_json), SomeNow());
+  ASSERT_TRUE(client.has_value());
+
+  std::string snap_json =
+      Envelope(BuildSnapshotSigned(1, kFutureExpires, 1), {&root});
+  std::string ts_json =
+      Envelope(BuildTimestampSigned(1, kPastExpires, 1, snap_json), {&root});
+  EXPECT_EQ(TufError::kExpired, client->IngestTimestamp(Bytes(ts_json)));
+}
+
+TEST(TufClientTest, RejectsRollback) {
+  TestKey root = MakeTestKey();
+  std::string root_json =
+      Envelope(BuildRootSigned(root, kFutureExpires), {&root});
+  auto client = TufClient::CreateWithRoot(Bytes(root_json), SomeNow());
+  ASSERT_TRUE(client.has_value());
+
+  std::string snap5 =
+      Envelope(BuildSnapshotSigned(5, kFutureExpires, 1), {&root});
+  std::string ts5 =
+      Envelope(BuildTimestampSigned(5, kFutureExpires, 5, snap5), {&root});
+  ASSERT_EQ(TufError::kOk, client->IngestTimestamp(Bytes(ts5)));
+
+  std::string snap3 =
+      Envelope(BuildSnapshotSigned(3, kFutureExpires, 1), {&root});
+  std::string ts3 =
+      Envelope(BuildTimestampSigned(3, kFutureExpires, 3, snap3), {&root});
+  EXPECT_EQ(TufError::kRollback, client->IngestTimestamp(Bytes(ts3)));
+}
+
+TEST(TufClientTest, RejectsBadSignature) {
+  TestKey root = MakeTestKey();
+  TestKey impostor = MakeTestKey();
+  // Reuse the legitimate root's keyid on a signature signed with the
+  // impostor's private key — the verify call against the trusted public
+  // key will fail.
+  TestKey forgery = impostor;
+  forgery.keyid = root.keyid;
+
+  std::string root_json =
+      Envelope(BuildRootSigned(root, kFutureExpires), {&root});
+  auto client = TufClient::CreateWithRoot(Bytes(root_json), SomeNow());
+  ASSERT_TRUE(client.has_value());
+
+  std::string snap_json =
+      Envelope(BuildSnapshotSigned(1, kFutureExpires, 1), {&root});
+  // Sign the timestamp with the impostor's private key, but tag the
+  // signature with the root's keyid.
+  std::string ts_json =
+      Envelope(BuildTimestampSigned(1, kFutureExpires, 1, snap_json),
+               {&forgery});
+  EXPECT_EQ(TufError::kBadSignature, client->IngestTimestamp(Bytes(ts_json)));
+}
+
