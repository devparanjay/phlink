+++ b/chrome/browser/phlink/updater/update_check_pipeline.cc
@@ -0,0 +1,104 @@
+// Copyright 2026 The phlink Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/phlink/updater/update_check_pipeline.h"
+
+#include <utility>
+
+#include "base/check.h"
+#include "base/files/file_path.h"
+#include "base/functional/bind.h"
+#include "base/time/time.h"
+#include "chrome/browser/phlink/updater/metadata_fetcher.h"
+#include "chrome/browser/phlink/updater/payload_fetcher.h"
+#include "chrome/browser/phlink/updater/staged_payload.h"
+#include "services/network/public/cpp/shared_url_loader_factory.h"
+
+namespace phlink::updater {
+
+UpdateCheckPipeline::Config::Config() = default;
+UpdateCheckPipeline::Config::Config(Config&&) = default;
+UpdateCheckPipeline::Config& UpdateCheckPipeline::Config::operator=(Config&&) =
+    default;
+UpdateCheckPipeline::Config::~Config() = default;
+
+UpdateCheckPipeline::UpdateCheckPipeline(
+    scoped_refptr<network::SharedURLLoaderFactory> factory,
+    Config config)
+    : factory_(std::move(factory)), config_(std::move(config)) {
+  CHECK(factory_);
+  CHECK(config_.metadata_base_url.is_valid());
+  CHECK(config_.payload_base_url.is_valid());
+  CHECK(!config_.target_name.empty());
+  CHECK(!config_.staging_dir.empty());
+}
+
+UpdateCheckPipeline::~UpdateCheckPipeline() = default;
+
+void UpdateCheckPipeline::Run(ResultCallback callback) {
+  CHECK(!callback_) << "UpdateCheckPipeline is one-shot";
+  callback_ = std::move(callback);
+
+  auto client_or =
+      TufClient::CreateWithRoot(config_.root_json, base::Time::Now());
+  if (!client_or.has_value()) {
+    Finish(Outcome::kMetadataError);
+    return;
+  }
+  client_ = std::make_unique<TufClient>(std::move(client_or).value());
+
+  metadata_fetcher_ = std::make_unique<MetadataFetcher>(
+      factory_, config_.metadata_base_url);
+  metadata_fetcher_->Fetch(
+      client_.get(),
+      base::BindOnce(&UpdateCheckPipeline::OnMetadataFetched,
+                     weak_factory_.GetWeakPtr()));
+}
+
+void UpdateCheckPipeline::OnMetadataFetched(TufError err) {
+  metadata_fetcher_.reset();
+  if (err != TufError::kOk) {
+    Finish(Outcome::kMetadataError);
+    return;
+  }
+  std::optional<TargetMeta> target =
+      client_->LookupTarget(config_.target_name);
+  if (!target.has_value()) {
+    Finish(Outcome::kTargetMissing);
+    return;
+  }
+
+  GURL payload_url = config_.payload_base_url.Resolve(target->name);
+  payload_fetcher_ =
+      std::make_unique<PayloadFetcher>(factory_, config_.staging_dir);
+  payload_fetcher_->Fetch(
+      std::move(payload_url), target->length, target->sha256,
+      base::BindOnce(&UpdateCheckPipeline::OnPayloadFetched,
+                     weak_factory_.GetWeakPtr()));
+}
+
+void UpdateCheckPipeline::OnPayloadFetched(PayloadFetchResult result) {
+  payload_fetcher_.reset();
+  if (result.error != PayloadFetchError::kOk) {
+    Finish(Outcome::kPayloadError);
+    return;
+  }
+  StagedPayload staged;
+  staged.version = config_.target_version;
+  staged.payload_path = result.payload_path;
+  staged.verified_at = base::Time::Now();
+  if (!WriteStagedPayloadJson(config_.staging_dir, staged)) {
+    Finish(Outcome::kIoError);
+    return;
+  }
+  Finish(Outcome::kOk);
+}
+
+void UpdateCheckPipeline::Finish(Outcome outcome) {
+  if (callback_) {
+    std::move(callback_).Run(outcome);
+  }
+}
+
+}  // namespace phlink::updater
