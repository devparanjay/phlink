@@ -0,0 +1,163 @@
+// Copyright 2026 The phlink Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/phlink/updater/update_check_pipeline.h"
+
+#include <array>
+#include <string>
+#include <vector>
+
+#include "base/files/file_util.h"
+#include "base/files/scoped_temp_dir.h"
+#include "base/run_loop.h"
+#include "base/test/bind.h"
+#include "base/test/task_environment.h"
+#include "chrome/browser/phlink/updater/metadata_test_helpers.h"
+#include "chrome/browser/phlink/updater/staged_payload.h"
+#include "crypto/hash.h"
+#include "net/http/http_status_code.h"
+#include "services/network/public/cpp/weak_wrapper_shared_url_loader_factory.h"
+#include "services/network/test/test_url_loader_factory.h"
+#include "testing/gtest/include/gtest/gtest.h"
+#include "url/gurl.h"
+
+namespace phlink::updater {
+namespace {
+
+using test_helpers::BuildRootSigned;
+using test_helpers::BuildSnapshotSigned;
+using test_helpers::BuildTargetsSigned;
+using test_helpers::BuildTimestampSigned;
+using test_helpers::Bytes;
+using test_helpers::Envelope;
+using test_helpers::MakeTestKey;
+using test_helpers::TestKey;
+
+constexpr char kFutureExpires[] = "2099-01-01T00:00:00Z";
+constexpr char kTargetName[] = "phlink-1.0.0-mac-arm64.zip";
+
+class UpdateCheckPipelineTest : public ::testing::Test {
+ protected:
+  UpdateCheckPipelineTest()
+      : shared_factory_(loader_factory_.GetSafeWeakWrapper()) {}
+
+  void SetUp() override { ASSERT_TRUE(temp_dir_.CreateUniqueTempDir()); }
+
+  base::FilePath staging() const { return temp_dir_.GetPath(); }
+
+  void SeedMetadata(const TestKey& root_key,
+                    const std::string& payload_body) {
+    std::array<uint8_t, 32> body_sha = crypto::hash::Sha256(payload_body);
+    std::string tgt_json = Envelope(
+        test_helpers::BuildTargetsSignedWithEntry(
+            /*version=*/1, kFutureExpires, kTargetName,
+            /*length=*/payload_body.size(), body_sha),
+        {&root_key});
+
+    std::string snap_json =
+        Envelope(BuildSnapshotSigned(1, kFutureExpires, 1), {&root_key});
+    std::string ts_json = Envelope(
+        BuildTimestampSigned(1, kFutureExpires, 1, snap_json), {&root_key});
+
+    loader_factory_.AddResponse("https://updates.example/timestamp.json",
+                                ts_json, net::HTTP_OK);
+    loader_factory_.AddResponse("https://updates.example/snapshot.json",
+                                snap_json, net::HTTP_OK);
+    loader_factory_.AddResponse("https://updates.example/targets.json",
+                                tgt_json, net::HTTP_OK);
+  }
+
+  UpdateCheckPipeline::Outcome RunPipeline(std::vector<uint8_t> root_json,
+                                           const std::string& target_name) {
+    UpdateCheckPipeline::Config cfg;
+    cfg.root_json = std::move(root_json);
+    cfg.metadata_base_url = GURL("https://updates.example/");
+    cfg.payload_base_url = GURL("https://updates.example/payloads/");
+    cfg.target_name = target_name;
+    cfg.target_version = "1.0.0";
+    cfg.staging_dir = staging();
+    UpdateCheckPipeline pipeline(shared_factory_, std::move(cfg));
+    base::RunLoop run_loop;
+    UpdateCheckPipeline::Outcome got =
+        UpdateCheckPipeline::Outcome::kMetadataError;
+    pipeline.Run(base::BindLambdaForTesting(
+        [&](UpdateCheckPipeline::Outcome o) {
+          got = o;
+          run_loop.Quit();
+        }));
+    run_loop.Run();
+    return got;
+  }
+
+  base::test::TaskEnvironment task_env_;
+  base::ScopedTempDir temp_dir_;
+  network::TestURLLoaderFactory loader_factory_;
+  scoped_refptr<network::WeakWrapperSharedURLLoaderFactory> shared_factory_;
+};
+
+TEST_F(UpdateCheckPipelineTest, HappyPathWritesStagedJson) {
+  TestKey root = MakeTestKey();
+  std::string root_json =
+      Envelope(BuildRootSigned(root, kFutureExpires), {&root});
+  std::vector<uint8_t> root_bytes(root_json.begin(), root_json.end());
+
+  const std::string payload = "phlink update payload bytes";
+  SeedMetadata(root, payload);
+  loader_factory_.AddResponse(
+      std::string("https://updates.example/payloads/") + kTargetName,
+      payload, net::HTTP_OK);
+
+  EXPECT_EQ(RunPipeline(root_bytes, kTargetName),
+            UpdateCheckPipeline::Outcome::kOk);
+  EXPECT_TRUE(base::PathExists(staging().AppendASCII("staged.json")));
+  std::optional<StagedPayload> staged = ReadStagedPayloadJson(staging());
+  ASSERT_TRUE(staged.has_value());
+  EXPECT_EQ(staged->version, "1.0.0");
+}
+
+TEST_F(UpdateCheckPipelineTest, MetadataErrorOnTimestampPropagates) {
+  TestKey root = MakeTestKey();
+  std::string root_json =
+      Envelope(BuildRootSigned(root, kFutureExpires), {&root});
+  std::vector<uint8_t> root_bytes(root_json.begin(), root_json.end());
+
+  loader_factory_.AddResponse("https://updates.example/timestamp.json", "",
+                              net::HTTP_INTERNAL_SERVER_ERROR);
+
+  EXPECT_EQ(RunPipeline(root_bytes, kTargetName),
+            UpdateCheckPipeline::Outcome::kMetadataError);
+  EXPECT_FALSE(base::PathExists(staging().AppendASCII("staged.json")));
+}
+
+TEST_F(UpdateCheckPipelineTest, TargetMissingReturnsKTargetMissing) {
+  TestKey root = MakeTestKey();
+  std::string root_json =
+      Envelope(BuildRootSigned(root, kFutureExpires), {&root});
+  std::vector<uint8_t> root_bytes(root_json.begin(), root_json.end());
+
+  // The default targets fixture only carries `kTargetName`; ask for a
+  // different platform/arch.
+  SeedMetadata(root, "ignored");
+  EXPECT_EQ(RunPipeline(root_bytes, "phlink-1.0.0-linux-x64.zip"),
+            UpdateCheckPipeline::Outcome::kTargetMissing);
+}
+
+TEST_F(UpdateCheckPipelineTest, PayloadHashMismatchReturnsKPayloadError) {
+  TestKey root = MakeTestKey();
+  std::string root_json =
+      Envelope(BuildRootSigned(root, kFutureExpires), {&root});
+  std::vector<uint8_t> root_bytes(root_json.begin(), root_json.end());
+
+  // Metadata expects payload "good"; the server returns "evil" instead.
+  SeedMetadata(root, "good");
+  loader_factory_.AddResponse(
+      std::string("https://updates.example/payloads/") + kTargetName,
+      "evil", net::HTTP_OK);
+
+  EXPECT_EQ(RunPipeline(root_bytes, kTargetName),
+            UpdateCheckPipeline::Outcome::kPayloadError);
+}
+
+}  // namespace
+}  // namespace phlink::updater
