@@ -0,0 +1,96 @@
+// Copyright 2026 The phlink Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_PHLINK_UPDATER_UPDATE_CHECK_PIPELINE_H_
+#define CHROME_BROWSER_PHLINK_UPDATER_UPDATE_CHECK_PIPELINE_H_
+
+#include <array>
+#include <cstdint>
+#include <memory>
+#include <string>
+#include <vector>
+
+#include "base/files/file_path.h"
+#include "base/functional/callback.h"
+#include "base/memory/scoped_refptr.h"
+#include "base/memory/weak_ptr.h"
+#include "chrome/browser/phlink/updater/metadata_client.h"
+#include "url/gurl.h"
+
+namespace network {
+class SharedURLLoaderFactory;
+}
+
+namespace phlink::updater {
+
+class MetadataFetcher;
+class PayloadFetcher;
+
+// Orchestrates one full update-check round: fetch+verify TUF metadata,
+// look up the target for the running platform, download+verify the
+// payload, write `staged.json`. Out of scope: applying the update
+// (handled by per-platform helpers in plans 10-03/10-04/10-05).
+//
+// One-shot. Construct, call `Run`, await callback, drop.
+class UpdateCheckPipeline {
+ public:
+  enum class Outcome {
+    kOk,                // staged.json written; update ready for next launch.
+    kUpToDate,          // metadata says no newer version is available.
+    kMetadataError,     // TUF verification or network error during metadata.
+    kTargetMissing,     // `targets.json` doesn't list our platform/arch.
+    kPayloadError,      // payload network/length/hash failure.
+    kIoError,           // staged.json could not be written.
+  };
+  using ResultCallback = base::OnceCallback<void(Outcome)>;
+
+  struct Config {
+    Config();
+    Config(const Config&) = delete;
+    Config(Config&&);
+    Config& operator=(Config&&);
+    ~Config();
+
+    // Trust-pinned root.json bytes (e.g. from `keys/dev_root.json`).
+    std::vector<uint8_t> root_json;
+    // Base URL containing `timestamp.json`, `snapshot.json`, etc.
+    // Must end with '/'.
+    GURL metadata_base_url;
+    // Base URL of the payload artifacts.
+    GURL payload_base_url;
+    // Filename to look for in `targets.json` (e.g.
+    // "phlink-1.2.3-mac-arm64.zip"). Computed by the factory from the
+    // running platform/arch and the running phlink version.
+    std::string target_name;
+    // Version label written into `staged.json`.
+    std::string target_version;
+    // Directory where `payload.zip` and `staged.json` will be written.
+    base::FilePath staging_dir;
+  };
+
+  UpdateCheckPipeline(scoped_refptr<network::SharedURLLoaderFactory> factory,
+                      Config config);
+  UpdateCheckPipeline(const UpdateCheckPipeline&) = delete;
+  UpdateCheckPipeline& operator=(const UpdateCheckPipeline&) = delete;
+  ~UpdateCheckPipeline();
+
+  void Run(ResultCallback callback);
+
+ private:
+  void OnMetadataFetched(TufError err);
+  void OnPayloadFetched(struct PayloadFetchResult result);
+  void Finish(Outcome outcome);
+
+  scoped_refptr<network::SharedURLLoaderFactory> factory_;
+  Config config_;
+  std::unique_ptr<TufClient> client_;
+  std::unique_ptr<MetadataFetcher> metadata_fetcher_;
+  std::unique_ptr<PayloadFetcher> payload_fetcher_;
+  ResultCallback callback_;
+  base::WeakPtrFactory<UpdateCheckPipeline> weak_factory_{this};
+};
+
+}  // namespace phlink::updater
+
+#endif  // CHROME_BROWSER_PHLINK_UPDATER_UPDATE_CHECK_PIPELINE_H_
diff --git a/chrome/browser/phlink/updater/update_check_pipeline_unittest.cc b/chrome/browser/phlink/updater/update_check_pipeline_unittest.cc
