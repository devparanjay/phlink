diff --git a/chrome/browser/phlink/adblock/cosmetic_filter_host.cc b/chrome/browser/phlink/adblock/cosmetic_filter_host.cc
new file mode 100644
index 0000000000000..0b73c430979bd
--- /dev/null
+++ b/chrome/browser/phlink/adblock/cosmetic_filter_host.cc
@@ -0,0 +1,67 @@
+// Copyright 2026 The phlink Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/phlink/adblock/cosmetic_filter_host.h"
+
+#include <memory>
+#include <utility>
+
+#include "chrome/browser/phlink/adblock/engine_provider.h"
+#include "chrome/browser/phlink/adblock/phlink_adblock.h"
+#include "chrome/common/phlink_adblock.mojom.h"
+#include "mojo/public/cpp/bindings/self_owned_receiver.h"
+#include "url/gurl.h"
+
+namespace phlink::adblock {
+
+namespace {
+
+// Cosmetic filtering is meaningless for chrome://, devtools://, etc.
+// Returning empty resources for unsupported URLs short-circuits the
+// hot path on every internal navigation.
+bool ShouldEvaluate(const GURL& url) {
+  return url.is_valid() &&
+         (url.SchemeIs("http") || url.SchemeIs("https"));
+}
+
+}  // namespace
+
+CosmeticFilterHost::CosmeticFilterHost() = default;
+
+CosmeticFilterHost::~CosmeticFilterHost() = default;
+
+// static
+void CosmeticFilterHost::Create(
+    content::RenderFrameHost* /*render_frame_host*/,
+    mojo::PendingReceiver<mojom::AdblockCosmeticFilter> pending_receiver) {
+  mojo::MakeSelfOwnedReceiver(std::make_unique<CosmeticFilterHost>(),
+                              std::move(pending_receiver));
+}
+
+void CosmeticFilterHost::GetCosmeticResources(
+    const GURL& url,
+    GetCosmeticResourcesCallback callback) {
+  auto out = mojom::AdblockCosmeticResources::New();
+  if (!ShouldEvaluate(url)) {
+    std::move(callback).Run(std::move(out));
+    return;
+  }
+
+  Engine* engine = EngineProvider::GetInstance()->GetEngine();
+  // EngineProvider always returns a non-null engine (empty fallback);
+  // guard defensively in case 5-06's pref toggle later returns null.
+  if (!engine) {
+    std::move(callback).Run(std::move(out));
+    return;
+  }
+
+  Engine::CosmeticResources resources =
+      engine->UrlCosmeticResources(url.spec());
+  out->hide_selectors = std::move(resources.hide_selectors);
+  out->injected_script = std::move(resources.injected_script);
+  out->generichide = resources.generichide;
+  std::move(callback).Run(std::move(out));
+}
+
+}  // namespace phlink::adblock
diff --git a/chrome/browser/phlink/adblock/cosmetic_filter_host.h b/chrome/browser/phlink/adblock/cosmetic_filter_host.h
new file mode 100644
index 0000000000000..898b1a3b153f0
--- /dev/null
+++ b/chrome/browser/phlink/adblock/cosmetic_filter_host.h
@@ -0,0 +1,52 @@
+// Copyright 2026 The phlink Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_PHLINK_ADBLOCK_COSMETIC_FILTER_HOST_H_
+#define CHROME_BROWSER_PHLINK_ADBLOCK_COSMETIC_FILTER_HOST_H_
+
+#include "chrome/common/phlink_adblock.mojom.h"
+#include "mojo/public/cpp/bindings/pending_receiver.h"
+
+namespace content {
+class RenderFrameHost;
+}  // namespace content
+
+namespace phlink::adblock {
+
+// Browser-process implementation of `phlink::mojom::AdblockCosmeticFilter`.
+//
+// The implementation is stateless: every `GetCosmeticResources` call
+// looks up the singleton `EngineProvider`'s engine and asks it for the
+// per-URL cosmetic resources. We therefore bind each receiver via
+// `mojo::MakeSelfOwnedReceiver` rather than tying lifetime to a
+// `DocumentUserData`, which keeps the binder map's `Add` factory a
+// single line and avoids re-binding edge cases.
+//
+// All engine evaluation stays in the browser process. The renderer
+// receives only the resolved CSS / JS strings, never the rule database
+// (PRD §10.1: "site isolation stays ON").
+class CosmeticFilterHost : public mojom::AdblockCosmeticFilter {
+ public:
+  CosmeticFilterHost();
+  ~CosmeticFilterHost() override;
+
+  CosmeticFilterHost(const CosmeticFilterHost&) = delete;
+  CosmeticFilterHost& operator=(const CosmeticFilterHost&) = delete;
+
+  // Factory for `mojo::BinderMapWithContext` — wraps a fresh
+  // `CosmeticFilterHost` in a self-owned receiver bound to
+  // `pending_receiver`. The `RenderFrameHost*` is unused today but
+  // matches the binder map's expected signature.
+  static void Create(content::RenderFrameHost* render_frame_host,
+                     mojo::PendingReceiver<mojom::AdblockCosmeticFilter>
+                         pending_receiver);
+
+  // mojom::AdblockCosmeticFilter:
+  void GetCosmeticResources(const GURL& url,
+                            GetCosmeticResourcesCallback callback) override;
+};
+
+}  // namespace phlink::adblock
+
+#endif  // CHROME_BROWSER_PHLINK_ADBLOCK_COSMETIC_FILTER_HOST_H_
