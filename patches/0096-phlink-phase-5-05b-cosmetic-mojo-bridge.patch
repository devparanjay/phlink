+}
diff --git a/chrome/common/phlink_adblock.mojom b/chrome/common/phlink_adblock.mojom
new file mode 100644
index 0000000000000..475996d68c403
--- /dev/null
+++ b/chrome/common/phlink_adblock.mojom
@@ -0,0 +1,48 @@
+// Copyright 2026 The phlink Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// Renderer ↔ browser plumbing for phlink's cosmetic ad-filtering.
+//
+// The renderer's `RenderFrameObserver` (plan 5-05c) asks the browser
+// process for the per-URL cosmetic resources at document-start. The
+// browser consults `phlink::adblock::Engine::UrlCosmeticResources` and
+// returns the hide-selector list + scriptlet text.
+//
+// All evaluation stays in the browser process to honor PRD §10.1's
+// "site isolation stays ON" rule: the renderer never sees the engine
+// or the rule database.
+module phlink.mojom;
+
+import "url/mojom/url.mojom";
+
+// Per-frame cosmetic resources resolved from the matching ruleset.
+//
+// `hide_selectors` is the union of generic and host-scoped CSS
+// selectors that the renderer should join into a single
+// `display: none !important;` stylesheet. They are returned in
+// stable (sorted) order so equality checks in tests are robust.
+//
+// `injected_script` is the concatenated text of any uBO-style
+// `+js(...)` scriptlets to evaluate at document-start. Empty when
+// no scriptlets match.
+//
+// `generichide` is true when a `$generichide` exception applies to
+// the document's URL — the renderer should drop generic (non host-
+// scoped) selectors before applying the stylesheet.
+struct AdblockCosmeticResources {
+  array<string> hide_selectors;
+  string injected_script;
+  bool generichide;
+};
+
+// Renderer-facing interface implemented by `CosmeticFilterHost` in
+// the browser process and bound per-RenderFrameHost.
+interface AdblockCosmeticFilter {
+  // Returns the cosmetic resources for `url` (the document URL of
+  // the requesting frame). The browser MAY return empty resources
+  // if adblock is disabled, the engine is not yet warm, or the URL
+  // is not eligible for cosmetic filtering (e.g. a chrome:// URL).
+  GetCosmeticResources(url.mojom.Url url)
+      => (AdblockCosmeticResources resources);
+};
