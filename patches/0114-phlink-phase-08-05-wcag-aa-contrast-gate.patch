+// Copyright 2026 The phlink Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// Phase 08-05 (D-07, D-12): WCAG-AA contrast gate. Walks the pair tables
+// declared in phlink_palette.{h,cc} for both Light and Dark ColorMode and
+// asserts each pair meets its WCAG 2.2 threshold (4.5:1 normal text,
+// 3.0:1 non-text UI). Mirrored by scripts/contrast-audit.py at lint time.
+
+#include <utility>
+
+#include "chrome/browser/ui/color/chrome_color_id.h"
+#include "chrome/browser/ui/color/phlink_color_mixer.h"
+#include "chrome/browser/ui/color/phlink_palette.h"
+#include "testing/gtest/include/gtest/gtest.h"
+#include "third_party/skia/include/core/SkColor.h"
+#include "ui/color/color_provider.h"
+#include "ui/color/color_provider_key.h"
+#include "ui/gfx/color_utils.h"
+
+namespace {
+
+constexpr double kWcagAaNormalText = 4.5;
+constexpr double kWcagAaNonText = 3.0;
+
+const char* PhlinkColorIdName(ui::ColorId id) {
+  switch (id) {
+    case kColorPhlinkCanvas: return "kColorPhlinkCanvas";
+    case kColorPhlinkSurface: return "kColorPhlinkSurface";
+    case kColorPhlinkSurfaceAlt: return "kColorPhlinkSurfaceAlt";
+    case kColorPhlinkCard: return "kColorPhlinkCard";
+    case kColorPhlinkText: return "kColorPhlinkText";
+    case kColorPhlinkTextMuted: return "kColorPhlinkTextMuted";
+    case kColorPhlinkHairline: return "kColorPhlinkHairline";
+    case kColorPhlinkAccent: return "kColorPhlinkAccent";
+    case kColorPhlinkOnAccent: return "kColorPhlinkOnAccent";
+    case kColorPhlinkDanger: return "kColorPhlinkDanger";
+    case kColorPhlinkSuccess: return "kColorPhlinkSuccess";
+    default: return "<unknown>";
+  }
+}
+
+template <size_t N>
+void ExpectPairs(
+    const ui::ColorProvider& provider,
+    const std::array<std::pair<ui::ColorId, ui::ColorId>, N>& pairs,
+    double threshold,
+    const char* mode_name) {
+  for (const auto& pair : pairs) {
+    const SkColor fg = provider.GetColor(pair.first);
+    const SkColor bg = provider.GetColor(pair.second);
+    const double ratio = color_utils::GetContrastRatio(fg, bg);
+    EXPECT_GE(ratio, threshold)
+        << "WCAG-AA contrast regression: ("
+        << PhlinkColorIdName(pair.first) << " #" << std::hex
+        << (fg & 0x00FFFFFF) << ", "
+        << PhlinkColorIdName(pair.second) << " #" << std::hex
+        << (bg & 0x00FFFFFF) << ") in " << mode_name
+        << " — got " << ratio << ", required " << threshold;
+  }
+}
+
+template <size_t N>
+void RunPairs(ui::ColorProviderKey::ColorMode mode,
+              const std::array<std::pair<ui::ColorId, ui::ColorId>, N>& pairs,
+              double threshold,
+              const char* mode_name) {
+  ui::ColorProvider provider;
+  ui::ColorProviderKey key;
+  key.color_mode = mode;
+  AddPhlinkColorMixer(&provider, key);
+  provider.GenerateColorMapForTesting();
+  ExpectPairs(provider, pairs, threshold, mode_name);
+}
+
+TEST(PhlinkContrastTest, NormalTextPairs_Light) {
+  RunPairs(ui::ColorProviderKey::ColorMode::kLight,
+           phlink::kPhlinkContrastNormalText, kWcagAaNormalText, "Light");
+}
+
+TEST(PhlinkContrastTest, NormalTextPairs_Dark) {
+  RunPairs(ui::ColorProviderKey::ColorMode::kDark,
+           phlink::kPhlinkContrastNormalText, kWcagAaNormalText, "Dark");
+}
+
+TEST(PhlinkContrastTest, NonTextPairs_Light) {
+  RunPairs(ui::ColorProviderKey::ColorMode::kLight,
+           phlink::kPhlinkContrastNonText, kWcagAaNonText, "Light");
+}
+
+TEST(PhlinkContrastTest, NonTextPairs_Dark) {
+  RunPairs(ui::ColorProviderKey::ColorMode::kDark,
+           phlink::kPhlinkContrastNonText, kWcagAaNonText, "Dark");
+}
+
+}  // namespace
