@@ -38,11 +38,28 @@ enum PhlinkToken : size_t {
 extern const SkColor kPhlinkLight[kPhlinkPaletteSize];
 extern const SkColor kPhlinkDark[kPhlinkPaletteSize];
 
-// WCAG-AA contrast pair tables (D-07). Sizes are zero in patch 0110; patch
-// 0114 wires the gtest gate using these arrays.
-extern const std::array<std::pair<ui::ColorId, ui::ColorId>, 0>
+// WCAG-AA contrast pair tables (D-07). See:
+//   .planning/phases/08-appearance-subsystem/08-CONTEXT.md D-07
+//   .planning/sketches/phase-08/stitch-output.md §2.3
+// The (kColorPhlinkAccent, kColorPhlinkCanvas) Light pair is INTENTIONALLY
+// excluded — its 1.5:1 ratio is mitigated by a 2px stroke + check icon per
+// WCAG SC 1.4.11 (semantic redundancy). Hairline pairs are also excluded:
+// hairlines are purely decorative dividers (no semantic state, no
+// interaction affordance) and fall outside WCAG SC 1.4.11 per its scope
+// note ("pure decoration" exclusion). The recessive ~1.2:1 hairline-to-
+// surface ratio is design-locked by D-08 / stitch-output.md §2.3 (which
+// does not gate hairlines). All pairs in the NormalText table MUST pass
+// 4.5:1; pairs are stored as (foreground, background); pairs in the
+// NonText table MUST pass 3.0:1. phlink_color_contrast_unittests.cc walks
+// both for ColorMode::kLight and ColorMode::kDark.
+inline constexpr size_t kPhlinkContrastNormalTextSize = 7;
+inline constexpr size_t kPhlinkContrastNonTextSize = 0;
+
+extern const std::array<std::pair<ui::ColorId, ui::ColorId>,
+                        kPhlinkContrastNormalTextSize>
     kPhlinkContrastNormalText;
-extern const std::array<std::pair<ui::ColorId, ui::ColorId>, 0>
+extern const std::array<std::pair<ui::ColorId, ui::ColorId>,
+                        kPhlinkContrastNonTextSize>
     kPhlinkContrastNonText;
 
 }  // namespace phlink
