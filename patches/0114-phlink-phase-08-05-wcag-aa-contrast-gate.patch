-const std::array<std::pair<ui::ColorId, ui::ColorId>, 0>
+// WCAG-AA contrast pair tables (D-07). Source: stitch-output.md §2.3.
+// Pairs are (foreground, background). The (kColorPhlinkAccent, kColorPhlinkCanvas)
+// Light pair is INTENTIONALLY excluded — its 1.5:1 ratio is mitigated by a 2px
+// stroke + check icon per WCAG SC 1.4.11 (semantic redundancy). All pairs in
+// these tables MUST pass for both Light and Dark modes; regression triggers
+// the phlink_color_contrast_unittests gate (chromium-side) and the
+// scripts/contrast-audit.py mirror (phlink-side CI).
+const std::array<std::pair<ui::ColorId, ui::ColorId>,
+                 kPhlinkContrastNormalTextSize>
+    kPhlinkContrastNormalText = {{
+        {kColorPhlinkText, kColorPhlinkCanvas},
+        {kColorPhlinkText, kColorPhlinkSurface},
+        {kColorPhlinkText, kColorPhlinkCard},
+        {kColorPhlinkText, kColorPhlinkSurfaceAlt},
+        {kColorPhlinkTextMuted, kColorPhlinkCanvas},
+        {kColorPhlinkTextMuted, kColorPhlinkSurface},
+        {kColorPhlinkOnAccent, kColorPhlinkAccent},
+    }};
+
+const std::array<std::pair<ui::ColorId, ui::ColorId>,
+                 kPhlinkContrastNonTextSize>
     kPhlinkContrastNonText = {};
 
 }  // namespace phlink
