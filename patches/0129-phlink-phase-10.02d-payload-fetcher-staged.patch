diff --git a/chrome/browser/phlink/updater/payload_fetcher.cc b/chrome/browser/phlink/updater/payload_fetcher.cc
new file mode 100644
index 0000000000000..438d6ba8f3c9b
--- /dev/null
+++ b/chrome/browser/phlink/updater/payload_fetcher.cc
@@ -0,0 +1,164 @@
+// Copyright 2026 The phlink Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/phlink/updater/payload_fetcher.h"
+
+#include <utility>
+
+#include "base/check.h"
+#include "base/files/file.h"
+#include "base/files/file_util.h"
+#include "base/functional/bind.h"
+#include "base/task/sequenced_task_runner.h"
+#include "base/task/thread_pool.h"
+#include "crypto/hash.h"
+#include "net/base/load_flags.h"
+#include "net/traffic_annotation/network_traffic_annotation.h"
+#include "services/network/public/cpp/resource_request.h"
+#include "services/network/public/cpp/shared_url_loader_factory.h"
+#include "services/network/public/cpp/simple_url_loader.h"
+
+namespace phlink::updater {
+namespace {
+
+constexpr net::NetworkTrafficAnnotationTag kTrafficAnnotation =
+    net::DefineNetworkTrafficAnnotation("phlink_updater_payload", R"(
+        semantics {
+          sender: "phlink updater"
+          description:
+            "Downloads a phlink update payload (zip) referenced by the "
+            "previously-fetched and signature-verified targets.json. "
+            "phlink verifies the payload's SHA-256 locally before staging."
+          trigger:
+            "A new update version was advertised by signed TUF metadata."
+          data:
+            "None. Only the payload URL is sent. No user identifiers, "
+            "cookies, or auth headers are attached."
+          destination: WEBSITE
+          internal {
+            contacts { email: "updates@phlink.dev" }
+          }
+          user_data { type: NONE }
+          last_reviewed: "2026-04-30"
+        }
+        policy {
+          cookies_allowed: NO
+          setting:
+            "Disable phlink's auto-update by toggling the 'Automatic "
+            "updates' setting under Settings > About phlink."
+          chrome_policy {}
+        })");
+
+}  // namespace
+
+PayloadFetcher::PayloadFetcher(
+    scoped_refptr<network::SharedURLLoaderFactory> factory,
+    base::FilePath staging_dir)
+    : factory_(std::move(factory)),
+      staging_dir_(std::move(staging_dir)),
+      blocking_runner_(base::ThreadPool::CreateSequencedTaskRunner(
+          {base::MayBlock(), base::TaskPriority::BEST_EFFORT})) {
+  CHECK(!staging_dir_.empty());
+}
+
+PayloadFetcher::~PayloadFetcher() = default;
+
+void PayloadFetcher::set_blocking_task_runner_for_testing(
+    scoped_refptr<base::SequencedTaskRunner> runner) {
+  blocking_runner_ = std::move(runner);
+}
+
+void PayloadFetcher::set_max_payload_bytes_for_testing(int64_t max_bytes) {
+  max_payload_bytes_ = max_bytes;
+}
+
+void PayloadFetcher::Fetch(GURL url,
+                           uint64_t expected_length,
+                           std::array<uint8_t, 32> expected_sha256,
+                           ResultCallback callback) {
+  CHECK(url.is_valid());
+  CHECK(!callback_) << "PayloadFetcher is one-shot";
+  callback_ = std::move(callback);
+  expected_length_ = expected_length;
+  expected_sha256_ = expected_sha256;
+
+  base::FilePath payload_path = staging_dir_.Append(FILE_PATH_LITERAL("payload.zip"));
+
+  auto request = std::make_unique<network::ResourceRequest>();
+  request->url = std::move(url);
+  request->method = "GET";
+  request->credentials_mode = network::mojom::CredentialsMode::kOmit;
+  request->load_flags = net::LOAD_DISABLE_CACHE | net::LOAD_BYPASS_CACHE |
+                       net::LOAD_DO_NOT_SAVE_COOKIES;
+
+  loader_ = network::SimpleURLLoader::Create(std::move(request),
+                                             kTrafficAnnotation);
+  loader_->DownloadToFile(
+      factory_.get(),
+      base::BindOnce(&PayloadFetcher::OnDownloaded,
+                     weak_factory_.GetWeakPtr()),
+      payload_path, max_payload_bytes_);
+}
+
+void PayloadFetcher::OnDownloaded(base::FilePath path) {
+  if (path.empty()) {
+    PayloadFetchResult result;
+    result.error = PayloadFetchError::kNetwork;
+    if (callback_) {
+      std::move(callback_).Run(std::move(result));
+    }
+    return;
+  }
+  blocking_runner_->PostTaskAndReplyWithResult(
+      FROM_HERE,
+      base::BindOnce(&PayloadFetcher::VerifyOnBlockingThread, path,
+                     expected_length_, expected_sha256_),
+      base::BindOnce(&PayloadFetcher::OnVerified,
+                     weak_factory_.GetWeakPtr()));
+}
+
+// static
+PayloadFetcher::VerifyOutcome PayloadFetcher::VerifyOnBlockingThread(
+    base::FilePath path,
+    uint64_t expected_length,
+    std::array<uint8_t, 32> expected_sha256) {
+  VerifyOutcome out{PayloadFetchError::kOk, {}};
+  std::optional<int64_t> file_size = base::GetFileSize(path);
+  if (!file_size.has_value() || *file_size < 0) {
+    base::DeleteFile(path);
+    out.error = PayloadFetchError::kIo;
+    return out;
+  }
+  if (static_cast<uint64_t>(*file_size) != expected_length) {
+    base::DeleteFile(path);
+    out.error = PayloadFetchError::kLengthMismatch;
+    return out;
+  }
+  std::string contents;
+  if (!base::ReadFileToString(path, &contents)) {
+    base::DeleteFile(path);
+    out.error = PayloadFetchError::kIo;
+    return out;
+  }
+  std::array<uint8_t, 32> got = crypto::hash::Sha256(contents);
+  if (got != expected_sha256) {
+    base::DeleteFile(path);
+    out.error = PayloadFetchError::kHashMismatch;
+    return out;
+  }
+  out.path = std::move(path);
+  return out;
+}
+
+void PayloadFetcher::OnVerified(VerifyOutcome outcome) {
+  loader_.reset();
+  PayloadFetchResult result;
+  result.error = outcome.error;
+  result.payload_path = std::move(outcome.path);
+  if (callback_) {
+    std::move(callback_).Run(std::move(result));
+  }
+}
+
+}  // namespace phlink::updater
diff --git a/chrome/browser/phlink/updater/payload_fetcher.h b/chrome/browser/phlink/updater/payload_fetcher.h
new file mode 100644
index 0000000000000..bee5e835637b1
--- /dev/null
+++ b/chrome/browser/phlink/updater/payload_fetcher.h
@@ -0,0 +1,99 @@
+// Copyright 2026 The phlink Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_PHLINK_UPDATER_PAYLOAD_FETCHER_H_
+#define CHROME_BROWSER_PHLINK_UPDATER_PAYLOAD_FETCHER_H_
+
+#include <array>
+#include <cstdint>
+#include <memory>
+
+#include "base/files/file_path.h"
+#include "base/functional/callback.h"
+#include "base/memory/scoped_refptr.h"
+#include "base/memory/weak_ptr.h"
+#include "url/gurl.h"
+
+namespace base {
+class SequencedTaskRunner;
+}
+
+namespace network {
+class SharedURLLoaderFactory;
+class SimpleURLLoader;
+}  // namespace network
+
+namespace phlink::updater {
+
+// Result of a single payload fetch.
+enum class PayloadFetchError {
+  kOk,
+  kNetwork,         // SimpleURLLoader returned an empty path.
+  kIo,              // file unreadable on disk after download.
+  kLengthMismatch,  // file size != targets.json `length`.
+  kHashMismatch,    // sha256(file) != targets.json `hashes.sha256`.
+};
+struct PayloadFetchResult {
+  PayloadFetchError error = PayloadFetchError::kOk;
+  base::FilePath payload_path;  // valid only if `error == kOk`.
+};
+
+// Downloads a payload over `network::SimpleURLLoader::DownloadToFile` and
+// verifies its length and SHA-256 against the values found in
+// `targets.json`. On verification failure the staged file is deleted.
+//
+// One-shot: construct, call `Fetch`, await callback, drop.
+class PayloadFetcher {
+ public:
+  using ResultCallback = base::OnceCallback<void(PayloadFetchResult)>;
+
+  // `staging_dir` is created if missing. The downloaded file is written
+  // to `staging_dir/payload.zip`.
+  PayloadFetcher(scoped_refptr<network::SharedURLLoaderFactory> factory,
+                 base::FilePath staging_dir);
+  PayloadFetcher(const PayloadFetcher&) = delete;
+  PayloadFetcher& operator=(const PayloadFetcher&) = delete;
+  ~PayloadFetcher();
+
+  // Inject a custom blocking task runner (tests use the test environment's
+  // thread pool by default).
+  void set_blocking_task_runner_for_testing(
+      scoped_refptr<base::SequencedTaskRunner> runner);
+
+  // Cap on payload size in bytes. Defaults to 512 MiB.
+  void set_max_payload_bytes_for_testing(int64_t max_bytes);
+
+  void Fetch(GURL url,
+             uint64_t expected_length,
+             std::array<uint8_t, 32> expected_sha256,
+             ResultCallback callback);
+
+ private:
+  struct VerifyOutcome {
+    PayloadFetchError error;
+    base::FilePath path;  // empty unless `error == kOk`.
+  };
+
+  void OnDownloaded(base::FilePath path);
+  static VerifyOutcome VerifyOnBlockingThread(
+      base::FilePath path,
+      uint64_t expected_length,
+      std::array<uint8_t, 32> expected_sha256);
+  void OnVerified(VerifyOutcome outcome);
+
+  scoped_refptr<network::SharedURLLoaderFactory> factory_;
+  const base::FilePath staging_dir_;
+  scoped_refptr<base::SequencedTaskRunner> blocking_runner_;
+  int64_t max_payload_bytes_ = 512LL * 1024 * 1024;
+
+  std::unique_ptr<network::SimpleURLLoader> loader_;
+  ResultCallback callback_;
+  uint64_t expected_length_ = 0;
+  std::array<uint8_t, 32> expected_sha256_{};
+  base::WeakPtrFactory<PayloadFetcher> weak_factory_{this};
+};
+
+}  // namespace phlink::updater
+
+#endif  // CHROME_BROWSER_PHLINK_UPDATER_PAYLOAD_FETCHER_H_
