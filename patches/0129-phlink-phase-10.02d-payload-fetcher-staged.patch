+#include "chrome/browser/phlink/updater/staged_payload.h"
+
+#include "base/files/file_path.h"
+#include "base/files/file_util.h"
+#include "base/files/scoped_temp_dir.h"
+#include "base/time/time.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace phlink::updater {
+namespace {
+
+class StagedPayloadTest : public ::testing::Test {
+ protected:
+  void SetUp() override { ASSERT_TRUE(temp_dir_.CreateUniqueTempDir()); }
+  base::FilePath dir() const { return temp_dir_.GetPath(); }
+  base::ScopedTempDir temp_dir_;
+};
+
+TEST_F(StagedPayloadTest, RoundTrip) {
+  StagedPayload in;
+  in.version = "1.2.3";
+  in.payload_path = dir().Append(FILE_PATH_LITERAL("Updates"))
+                        .Append(FILE_PATH_LITERAL("1.2.3"))
+                        .Append(FILE_PATH_LITERAL("payload.zip"));
+  in.verified_at = base::Time::FromDeltaSinceWindowsEpoch(
+      base::Microseconds(1700000000123456));
+
+  ASSERT_TRUE(WriteStagedPayloadJson(dir(), in));
+  EXPECT_TRUE(base::PathExists(dir().AppendASCII("staged.json")));
+
+  std::optional<StagedPayload> out = ReadStagedPayloadJson(dir());
+  ASSERT_TRUE(out.has_value());
+  EXPECT_EQ(out->version, in.version);
+  EXPECT_EQ(out->payload_path, in.payload_path);
+  EXPECT_EQ(out->verified_at, in.verified_at);
+}
+
+TEST_F(StagedPayloadTest, MissingFileReturnsNullopt) {
+  EXPECT_FALSE(ReadStagedPayloadJson(dir()).has_value());
+}
+
+TEST_F(StagedPayloadTest, MalformedJsonReturnsNullopt) {
+  ASSERT_TRUE(base::WriteFile(dir().AppendASCII("staged.json"),
+                              "not even json {{{"));
+  EXPECT_FALSE(ReadStagedPayloadJson(dir()).has_value());
+}
+
+TEST_F(StagedPayloadTest, WrongSchemaReturnsNullopt) {
+  ASSERT_TRUE(base::WriteFile(
+      dir().AppendASCII("staged.json"),
+      R"({"schema":99,"version":"1","payload_path":"/x","verified_at":"0"})"));
+  EXPECT_FALSE(ReadStagedPayloadJson(dir()).has_value());
+}
+
+}  // namespace
