@@ -0,0 +1,42 @@
+// Copyright 2026 The phlink Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_PHLINK_UPDATER_STAGED_PAYLOAD_H_
+#define CHROME_BROWSER_PHLINK_UPDATER_STAGED_PAYLOAD_H_
+
+#include <optional>
+#include <string>
+
+#include "base/files/file_path.h"
+#include "base/time/time.h"
+
+namespace phlink::updater {
+
+// Persistent record of "the latest payload that has been verified and
+// is sitting on disk waiting for the next launch's helper to apply it".
+// Schema (v1):
+//   {
+//     "schema": 1,
+//     "version": "1.2.3",
+//     "payload_path": "<absolute path>",
+//     "verified_at": "<RFC3339 UTC>"
+//   }
+struct StagedPayload {
+  std::string version;
+  base::FilePath payload_path;
+  base::Time verified_at;
+};
+
+// Writes `staged.json` atomically (write-temp + rename). Returns false
+// on I/O error. The file is written under `dir` (which must exist).
+bool WriteStagedPayloadJson(const base::FilePath& dir,
+                            const StagedPayload& staged);
+
+// Reads `staged.json` from `dir`. Returns nullopt if missing or
+// malformed.
+std::optional<StagedPayload> ReadStagedPayloadJson(const base::FilePath& dir);
+
+}  // namespace phlink::updater
