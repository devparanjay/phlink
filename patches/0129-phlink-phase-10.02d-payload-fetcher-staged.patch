+// Copyright 2026 The phlink Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/phlink/updater/payload_fetcher.h"
+
+#include <array>
+#include <string>
+
+#include "base/files/file_util.h"
+#include "base/files/scoped_temp_dir.h"
+#include "base/run_loop.h"
+#include "base/test/bind.h"
+#include "base/test/task_environment.h"
+#include "crypto/hash.h"
+#include "net/http/http_status_code.h"
+#include "services/network/public/cpp/weak_wrapper_shared_url_loader_factory.h"
+#include "services/network/public/mojom/url_response_head.mojom.h"
+#include "services/network/test/test_url_loader_factory.h"
+#include "testing/gtest/include/gtest/gtest.h"
+#include "url/gurl.h"
+
+namespace phlink::updater {
+namespace {
+
+class PayloadFetcherTest : public ::testing::Test {
+ protected:
+  PayloadFetcherTest()
+      : shared_factory_(loader_factory_.GetSafeWeakWrapper()) {}
+
+  void SetUp() override { ASSERT_TRUE(temp_dir_.CreateUniqueTempDir()); }
+
+  base::FilePath staging() const { return temp_dir_.GetPath(); }
+
+  PayloadFetchResult RunFetch(GURL url,
+                              uint64_t expected_length,
+                              std::array<uint8_t, 32> expected_sha256) {
+    PayloadFetcher fetcher(shared_factory_, staging());
+    base::RunLoop run_loop;
+    PayloadFetchResult got;
+    fetcher.Fetch(std::move(url), expected_length, expected_sha256,
+                  base::BindLambdaForTesting([&](PayloadFetchResult r) {
+                    got = std::move(r);
+                    run_loop.Quit();
+                  }));
+    run_loop.Run();
+    return got;
+  }
+
+  base::test::TaskEnvironment task_env_;
+  base::ScopedTempDir temp_dir_;
+  network::TestURLLoaderFactory loader_factory_;
+  scoped_refptr<network::WeakWrapperSharedURLLoaderFactory> shared_factory_;
+};
+
+TEST_F(PayloadFetcherTest, HappyPathDownloadsAndVerifies) {
+  const std::string body = "hello phlink payload";
+  const GURL url("https://updates.example/payload.zip");
+  loader_factory_.AddResponse(url.spec(), body, net::HTTP_OK);
+
+  PayloadFetchResult got =
+      RunFetch(url, body.size(), crypto::hash::Sha256(body));
+  EXPECT_EQ(got.error, PayloadFetchError::kOk);
+  EXPECT_TRUE(base::PathExists(got.payload_path));
+  std::string on_disk;
+  ASSERT_TRUE(base::ReadFileToString(got.payload_path, &on_disk));
+  EXPECT_EQ(on_disk, body);
+}
+
+TEST_F(PayloadFetcherTest, HashMismatchDeletesFile) {
+  const std::string body = "actual bytes";
+  const GURL url("https://updates.example/payload.zip");
+  loader_factory_.AddResponse(url.spec(), body, net::HTTP_OK);
+
+  std::array<uint8_t, 32> wrong = crypto::hash::Sha256("different");
+  PayloadFetchResult got = RunFetch(url, body.size(), wrong);
+  EXPECT_EQ(got.error, PayloadFetchError::kHashMismatch);
+  EXPECT_TRUE(got.payload_path.empty());
+  EXPECT_FALSE(base::PathExists(staging().Append(FILE_PATH_LITERAL("payload.zip"))));
+}
+
+TEST_F(PayloadFetcherTest, LengthMismatchDeletesFile) {
+  const std::string body = "ten chars!";  // 10 bytes
+  const GURL url("https://updates.example/payload.zip");
+  loader_factory_.AddResponse(url.spec(), body, net::HTTP_OK);
+
+  PayloadFetchResult got =
+      RunFetch(url, /*expected_length=*/999, crypto::hash::Sha256(body));
+  EXPECT_EQ(got.error, PayloadFetchError::kLengthMismatch);
+  EXPECT_FALSE(base::PathExists(staging().Append(FILE_PATH_LITERAL("payload.zip"))));
+}
+
+TEST_F(PayloadFetcherTest, NetworkErrorReportsKNetwork) {
+  const GURL url("https://updates.example/payload.zip");
+  loader_factory_.AddResponse(url.spec(), /*content=*/"",
+                              net::HTTP_INTERNAL_SERVER_ERROR);
+
+  PayloadFetchResult got =
+      RunFetch(url, /*expected_length=*/1, std::array<uint8_t, 32>{});
+  EXPECT_EQ(got.error, PayloadFetchError::kNetwork);
+}
+
+}  // namespace
+}  // namespace phlink::updater
diff --git a/chrome/browser/phlink/updater/staged_payload.cc b/chrome/browser/phlink/updater/staged_payload.cc
new file mode 100644
index 0000000000000..30923979b0e7e
--- /dev/null
+++ b/chrome/browser/phlink/updater/staged_payload.cc
@@ -0,0 +1,85 @@
+// Copyright 2026 The phlink Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/phlink/updater/staged_payload.h"
+
+#include <string_view>
+#include <utility>
+
+#include "base/files/file_util.h"
+#include "base/files/important_file_writer.h"
+#include "base/json/json_reader.h"
+#include "base/json/json_writer.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/time/time.h"
+#include "base/values.h"
+
+namespace phlink::updater {
+namespace {
+
+constexpr char kStagedJsonFileName[] = "staged.json";
+constexpr int kSchemaVersion = 1;
+
+constexpr char kKeySchema[] = "schema";
+constexpr char kKeyVersion[] = "version";
+constexpr char kKeyPayloadPath[] = "payload_path";
+constexpr char kKeyVerifiedAt[] = "verified_at";
+
+}  // namespace
+
+bool WriteStagedPayloadJson(const base::FilePath& dir,
+                            const StagedPayload& staged) {
+  if (!base::DirectoryExists(dir) && !base::CreateDirectory(dir)) {
+    return false;
+  }
+  base::DictValue dict;
+  dict.Set(kKeySchema, kSchemaVersion);
+  dict.Set(kKeyVersion, staged.version);
+  dict.Set(kKeyPayloadPath, staged.payload_path.AsUTF8Unsafe());
+  dict.Set(kKeyVerifiedAt,
+           base::NumberToString(
+               staged.verified_at.ToDeltaSinceWindowsEpoch().InMicroseconds()));
+  std::optional<std::string> json = base::WriteJson(dict);
+  if (!json.has_value()) {
+    return false;
+  }
+  return base::ImportantFileWriter::WriteFileAtomically(
+      dir.AppendASCII(kStagedJsonFileName), *json);
+}
+
+std::optional<StagedPayload> ReadStagedPayloadJson(
+    const base::FilePath& dir) {
+  base::FilePath path = dir.AppendASCII(kStagedJsonFileName);
+  std::string contents;
+  if (!base::ReadFileToString(path, &contents)) {
+    return std::nullopt;
+  }
+  std::optional<base::DictValue> d_opt =
+      base::JSONReader::ReadDict(contents, base::JSON_PARSE_RFC);
+  if (!d_opt) {
+    return std::nullopt;
+  }
+  const base::DictValue& d = *d_opt;
+  std::optional<int> schema = d.FindInt(kKeySchema);
+  const std::string* version = d.FindString(kKeyVersion);
+  const std::string* payload_path = d.FindString(kKeyPayloadPath);
+  const std::string* verified_at = d.FindString(kKeyVerifiedAt);
+  if (!schema || *schema != kSchemaVersion || !version || !payload_path ||
+      !verified_at) {
+    return std::nullopt;
+  }
+  base::Time t;
+  int64_t micros = 0;
+  if (!base::StringToInt64(*verified_at, &micros)) {
+    return std::nullopt;
+  }
+  t = base::Time::FromDeltaSinceWindowsEpoch(base::Microseconds(micros));
+  StagedPayload out;
+  out.version = *version;
+  out.payload_path = base::FilePath::FromUTF8Unsafe(*payload_path);
+  out.verified_at = t;
+  return out;
+}
+
+}  // namespace phlink::updater
diff --git a/chrome/browser/phlink/updater/staged_payload.h b/chrome/browser/phlink/updater/staged_payload.h
