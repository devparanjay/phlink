From: phlink <phlink@local>
Subject: [PATCH 5/5] phlink: short-circuit variations seed fetch
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

FetchVariationsSeed() returns immediately. Combined with
disable_fieldtrial_testing_config=true (Phase 3 GN args), this means no
A/B-test seed is ever fetched from clientservices.googleapis.com and no
test seed is baked into the binary. PRD §3.5, TELM-01.
---
 components/variations/service/variations_service.cc | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/components/variations/service/variations_service.cc b/components/variations/service/variations_service.cc
index 29e819f4e807e..776ec692fe519 100644
--- a/components/variations/service/variations_service.cc
+++ b/components/variations/service/variations_service.cc
@@ -777,6 +777,15 @@ void VariationsService::StartRepeatedVariationsSeedFetch() {
 void VariationsService::FetchVariationsSeed() {
   DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
 
+  // phlink: never fetch the variations seed (PRD §3.5, TELM-01..TELM-02).
+  // disable_fieldtrial_testing_config=true (build/gn-args/common.gni)
+  // already prevents the test seed from being baked in; this guard makes
+  // sure no network request leaves the process even if the pref state is
+  // tampered with at runtime.
+  if (true) {
+    return;
+  }
+
   const web_resource::ResourceRequestAllowedNotifier::State state =
       resource_request_allowed_notifier_->GetResourceRequestsAllowedState();
   RecordRequestsAllowedHistogram(ResourceRequestStateToHistogramValue(state));
