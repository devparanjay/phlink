+        /// between `\r` and `\n`. (`$` will similarly not match between a `\r`
+        /// and a `\n`.)
+        ///
+        /// ```
+        /// use regex::RegexSetBuilder;
+        ///
+        /// let re = RegexSetBuilder::new([r"^\n"])
+        ///     .multi_line(true)
+        ///     .crlf(true)
+        ///     .build()
+        ///     .unwrap();
+        /// assert!(!re.is_match("\r\n"));
+        /// ```
+        pub fn crlf(&mut self, yes: bool) -> &mut RegexSetBuilder {
+            self.builder.crlf(yes);
+            self
+        }
