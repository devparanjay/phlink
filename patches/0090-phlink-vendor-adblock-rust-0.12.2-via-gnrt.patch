+/// Create a new `TakeWhileRef` from a reference to clonable iterator.
+pub fn take_while_ref<I, F>(iter: &mut I, f: F) -> TakeWhileRef<I, F>
+where
+    I: Iterator + Clone,
+{
+    TakeWhileRef { iter, f }
+}
