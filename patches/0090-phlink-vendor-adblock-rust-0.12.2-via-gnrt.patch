+        /// the pattern.
+        ///
+        /// The default for this is `false`.
+        ///
+        /// # Example
+        ///
+        /// ```
+        /// use regex::RegexSetBuilder;
+        ///
+        /// let re = RegexSetBuilder::new([r"^foo$"])
+        ///     .multi_line(true)
+        ///     .build()
+        ///     .unwrap();
+        /// assert!(re.is_match("\nfoo\n"));
+        /// ```
+        pub fn multi_line(&mut self, yes: bool) -> &mut RegexSetBuilder {
+            self.builder.multi_line(yes);
+            self
