+        /// the pattern.
+        ///
+        /// The default for this is `false`.
+        ///
+        /// # Example
+        ///
+        /// ```
+        /// use regex::RegexSetBuilder;
+        ///
+        /// let re = RegexSetBuilder::new([r"^foo$"])
+        ///     .multi_line(true)
+        ///     .crlf(true)
+        ///     .build()
+        ///     .unwrap();
+        /// let hay = "\r\nfoo\r\n";
