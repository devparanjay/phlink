+#[test]
+fn count_clones() {
+    // Check that RepeatN only clones N - 1 times.
+
+    use core::cell::Cell;
+    #[derive(PartialEq, Debug)]
+    struct Foo {
+        n: Cell<usize>,
+    }
+
+    impl Clone for Foo {
+        fn clone(&self) -> Self {
+            let n = self.n.get();
+            self.n.set(n + 1);
+            Self {
+                n: Cell::new(n + 1),
+            }
+        }
+    }
+
+    for n in 0..10 {
+        let f = Foo { n: Cell::new(0) };
+        let it = it::repeat_n(f, n);
+        // drain it
+        let last = it.last();
+        if n == 0 {
+            assert_eq!(last, None);
+        } else {
+            assert_eq!(
+                last,
+                Some(Foo {
+                    n: Cell::new(n - 1)
+                })
+            );
+        }
+    }
