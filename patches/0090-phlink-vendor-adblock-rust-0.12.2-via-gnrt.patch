+        /// ```
+        /// use regex::RegexSetBuilder;
+        ///
+        /// assert!(
+        ///     RegexSetBuilder::new([r"."])
+        ///         .line_terminator(0x80)
+        ///         .build()
+        ///         .is_err()
+        /// );
