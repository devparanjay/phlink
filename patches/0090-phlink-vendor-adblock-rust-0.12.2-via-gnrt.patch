+    for (i, (_, chunk)) in grouper.into_iter().enumerate() {
+        if i < 2 {
+            chunks.push(chunk);
+        } else if i < 4 {
+            for _ in chunk {}
+        } else {
+            chunks.push(chunk);
+        }
+    }
