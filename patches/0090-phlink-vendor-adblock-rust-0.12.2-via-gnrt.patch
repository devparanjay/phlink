+    }
+
+    #[test]
+    fn plain_domain() {
+        assert!(is_domain_name("example.com").is_ok());
+    }
+
+    #[test]
+    fn subdomains() {
+        assert!(is_domain_name("a.b.c.d.e.f").is_ok());
+    }
+}
