@@ -0,0 +1,43 @@
+// Copyright 2026 The phlink Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include <cstdio>
+
+#include "base/at_exit.h"
+#include "base/command_line.h"
+#include "base/files/file_path.h"
+#include "chrome/browser/phlink/updater/linux/update_helper_apply.h"
+
+namespace {
+
+void PrintUsage() {
+  fprintf(stderr,
+          "phlink_update_helper --apply <staging_dir> <target_path> "
+          "<signature_path> <gpg_keyring>\n");
+}
+
+}  // namespace
+
+int main(int argc, char** argv) {
+  base::AtExitManager exit_manager;
+  base::CommandLine::Init(argc, argv);
+  const auto& cmd = *base::CommandLine::ForCurrentProcess();
+  if (!cmd.HasSwitch("apply")) {
+    PrintUsage();
+    return static_cast<int>(
+        phlink::updater::linux::ApplyResult::kBadArguments);
+  }
+  const auto args = cmd.GetArgs();
+  if (args.size() != 4) {
+    PrintUsage();
+    return static_cast<int>(
+        phlink::updater::linux::ApplyResult::kBadArguments);
+  }
+  phlink::updater::linux::ApplyOptions opts;
+  opts.staging_dir = base::FilePath(args[0]);
+  opts.target_path = base::FilePath(args[1]);
+  opts.signature_path = base::FilePath(args[2]);
+  opts.gpg_keyring_path = base::FilePath(args[3]);
+  return static_cast<int>(phlink::updater::linux::Apply(opts));
+}
diff --git a/chrome/browser/phlink/updater/linux/update_helper_apply.cc b/chrome/browser/phlink/updater/linux/update_helper_apply.cc
new file mode 100644
index 0000000000000..1b58c30a76d78
--- /dev/null
+++ b/chrome/browser/phlink/updater/linux/update_helper_apply.cc
@@ -0,0 +1,82 @@
+// Copyright 2026 The phlink Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/phlink/updater/linux/update_helper_apply.h"
+
+#include "base/command_line.h"
+#include "base/files/file_path.h"
+#include "base/files/file_util.h"
+#include "base/process/launch.h"
+#include "chrome/browser/phlink/updater/staged_payload.h"
+
+namespace phlink::updater::linux {
+
+namespace {
+
+// Runs `gpg --no-default-keyring --keyring <keyring> --verify <sig> <payload>`.
+// Returns true iff exit code 0.
+bool GpgVerify(const base::FilePath& payload,
+               const base::FilePath& signature,
+               const base::FilePath& keyring) {
+  base::CommandLine cmd(base::FilePath("/usr/bin/gpg"));
+  cmd.AppendArg("--batch");
+  cmd.AppendArg("--no-default-keyring");
+  cmd.AppendArg("--keyring");
+  cmd.AppendArgPath(keyring);
+  cmd.AppendArg("--verify");
+  cmd.AppendArgPath(signature);
+  cmd.AppendArgPath(payload);
+  base::Process p = base::LaunchProcess(cmd, base::LaunchOptions());
+  if (!p.IsValid()) {
+    return false;
+  }
+  int exit_code = -1;
+  return p.WaitForExit(&exit_code) && exit_code == 0;
+}
+
+}  // namespace
+
+ApplyResult Apply(const ApplyOptions& opts) {
+  if (opts.staging_dir.empty() || opts.target_path.empty() ||
+      opts.signature_path.empty()) {
+    return ApplyResult::kBadArguments;
+  }
+
+  auto staged_opt = phlink::updater::ReadStagedPayloadJson(opts.staging_dir);
+  if (!staged_opt) {
+    return base::PathExists(
+               opts.staging_dir.Append(FILE_PATH_LITERAL("staged.json")))
+               ? ApplyResult::kStagedJsonInvalid
+               : ApplyResult::kStagedJsonMissing;
+  }
+  const auto& staged = *staged_opt;
+
+  if (!base::PathExists(staged.payload_path)) {
+    return ApplyResult::kPayloadMissing;
+  }
+
+  if (!opts.skip_signature_check) {
+    if (opts.gpg_keyring_path.empty() ||
+        !base::PathExists(opts.gpg_keyring_path) ||
+        !base::PathExists(opts.signature_path)) {
+      return ApplyResult::kSignatureInvalid;
+    }
+    if (!GpgVerify(staged.payload_path, opts.signature_path,
+                   opts.gpg_keyring_path)) {
+      return ApplyResult::kSignatureInvalid;
+    }
+  }
+
+  // Atomic in-place replace via rename(2); both source and target must
+  // live on the same filesystem.
+  if (!base::Move(staged.payload_path, opts.target_path)) {
+    return ApplyResult::kSwapFailed;
+  }
+
+  base::DeleteFile(
+      opts.staging_dir.Append(FILE_PATH_LITERAL("staged.json")));
+  return ApplyResult::kOk;
+}
+
+}  // namespace phlink::updater::linux
