--- /dev/null
+++ b/chrome/browser/phlink/updater/linux/update_helper_apply.h
@@ -0,0 +1,50 @@
+// Copyright 2026 The phlink Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_PHLINK_UPDATER_LINUX_UPDATE_HELPER_APPLY_H_
+#define CHROME_BROWSER_PHLINK_UPDATER_LINUX_UPDATE_HELPER_APPLY_H_
+
+#include "base/files/file_path.h"
+
+namespace phlink::updater::linux {
+
+// Mirrors phlink::updater::mac::ApplyResult so the CLI exit-code
+// surface is uniform across platforms.
+enum class ApplyResult {
+  kOk = 0,
+  kBadArguments = 2,
+  kStagedJsonMissing = 3,
+  kStagedJsonInvalid = 4,
+  kPayloadMissing = 5,
+  kSignatureInvalid = 8,
+  kSwapFailed = 10,
+};
+
+struct ApplyOptions {
+  // Directory containing `staged.json` and the verified payload
+  // (an AppImage or a tar.gz, depending on install mode).
+  base::FilePath staging_dir;
+
+  // Path to the currently-running phlink binary (`/proc/self/exe`
+  // resolved). For AppImage installs, this is the .AppImage file
+  // itself; for unpacked installs, the binary inside `<prefix>/bin/`.
+  base::FilePath target_path;
+
+  // Path to the detached gpg signature for the payload. Required.
+  base::FilePath signature_path;
+
+  // Path to the gpg keyring that holds phlink's release public key.
+  // Tests inject a fixture keyring; production reads the bundled
+  // `/usr/share/phlink/release.gpg`.
+  base::FilePath gpg_keyring_path;
+
+  // If true, skip gpg verification (tests only).
+  bool skip_signature_check = false;
+};
+
+ApplyResult Apply(const ApplyOptions& opts);
+
+}  // namespace phlink::updater::linux
+
+#endif  // CHROME_BROWSER_PHLINK_UPDATER_LINUX_UPDATE_HELPER_APPLY_H_
diff --git a/chrome/browser/phlink/updater/linux/update_helper_apply_unittest.cc b/chrome/browser/phlink/updater/linux/update_helper_apply_unittest.cc
new file mode 100644
index 0000000000000..8fb73721d1a13
--- /dev/null
+++ b/chrome/browser/phlink/updater/linux/update_helper_apply_unittest.cc
@@ -0,0 +1,68 @@
+// Copyright 2026 The phlink Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/phlink/updater/linux/update_helper_apply.h"
+
+#include <string>
+
+#include "base/files/file_path.h"
+#include "base/files/file_util.h"
+#include "base/files/scoped_temp_dir.h"
+#include "base/time/time.h"
+#include "chrome/browser/phlink/updater/staged_payload.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace phlink::updater::linux {
+namespace {
+
+class UpdateHelperApplyLinuxTest : public ::testing::Test {
+ protected:
+  void SetUp() override { ASSERT_TRUE(temp_.CreateUniqueTempDir()); }
+  base::FilePath path() const { return temp_.GetPath(); }
+  base::ScopedTempDir temp_;
+};
+
+TEST_F(UpdateHelperApplyLinuxTest, BadArgumentsRejected) {
+  ApplyOptions opts;
+  EXPECT_EQ(ApplyResult::kBadArguments, Apply(opts));
+}
+
+TEST_F(UpdateHelperApplyLinuxTest, MissingStagedJsonReturnsKStagedJsonMissing) {
+  ApplyOptions opts;
+  opts.staging_dir = path();
+  opts.target_path = path().AppendASCII("phlink");
+  opts.signature_path = path().AppendASCII("payload.sig");
+  opts.gpg_keyring_path = path().AppendASCII("release.gpg");
+  EXPECT_EQ(ApplyResult::kStagedJsonMissing, Apply(opts));
+}
+
+TEST_F(UpdateHelperApplyLinuxTest, HappyPathReplacesTarget) {
+  // Create a fake payload + target on the same volume.
+  base::FilePath payload = path().AppendASCII("payload.bin");
+  ASSERT_TRUE(base::WriteFile(payload, "new-binary"));
+  base::FilePath target = path().AppendASCII("phlink");
+  ASSERT_TRUE(base::WriteFile(target, "old-binary"));
+
+  StagedPayload sp;
+  sp.version = "1.2.3";
+  sp.payload_path = payload;
+  sp.verified_at = base::Time::Now();
+  ASSERT_TRUE(WriteStagedPayloadJson(path(), sp));
+
+  ApplyOptions opts;
+  opts.staging_dir = path();
+  opts.target_path = target;
+  opts.signature_path = path().AppendASCII("ignored.sig");
+  opts.gpg_keyring_path = path().AppendASCII("ignored.gpg");
+  opts.skip_signature_check = true;
+
+  EXPECT_EQ(ApplyResult::kOk, Apply(opts));
+
+  std::string contents;
+  ASSERT_TRUE(base::ReadFileToString(target, &contents));
+  EXPECT_EQ("new-binary", contents);
+}
+
+}  // namespace
+}  // namespace phlink::updater::linux
