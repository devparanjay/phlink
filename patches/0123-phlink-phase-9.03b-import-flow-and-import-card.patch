+
+#ifndef CHROME_BROWSER_PHLINK_PORTABILITY_IMPORTER_IMPL_H_
+#define CHROME_BROWSER_PHLINK_PORTABILITY_IMPORTER_IMPL_H_
+
+#include <string>
+
+#include "base/files/file_path.h"
+#include "base/memory/weak_ptr.h"
+#include "chrome/browser/phlink/portability/import_service.h"
+#include "chrome/browser/phlink/portability/portability.mojom.h"
+#include "content/public/browser/web_contents_observer.h"
+#include "mojo/public/cpp/bindings/pending_receiver.h"
+#include "mojo/public/cpp/bindings/receiver.h"
+#include "ui/shell_dialogs/select_file_dialog.h"
+
+class Profile;
+
+namespace content {
+class WebContents;
+}  // namespace content
+
+namespace phlink::portability {
+
+// Browser-process implementation of `phlink.portability.mojom.Importer`,
+// backed by `ImportBundleToDir` + `ProfileManager::CreateMultiProfileAsync`.
+//
+// Per CONTEXT D-05: import always creates a *new* profile named
+// `Imported <ISO timestamp>`; the active profile is never modified.
+//
+// Lifetime: one instance per chrome://portability WebUI tab; bounded by
+// the mojo receiver pipe.
+class ImporterImpl : public mojom::Importer,
+                     public ui::SelectFileDialog::Listener,
+                     public content::WebContentsObserver {
+ public:
+  ImporterImpl(content::WebContents* web_contents,
+               mojo::PendingReceiver<mojom::Importer> receiver);
+  ImporterImpl(const ImporterImpl&) = delete;
+  ImporterImpl& operator=(const ImporterImpl&) = delete;
+  ~ImporterImpl() override;
+
+  // mojom::Importer:
+  void Import(const base::FilePath& path,
+              const std::string& passphrase,
+              ImportCallback callback) override;
+  void ImportFromPickedFile(const std::string& passphrase,
+                            ImportFromPickedFileCallback callback) override;
+
