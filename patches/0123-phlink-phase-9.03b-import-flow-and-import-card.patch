diff --git a/chrome/browser/phlink/portability/import_service.cc b/chrome/browser/phlink/portability/import_service.cc
new file mode 100644
index 0000000000000..34539345dc76b
--- /dev/null
+++ b/chrome/browser/phlink/portability/import_service.cc
@@ -0,0 +1,139 @@
+// Copyright 2026 The phlink Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/phlink/portability/import_service.h"
+
+#include <string>
+#include <string_view>
+
+#include "base/files/file_util.h"
+#include "base/json/json_reader.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/values.h"
+#include "chrome/browser/phlink/portability/bundle_reader.h"
+#include "crypto/sha2.h"
+
+namespace phlink::portability {
+
+ImportStatus FromReaderStatus(BundleReader::Status s) {
+  switch (s) {
+    case BundleReader::Status::kOk:
+      return ImportStatus::kOk;
+    case BundleReader::Status::kBadMagic:
+      return ImportStatus::kBadMagic;
+    case BundleReader::Status::kUnsupportedVersion:
+      return ImportStatus::kUnsupportedVersion;
+    case BundleReader::Status::kUnknownPrimitive:
+      return ImportStatus::kUnknownPrimitive;
+    case BundleReader::Status::kBadPassphrase:
+      return ImportStatus::kBadPassphrase;
+    case BundleReader::Status::kIntegrity:
+      return ImportStatus::kIntegrity;
+    case BundleReader::Status::kTruncated:
+      return ImportStatus::kTruncated;
+    case BundleReader::Status::kIo:
+      return ImportStatus::kIo;
+  }
+}
+
+namespace {
+
+std::string ToHexLower(base::span<const uint8_t> bytes) {
+  static const char kHex[] = "0123456789abcdef";
+  std::string out;
+  out.reserve(bytes.size() * 2);
+  for (uint8_t b : bytes) {
+    out.push_back(kHex[(b >> 4) & 0xF]);
+    out.push_back(kHex[b & 0xF]);
+  }
+  return out;
+}
+
+// Validates each entry's sha256 against the manifest's `entries` array.
+// Returns true if every entry matches; returns true even for an empty
+// or absent `entries` array (defensive — older bundles may omit it).
+bool VerifyManifestHashes(
+    base::span<const uint8_t> manifest_bytes,
+    const std::map<std::string, std::vector<uint8_t>>& entries) {
+  std::string_view manifest_str(
+      reinterpret_cast<const char*>(manifest_bytes.data()),
+      manifest_bytes.size());
+  std::optional<base::DictValue> root =
+      base::JSONReader::ReadDict(manifest_str, base::JSON_PARSE_RFC);
+  if (!root) {
+    return false;
+  }
+  const base::ListValue* arr = root->FindList("entries");
+  if (!arr) {
+    return true;
+  }
+  for (const base::Value& v : *arr) {
+    if (!v.is_dict()) {
+      return false;
+    }
+    const std::string* path = v.GetDict().FindString("path");
+    const std::string* sha = v.GetDict().FindString("sha256");
+    if (!path || !sha) {
+      return false;
+    }
+    auto it = entries.find(*path);
+    if (it == entries.end()) {
+      return false;
+    }
+    auto digest = crypto::SHA256Hash(it->second);
+    if (ToHexLower(digest) != *sha) {
+      return false;
+    }
+  }
+  return true;
+}
+
+}  // namespace
+
+ImportStatus ImportBundleToDir(const base::FilePath& bundle_path,
+                               std::string_view passphrase,
+                               const base::FilePath& dest_profile_dir) {
+  if (passphrase.empty()) {
+    return ImportStatus::kBadPassphrase;
+  }
+  if (dest_profile_dir.empty()) {
+    return ImportStatus::kIo;
+  }
+  if (!base::CreateDirectory(dest_profile_dir)) {
+    return ImportStatus::kIo;
+  }
+
+  BundleReader reader;
+  BundleReader::Status rs = reader.OpenFile(bundle_path, passphrase);
+  if (rs != BundleReader::Status::kOk) {
+    return FromReaderStatus(rs);
+  }
+
+  if (!VerifyManifestHashes(reader.Manifest(), reader.Entries())) {
+    return ImportStatus::kIntegrity;
+  }
+
+  for (const auto& [name, bytes] : reader.Entries()) {
+    // Reject any entry whose virtual path tries to escape the profile
+    // directory (defence in depth — `BundleReader` already rejects
+    // absolute paths and `..` segments at parse time, but never trust
+    // a single layer).
+    base::FilePath rel = base::FilePath::FromASCII(name);
+    if (rel.IsAbsolute() || rel.ReferencesParent()) {
+      return ImportStatus::kIntegrity;
+    }
+    base::FilePath dst = dest_profile_dir.Append(rel);
+    base::FilePath dst_parent = dst.DirName();
+    if (!base::CreateDirectory(dst_parent)) {
+      return ImportStatus::kIo;
+    }
+    if (!base::WriteFile(dst, bytes)) {
+      return ImportStatus::kIo;
+    }
+  }
+
+  return ImportStatus::kOk;
+}
+
+}  // namespace phlink::portability
