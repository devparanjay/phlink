+// Copyright 2026 The phlink Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_PHLINK_PORTABILITY_IMPORT_SERVICE_H_
+#define CHROME_BROWSER_PHLINK_PORTABILITY_IMPORT_SERVICE_H_
+
+#include <string_view>
+
+#include "base/files/file_path.h"
+#include "chrome/browser/phlink/portability/bundle_reader.h"
+
+namespace phlink::portability {
+
+// Mirrors `phlink.portability.mojom.ImportStatus`. The `BundleReader`
+// failure codes are surfaced verbatim, plus a few service-level codes
+// for ProfileManager failures.
+enum class ImportStatus {
+  kOk,
+  kBadMagic,
+  kUnsupportedVersion,
+  kUnknownPrimitive,
+  kBadPassphrase,
+  kIntegrity,
+  kTruncated,
+  kIo,
+  kProfileCreationFailed,
+};
+
+// Helper: lossless map from `BundleReader::Status` → `ImportStatus`.
+ImportStatus FromReaderStatus(BundleReader::Status s);
+
+// Decrypts `bundle_path` with `passphrase` and writes each tar entry
+// into `dest_profile_dir`. Files that already exist in
+// `dest_profile_dir` (e.g. defaults Chromium just created when the
+// profile was minted) are overwritten.
+//
+// Validates each entry's sha256 against `MANIFEST.json::entries` as a
+// programmer-error guard, even though the AEAD tag already covers the
+// whole payload (cheap, catches manifest/tar drift).
+//
+// Blocking — call on a `base::ThreadPool` worker.
+ImportStatus ImportBundleToDir(const base::FilePath& bundle_path,
+                               std::string_view passphrase,
+                               const base::FilePath& dest_profile_dir);
+
+}  // namespace phlink::portability
+
+#endif  // CHROME_BROWSER_PHLINK_PORTABILITY_IMPORT_SERVICE_H_
