@@ -0,0 +1,74 @@
+// Copyright 2026 The phlink Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/phlink/portability/import_service.h"
+
+#include <string>
+
+#include "base/files/file_util.h"
+#include "base/files/scoped_temp_dir.h"
+#include "chrome/browser/phlink/portability/export_service.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace phlink::portability {
+namespace {
+
+base::FilePath WriteSealedBundleFromTempProfile(base::ScopedTempDir* profile,
+                                                base::ScopedTempDir* out_dir,
+                                                std::string_view passphrase) {
+  CHECK(profile->CreateUniqueTempDir());
+  CHECK(base::WriteFile(profile->GetPath().AppendASCII("Bookmarks"),
+                        "{\"roots\":\"bm\"}"));
+  CHECK(base::WriteFile(profile->GetPath().AppendASCII("Preferences"),
+                        "{\"theme\":\"dark\"}"));
+
+  CHECK(out_dir->CreateUniqueTempDir());
+  base::FilePath dest = out_dir->GetPath().AppendASCII("out.phlinkbundle");
+  CHECK_EQ(ExportProfileToBundle(profile->GetPath(), dest, passphrase),
+           ExportStatus::kOk);
+  return dest;
+}
+
+TEST(ImportServiceTest, RejectsEmptyPassphrase) {
+  base::ScopedTempDir tmp;
+  ASSERT_TRUE(tmp.CreateUniqueTempDir());
+  EXPECT_EQ(ImportBundleToDir(base::FilePath(FILE_PATH_LITERAL("nope")),
+                              "", tmp.GetPath()),
+            ImportStatus::kBadPassphrase);
+}
+
+TEST(ImportServiceTest, RejectsBadPassphrase) {
+  base::ScopedTempDir profile;
+  base::ScopedTempDir out;
+  base::FilePath bundle =
+      WriteSealedBundleFromTempProfile(&profile, &out, "right-pw");
+
+  base::ScopedTempDir dest;
+  ASSERT_TRUE(dest.CreateUniqueTempDir());
+  EXPECT_EQ(ImportBundleToDir(bundle, "wrong-pw", dest.GetPath()),
+            ImportStatus::kBadPassphrase);
+}
+
+TEST(ImportServiceTest, RoundTripWritesEntriesIntoDir) {
+  base::ScopedTempDir profile;
+  base::ScopedTempDir out;
+  base::FilePath bundle =
+      WriteSealedBundleFromTempProfile(&profile, &out, "pw");
+
+  base::ScopedTempDir dest;
+  ASSERT_TRUE(dest.CreateUniqueTempDir());
+  ASSERT_EQ(ImportBundleToDir(bundle, "pw", dest.GetPath()), ImportStatus::kOk);
+
+  std::string bookmarks;
+  std::string preferences;
+  ASSERT_TRUE(base::ReadFileToString(dest.GetPath().AppendASCII("Bookmarks"),
+                                     &bookmarks));
+  ASSERT_TRUE(base::ReadFileToString(dest.GetPath().AppendASCII("Preferences"),
+                                     &preferences));
+  EXPECT_EQ(bookmarks, "{\"roots\":\"bm\"}");
+  EXPECT_EQ(preferences, "{\"theme\":\"dark\"}");
+}
+
+}  // namespace
+}  // namespace phlink::portability
diff --git a/chrome/browser/phlink/portability/importer_impl.cc b/chrome/browser/phlink/portability/importer_impl.cc
new file mode 100644
index 0000000000000..2223cf442a44c
--- /dev/null
+++ b/chrome/browser/phlink/portability/importer_impl.cc
@@ -0,0 +1,202 @@
+// Copyright 2026 The phlink Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/phlink/portability/importer_impl.h"
+
+#include <string>
+#include <utility>
+
+#include "base/files/file_util.h"
+#include "base/functional/bind.h"
+#include "base/strings/stringprintf.h"
+#include "base/strings/utf_string_conversions.h"
+#include "base/task/task_traits.h"
+#include "base/task/thread_pool.h"
+#include "base/time/time.h"
+#include "chrome/browser/phlink/portability/import_service.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/profiles/profile_manager.h"
+#include "chrome/browser/ui/select_file_policy/chrome_select_file_policy.h"
+#include "content/public/browser/web_contents.h"
+#include "ui/shell_dialogs/select_file_dialog.h"
+#include "ui/shell_dialogs/selected_file_info.h"
+
+namespace phlink::portability {
+namespace {
+
+mojom::ImportStatus ToMojom(ImportStatus s) {
+  switch (s) {
+    case ImportStatus::kOk:
+      return mojom::ImportStatus::kOk;
+    case ImportStatus::kBadMagic:
+      return mojom::ImportStatus::kBadMagic;
+    case ImportStatus::kUnsupportedVersion:
+      return mojom::ImportStatus::kUnsupportedVersion;
+    case ImportStatus::kUnknownPrimitive:
+      return mojom::ImportStatus::kUnknownPrimitive;
+    case ImportStatus::kBadPassphrase:
+      return mojom::ImportStatus::kBadPassphrase;
+    case ImportStatus::kIntegrity:
+      return mojom::ImportStatus::kIntegrity;
+    case ImportStatus::kTruncated:
+      return mojom::ImportStatus::kTruncated;
+    case ImportStatus::kIo:
+      return mojom::ImportStatus::kIo;
+    case ImportStatus::kProfileCreationFailed:
+      return mojom::ImportStatus::kProfileCreationFailed;
+  }
+}
+
+ImportStatus RunImportOnWorker(base::FilePath bundle_path,
+                               std::string passphrase,
+                               base::FilePath dest_dir) {
+  return ImportBundleToDir(bundle_path, passphrase, dest_dir);
+}
+
+std::u16string MakeImportedProfileName(base::Time now) {
+  base::Time::Exploded e;
+  now.UTCExplode(&e);
+  // Stable English label; the spec calls for ISO-8601 timestamp.
+  return base::ASCIIToUTF16(base::StringPrintf(
+      "Imported %04d-%02d-%02dT%02d:%02d:%02dZ", e.year, e.month, e.day_of_month,
+      e.hour, e.minute, e.second));
+}
+
+void DeleteProfileDirOnWorker(base::FilePath dir) {
+  base::DeletePathRecursively(dir);
+}
+
+}  // namespace
+
+ImporterImpl::ImporterImpl(content::WebContents* web_contents,
+                           mojo::PendingReceiver<mojom::Importer> receiver)
+    : content::WebContentsObserver(web_contents),
+      receiver_(this, std::move(receiver)) {}
+
+ImporterImpl::~ImporterImpl() {
+  if (select_file_dialog_) {
+    select_file_dialog_->ListenerDestroyed();
+  }
+  if (pending_picker_callback_) {
+    std::move(pending_picker_callback_)
+        .Run(mojom::ImportStatus::kIo, base::FilePath());
+  }
+}
+
+void ImporterImpl::Import(const base::FilePath& path,
+                          const std::string& passphrase,
+                          ImportCallback callback) {
+  if (passphrase.empty()) {
+    std::move(callback).Run(mojom::ImportStatus::kBadPassphrase,
+                            base::FilePath());
+    return;
+  }
+  if (path.empty()) {
+    std::move(callback).Run(mojom::ImportStatus::kIo, base::FilePath());
+    return;
+  }
+
+  ProfileManager::CreateMultiProfileAsync(
+      MakeImportedProfileName(base::Time::Now()),
+      /*icon_index=*/0,
+      /*is_hidden=*/false,
+      base::BindOnce(&ImporterImpl::OnProfileCreated,
+                     weak_factory_.GetWeakPtr(), path, passphrase,
+                     std::move(callback)));
+}
+
+void ImporterImpl::ImportFromPickedFile(
+    const std::string& passphrase,
+    ImportFromPickedFileCallback callback) {
+  if (pending_picker_callback_) {
+    std::move(callback).Run(mojom::ImportStatus::kIo, base::FilePath());
+    return;
+  }
+  if (passphrase.empty()) {
+    std::move(callback).Run(mojom::ImportStatus::kBadPassphrase,
+                            base::FilePath());
+    return;
+  }
+  content::WebContents* wc = web_contents();
+  if (!wc) {
+    std::move(callback).Run(mojom::ImportStatus::kIo, base::FilePath());
+    return;
+  }
+
+  pending_picker_callback_ = std::move(callback);
+  pending_passphrase_ = passphrase;
+
+  select_file_dialog_ = ui::SelectFileDialog::Create(
+      this, std::make_unique<ChromeSelectFilePolicy>(wc));
+  ui::SelectFileDialog::FileTypeInfo file_types;
+  file_types.extensions = {{FILE_PATH_LITERAL("phlinkbundle")}};
+  file_types.include_all_files = true;
+
+  select_file_dialog_->SelectFile(
+      ui::SelectFileDialog::SELECT_OPEN_FILE,
+      /*title=*/std::u16string(), base::FilePath(), &file_types,
+      /*file_type_index=*/1, FILE_PATH_LITERAL("phlinkbundle"),
+      wc->GetTopLevelNativeWindow());
+}
+
+void ImporterImpl::FileSelected(const ui::SelectedFileInfo& file, int index) {
+  select_file_dialog_.reset();
+  base::FilePath bundle_path = file.path();
+  std::string passphrase = std::move(pending_passphrase_);
+  ImportFromPickedFileCallback cb = std::move(pending_picker_callback_);
+  // Re-use the regular Import path now that we have a concrete file.
+  Import(bundle_path, passphrase, std::move(cb));
+}
+
+void ImporterImpl::FileSelectionCanceled() {
+  select_file_dialog_.reset();
+  pending_passphrase_.clear();
+  if (pending_picker_callback_) {
+    std::move(pending_picker_callback_)
+        .Run(mojom::ImportStatus::kIo, base::FilePath());
+  }
+}
+
+void ImporterImpl::OnProfileCreated(base::FilePath bundle_path,
+                                    std::string passphrase,
+                                    ImportCallback callback,
+                                    Profile* profile) {
+  if (!profile) {
+    std::move(callback).Run(mojom::ImportStatus::kProfileCreationFailed,
+                            base::FilePath());
+    return;
+  }
+  base::FilePath profile_path = profile->GetPath();
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE,
+      {base::MayBlock(), base::TaskPriority::USER_BLOCKING,
+       base::TaskShutdownBehavior::SKIP_ON_SHUTDOWN},
+      base::BindOnce(&RunImportOnWorker, std::move(bundle_path),
+                     std::move(passphrase), profile_path),
+      base::BindOnce(&ImporterImpl::OnImportFinished,
+                     weak_factory_.GetWeakPtr(), profile_path,
+                     std::move(callback)));
+}
+
+void ImporterImpl::OnImportFinished(base::FilePath profile_path,
+                                    ImportCallback callback,
+                                    ImportStatus status) {
+  if (status != ImportStatus::kOk) {
+    // Best-effort: remove the half-populated scratch profile dir so the
+    // user doesn't see an empty "Imported …" entry in the picker. We
+    // don't try to unregister the profile from `ProfileAttributesStorage`
+    // here (Chromium's profile-deletion machinery is expensive); the
+    // dir-only cleanup is enough for v1.
+    base::ThreadPool::PostTask(
+        FROM_HERE,
+        {base::MayBlock(), base::TaskPriority::BEST_EFFORT,
+         base::TaskShutdownBehavior::SKIP_ON_SHUTDOWN},
+        base::BindOnce(&DeleteProfileDirOnWorker, profile_path));
+    std::move(callback).Run(ToMojom(status), base::FilePath());
+    return;
+  }
+  std::move(callback).Run(mojom::ImportStatus::kOk, profile_path);
+}
+
+}  // namespace phlink::portability
