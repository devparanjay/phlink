+
+// Mirrors phlink::portability::ImportStatus in C++. See
+// docs/dev/profile-bundle-format.md §7 for the user-visible mapping.
+enum ImportStatus {
+  kOk,
+  kBadMagic,
+  kUnsupportedVersion,
+  kUnknownPrimitive,
+  kBadPassphrase,
+  kIntegrity,
+  kTruncated,
+  kIo,
+  // ProfileManager rejected the new profile (rare; out-of-disk, name
+  // collision, …). Distinct from kIo so the UI can offer a different
+  // remedy.
+  kProfileCreationFailed,
+};
+
+// Browser-side service driving a single `.phlinkbundle` import.
+//
+// Lifetime: created per WebUI binding. Cancelled on disconnect.
+//
+// Per CONTEXT D-05: import always creates a new profile named
+// `Imported <ISO timestamp>`; the active profile is never modified.
+interface Importer {
+  // Reads + decrypts `path` with `passphrase`, mints a fresh profile,
+  // and copies the bundle entries into it. On success replies with the
+  // new profile's directory path so the WebUI can offer a "switch"
+  // affordance.
+  Import(mojo_base.mojom.FilePath path, string passphrase)
+      => (ImportStatus status, mojo_base.mojom.FilePath new_profile_path);
+
+  // Convenience entry point for chrome://portability: opens the
+  // platform open-file dialog (anchored to the WebUI window), then
+  // runs the same import. On cancel replies with `kIo` and an empty
+  // path.
+  ImportFromPickedFile(string passphrase)
+      => (ImportStatus status, mojo_base.mojom.FilePath new_profile_path);
+};
