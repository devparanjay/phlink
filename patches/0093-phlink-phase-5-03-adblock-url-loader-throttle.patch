+TEST(PhlinkAdblockEngineProviderTest, SingletonAlwaysReturnsEngine) {
+  Engine* e = EngineProvider::GetInstance()->GetEngine();
+  ASSERT_TRUE(e);
+  // Same singleton on a second call.
+  EXPECT_EQ(e, EngineProvider::GetInstance()->GetEngine());
