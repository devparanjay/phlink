@@ -0,0 +1,66 @@
+// Copyright 2026 The phlink Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_PHLINK_ADBLOCK_PHLINK_ADBLOCK_THROTTLE_H_
+#define CHROME_BROWSER_PHLINK_ADBLOCK_PHLINK_ADBLOCK_THROTTLE_H_
+
+#include <memory>
+
+#include "base/memory/raw_ptr.h"
+#include "services/network/public/mojom/fetch_api.mojom-shared.h"
+#include "third_party/blink/public/common/loader/url_loader_throttle.h"
+
+namespace phlink::adblock {
+
+class Engine;
+
+// `URLLoaderThrottle` that consults the process-global `Engine` and
+// cancels the load with `net::ERR_BLOCKED_BY_CLIENT` when the rules
+// match. Exception (`@@`) and `$important` semantics are honored by
+// the underlying engine; this throttle simply translates `matched`
+// into a cancel.
+//
+// Lifetime: created per-request by `ChromeContentBrowserClient::
+// CreateURLLoaderThrottles` and consumed by the `ThrottlingURLLoader`
+// machinery. Holds a non-owning pointer to the singleton `Engine`,
+// which lives for the life of the browser process.
+class PhlinkAdblockThrottle final : public blink::URLLoaderThrottle {
+ public:
+  // Returns `nullptr` when adblock is disabled at compile time. Always
+  // returns a throttle in v1 (kill-switch ships in plan 5-06).
+  static std::unique_ptr<PhlinkAdblockThrottle> MaybeCreate();
+
+  PhlinkAdblockThrottle(const PhlinkAdblockThrottle&) = delete;
+  PhlinkAdblockThrottle& operator=(const PhlinkAdblockThrottle&) = delete;
+  ~PhlinkAdblockThrottle() override;
+
+  // blink::URLLoaderThrottle:
+  void DetachFromCurrentSequence() override;
+  void WillStartRequest(network::ResourceRequest* request,
+                        bool* defer) override;
+  void WillRedirectRequest(
+      net::RedirectInfo* redirect_info,
+      const network::mojom::URLResponseHead& response_head,
+      bool* defer,
+      std::vector<std::string>* to_be_removed_request_headers,
+      net::HttpRequestHeaders* modified_request_headers,
+      net::HttpRequestHeaders* modified_cors_exempt_request_headers) override;
+  const char* NameForLoggingWillStartRequest() override;
+
+ private:
+  explicit PhlinkAdblockThrottle(Engine* engine);
+
+  // Common matcher used by start + redirect.
+  bool ShouldBlock(const GURL& url,
+                   const GURL& source_url,
+                   network::mojom::RequestDestination destination) const;
+
+  // Non-owning. The engine is owned by the singleton EngineProvider and
+  // outlives every throttle.
+  raw_ptr<Engine> engine_;
+};
+
+}  // namespace phlink::adblock
+
+#endif  // CHROME_BROWSER_PHLINK_ADBLOCK_PHLINK_ADBLOCK_THROTTLE_H_
