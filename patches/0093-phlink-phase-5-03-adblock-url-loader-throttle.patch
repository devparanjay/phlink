+TEST(PhlinkAdblockEngineProviderTest, SetEngineFromRulesForTestingSwaps) {
+  EngineProvider::GetInstance()->SetEngineFromRulesForTesting(
+      "||ad.provider.invalid^");
+  Engine* e = EngineProvider::GetInstance()->GetEngine();
+  ASSERT_TRUE(e);
+  auto d = e->ShouldBlock("https://ad.provider.invalid/x.js",
+                          "https://news.example.test/", "script");
+  EXPECT_TRUE(d.matched);
+
+  // Reset to empty so we don't pollute the global for other tests.
+  EngineProvider::GetInstance()->SetEngineFromRulesForTesting("");
+}
