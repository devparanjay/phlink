+// Copyright 2026 The phlink Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/phlink/adblock/engine_provider.h"
+
+#include <memory>
+#include <utility>
+
+#include "base/no_destructor.h"
+#include "chrome/browser/phlink/adblock/phlink_adblock.h"
+
+namespace phlink::adblock {
+
+namespace {}  // namespace
+
+// static
+EngineProvider* EngineProvider::GetInstance() {
+  static base::NoDestructor<EngineProvider> instance;
+  return instance.get();
+}
+
+EngineProvider::EngineProvider() = default;
+
+Engine* EngineProvider::GetEngine() {
+  std::lock_guard<std::mutex> lock(mutex_);
+  if (!engine_) {
+    engine_ = Engine::CreateEmpty();
+  }
+  return engine_.get();
+}
+
+void EngineProvider::SetEngineFromRulesForTesting(std::string_view rules) {
+  std::unique_ptr<Engine> fresh = Engine::CreateFromRules(rules);
+  std::lock_guard<std::mutex> lock(mutex_);
+  engine_ = std::move(fresh);
+}
+
+}  // namespace phlink::adblock
diff --git a/chrome/browser/phlink/adblock/engine_provider.h b/chrome/browser/phlink/adblock/engine_provider.h
new file mode 100644
index 0000000000000..d3e8ee3383260
--- /dev/null
+++ b/chrome/browser/phlink/adblock/engine_provider.h
@@ -0,0 +1,59 @@
+// Copyright 2026 The phlink Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_PHLINK_ADBLOCK_ENGINE_PROVIDER_H_
+#define CHROME_BROWSER_PHLINK_ADBLOCK_ENGINE_PROVIDER_H_
+
+#include <memory>
+#include <mutex>
+#include <string_view>
+
+namespace base {
+template <typename T>
+class NoDestructor;
+}  // namespace base
+
+namespace phlink::adblock {
+
+class Engine;
+
+// Process-global owner of the network-side adblock engine.
+//
+// Phase 5-03: a single `Engine` lives for the life of the browser process,
+// initialized lazily on first access with an empty rule set. Plan 5-04
+// will replace the empty-engine seed with the bundled filter lists.
+//
+// Thread-safety: `GetEngine()` is safe to call from any thread. The
+// returned pointer is owned by the provider; the underlying `Engine` is
+// itself internally synchronized (Mutex inside `adblock-rust`), so
+// callers may call `ShouldBlock` concurrently from any sequence.
+//
+// The header intentionally avoids including any `base/` headers so that
+// downstream test targets do not need a transitive partition_alloc dep.
+class EngineProvider {
+ public:
+  static EngineProvider* GetInstance();
+
+  EngineProvider(const EngineProvider&) = delete;
+  EngineProvider& operator=(const EngineProvider&) = delete;
+
+  // Returns the live engine pointer. Never null.
+  Engine* GetEngine();
+
+  // Test seam: replace the live engine with one built from `rules`.
+  void SetEngineFromRulesForTesting(std::string_view rules);
+
+ private:
+  friend class base::NoDestructor<EngineProvider>;
+
+  EngineProvider();
+  ~EngineProvider() = delete;
+
+  mutable std::mutex mutex_;
+  std::unique_ptr<Engine> engine_;
+};
+
+}  // namespace phlink::adblock
+
+#endif  // CHROME_BROWSER_PHLINK_ADBLOCK_ENGINE_PROVIDER_H_
diff --git a/chrome/browser/phlink/adblock/phlink_adblock_throttle.cc b/chrome/browser/phlink/adblock/phlink_adblock_throttle.cc
new file mode 100644
index 0000000000000..cf001934b3fce
--- /dev/null
+++ b/chrome/browser/phlink/adblock/phlink_adblock_throttle.cc
@@ -0,0 +1,168 @@
+// Copyright 2026 The phlink Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/phlink/adblock/phlink_adblock_throttle.h"
+
+#include <string_view>
+
+#include "chrome/browser/phlink/adblock/engine_provider.h"
+#include "chrome/browser/phlink/adblock/phlink_adblock.h"
+#include "base/memory/ptr_util.h"
+#include "net/base/net_errors.h"
+#include "net/url_request/redirect_info.h"
+#include "services/network/public/cpp/resource_request.h"
+#include "services/network/public/mojom/fetch_api.mojom-shared.h"
+#include "url/gurl.h"
+
+namespace phlink::adblock {
+
+namespace {
+
+// Maps Fetch's `RequestDestination` enum to the string vocabulary
+// adblock-rust accepts. See //services/network/public/mojom/fetch_api.mojom
+// and adblock-rust's `request::RequestType`.
+std::string_view DestinationToRequestType(
+    network::mojom::RequestDestination destination) {
+  using D = network::mojom::RequestDestination;
+  switch (destination) {
+    case D::kEmpty:
+      // Fetch / XHR / beacon all surface as kEmpty in Chromium. Mapping
+      // to "xmlhttprequest" lines up with how adblock-rust's `$xhr`
+      // option is matched.
+      return "xmlhttprequest";
+    case D::kAudio:
+    case D::kVideo:
+    case D::kTrack:
+      return "media";
+    case D::kDocument:
+      return "document";
+    case D::kEmbed:
+    case D::kIframe:
+    case D::kFrame:
+    case D::kFencedframe:
+    case D::kObject:
+      return "subdocument";
+    case D::kFont:
+      return "font";
+    case D::kImage:
+      return "image";
+    case D::kManifest:
+      return "other";
+    case D::kReport:
+      return "ping";
+    case D::kScript:
+    case D::kAudioWorklet:
+    case D::kPaintWorklet:
+    case D::kServiceWorker:
+    case D::kSharedWorker:
+    case D::kWorker:
+    case D::kSpeculationRules:
+    case D::kJson:
+      return "script";
+    case D::kStyle:
+    case D::kXslt:
+      return "stylesheet";
+    case D::kWebIdentity:
+    case D::kDictionary:
+    case D::kSharedStorageWorklet:
+    case D::kWebBundle:
+    case D::kEmailVerification:
+      return "other";
+  }
+  return "other";
+}
+
+// Best-effort source URL: prefer the request initiator's origin URL.
+GURL DeriveSourceUrl(const network::ResourceRequest& request) {
+  if (request.request_initiator.has_value() &&
+      !request.request_initiator->opaque()) {
+    return request.request_initiator->GetURL();
+  }
+  return request.site_for_cookies.RepresentativeUrl();
+}
+
+}  // namespace
+
+// static
+std::unique_ptr<PhlinkAdblockThrottle> PhlinkAdblockThrottle::MaybeCreate() {
+  Engine* engine = EngineProvider::GetInstance()->GetEngine();
+  if (!engine) {
+    return nullptr;
+  }
+  return base::WrapUnique(new PhlinkAdblockThrottle(engine));
+}
+
+PhlinkAdblockThrottle::PhlinkAdblockThrottle(Engine* engine)
+    : engine_(engine) {}
+
+PhlinkAdblockThrottle::~PhlinkAdblockThrottle() = default;
+
+void PhlinkAdblockThrottle::DetachFromCurrentSequence() {
+  // The engine is internally synchronized; safe to use from any sequence.
+}
+
+const char* PhlinkAdblockThrottle::NameForLoggingWillStartRequest() {
+  return "PhlinkAdblockThrottle";
+}
+
+void PhlinkAdblockThrottle::WillStartRequest(network::ResourceRequest* request,
+                                             bool* defer) {
+  if (!engine_ || !request) {
+    return;
+  }
+  if (ShouldBlock(request->url, DeriveSourceUrl(*request),
+                  request->destination)) {
+    delegate_->CancelWithError(net::ERR_BLOCKED_BY_CLIENT,
+                               "phlink-adblock");
+  }
+}
+
+void PhlinkAdblockThrottle::WillRedirectRequest(
+    net::RedirectInfo* redirect_info,
+    const network::mojom::URLResponseHead& /*response_head*/,
+    bool* /*defer*/,
+    std::vector<std::string>* /*to_be_removed_request_headers*/,
+    net::HttpRequestHeaders* /*modified_request_headers*/,
+    net::HttpRequestHeaders* /*modified_cors_exempt_request_headers*/) {
+  if (!engine_ || !redirect_info) {
+    return;
+  }
+  // We don't have the original ResourceRequest here, but
+  // RedirectInfo carries enough to re-evaluate the destination URL.
+  // Use the redirect's site_for_cookies as the source URL hint.
+  GURL source_url = redirect_info->new_site_for_cookies.RepresentativeUrl();
+  // RedirectInfo doesn't carry the destination type, so re-use the
+  // permissive default. The next WillStartRequest pass on the
+  // internally-restarted load will recheck with the precise type.
+  if (ShouldBlock(redirect_info->new_url, source_url,
+                  network::mojom::RequestDestination::kEmpty)) {
+    delegate_->CancelWithError(net::ERR_BLOCKED_BY_CLIENT,
+                               "phlink-adblock-redirect");
+  }
+}
+
+bool PhlinkAdblockThrottle::ShouldBlock(
+    const GURL& url,
+    const GURL& source_url,
+    network::mojom::RequestDestination destination) const {
+  if (!url.is_valid() || !url.SchemeIsHTTPOrHTTPS()) {
+    return false;
+  }
+  Engine::Decision decision = engine_->ShouldBlock(
+      url.spec(),
+      source_url.is_valid() ? std::string_view(source_url.spec())
+                            : std::string_view(),
+      DestinationToRequestType(destination));
+  if (!decision.matched) {
+    return false;
+  }
+  // adblock-rust returns matched=true even for exception hits; the
+  // exception field is non-empty in that case. Honor it as a pass.
+  if (!decision.exception.empty()) {
+    return false;
+  }
+  return true;
+}
+
+}  // namespace phlink::adblock
