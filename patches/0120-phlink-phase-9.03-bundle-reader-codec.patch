+// Copyright 2026 The phlink Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_PHLINK_PORTABILITY_BUNDLE_READER_H_
+#define CHROME_BROWSER_PHLINK_PORTABILITY_BUNDLE_READER_H_
+
+#include <array>
+#include <cstdint>
+#include <map>
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include "base/containers/span.h"
+#include "base/files/file_path.h"
+
+namespace phlink::portability {
+
+// Reader counterpart of BundleWriter. Verifies the phlink bundle header,
+// derives the AEAD key from the user passphrase, decrypts + decompresses the
+// payload, and exposes the tar entries by virtual path.
+//
+// Mirrors docs/dev/profile-bundle-format.md §6 / §7.
+class BundleReader {
+ public:
+  // Mirrors §7 of the format spec.
+  enum class Status {
+    kOk,
+    kBadMagic,
+    kUnsupportedVersion,
+    kUnknownPrimitive,
+    kBadPassphrase,
+    kIntegrity,
+    kTruncated,
+    kIo,
+  };
+
+  BundleReader();
+  ~BundleReader();
+
+  BundleReader(const BundleReader&) = delete;
+  BundleReader& operator=(const BundleReader&) = delete;
+
+  // Loads + decrypts the bundle bytes. Must be called once before any of the
+  // accessors below.
+  Status Open(base::span<const uint8_t> bundle_bytes,
+              std::string_view passphrase);
+
+  // Convenience: read `path` from disk into memory and call `Open`.
+  Status OpenFile(const base::FilePath& path, std::string_view passphrase);
+
+  // Returns the parsed `MANIFEST.json` bytes. Empty until Open succeeds.
+  base::span<const uint8_t> Manifest() const { return manifest_; }
+
+  // Returns the tar entries by path (excluding `MANIFEST.json`).
+  const std::map<std::string, std::vector<uint8_t>>& Entries() const {
+    return entries_;
+  }
+
+  // Highest format_version this reader can decode.
+  static constexpr uint16_t kSupportedMaxFormatVersion = 1;
+
+ private:
+  // Parses the inner ustar archive into manifest_ + entries_.
+  Status ParseTar(base::span<const uint8_t> tar);
+
+  std::vector<uint8_t> manifest_;
+  std::map<std::string, std::vector<uint8_t>> entries_;
+};
+
+}  // namespace phlink::portability
+
+#endif  // CHROME_BROWSER_PHLINK_PORTABILITY_BUNDLE_READER_H_
diff --git a/chrome/browser/phlink/portability/bundle_reader_unittest.cc b/chrome/browser/phlink/portability/bundle_reader_unittest.cc
new file mode 100644
index 0000000000000..78e1c83c8cb16
--- /dev/null
+++ b/chrome/browser/phlink/portability/bundle_reader_unittest.cc
@@ -0,0 +1,108 @@
+// Copyright 2026 The phlink Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/phlink/portability/bundle_reader.h"
+
+#include <string>
+#include <vector>
+
+#include "chrome/browser/phlink/portability/bundle_writer.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace phlink::portability {
+namespace {
+
+base::span<const uint8_t> StringSpan(const std::string& s) {
+  return base::span<const uint8_t>(
+      reinterpret_cast<const uint8_t*>(s.data()), s.size());
+}
+
+TEST(BundleReaderTest, RoundTripWriterReader) {
+  BundleWriter writer;
+  std::string a = "alpha bytes";
+  std::string b = R"({"theme":"dark"})";
+  ASSERT_TRUE(writer.AddFile("Bookmarks", StringSpan(a)));
+  ASSERT_TRUE(writer.AddFile("Preferences", StringSpan(b)));
+
+  std::string passphrase = "correct horse battery staple";
+  std::vector<uint8_t> bundle = writer.WriteToBytes(passphrase);
+  ASSERT_FALSE(bundle.empty());
+
+  BundleReader reader;
+  ASSERT_EQ(reader.Open(bundle, passphrase), BundleReader::Status::kOk);
+
+  // Manifest non-empty and JSON-ish.
+  ASSERT_FALSE(reader.Manifest().empty());
+
+  const auto& entries = reader.Entries();
+  ASSERT_EQ(entries.size(), 2u);
+  ASSERT_TRUE(entries.count("Bookmarks"));
+  ASSERT_TRUE(entries.count("Preferences"));
+
+  std::string got_a(entries.at("Bookmarks").begin(),
+                    entries.at("Bookmarks").end());
+  std::string got_b(entries.at("Preferences").begin(),
+                    entries.at("Preferences").end());
+  EXPECT_EQ(got_a, a);
+  EXPECT_EQ(got_b, b);
+}
+
+TEST(BundleReaderTest, BadMagicRejected) {
+  std::vector<uint8_t> bytes(128, 0);
+  bytes[0] = 'X';
+  BundleReader reader;
+  EXPECT_EQ(reader.Open(bytes, "x"), BundleReader::Status::kBadMagic);
+}
+
+TEST(BundleReaderTest, TruncatedRejected) {
+  BundleWriter writer;
+  std::string s = "x";
+  ASSERT_TRUE(writer.AddFile("Bookmarks", StringSpan(s)));
+  std::vector<uint8_t> bundle = writer.WriteToBytes("pw");
+  ASSERT_FALSE(bundle.empty());
+  bundle.pop_back();  // chop the last tag byte
+  BundleReader reader;
+  EXPECT_EQ(reader.Open(bundle, "pw"), BundleReader::Status::kTruncated);
+}
+
+TEST(BundleReaderTest, WrongPassphraseRejected) {
+  BundleWriter writer;
+  std::string s = "secret";
+  ASSERT_TRUE(writer.AddFile("Bookmarks", StringSpan(s)));
+  std::vector<uint8_t> bundle = writer.WriteToBytes("right");
+  ASSERT_FALSE(bundle.empty());
+  BundleReader reader;
+  EXPECT_EQ(reader.Open(bundle, "wrong"),
+            BundleReader::Status::kBadPassphrase);
+}
+
+TEST(BundleReaderTest, UnsupportedVersionRejected) {
+  BundleWriter writer;
+  std::string s = "x";
+  ASSERT_TRUE(writer.AddFile("Bookmarks", StringSpan(s)));
+  std::vector<uint8_t> bundle = writer.WriteToBytes("pw");
+  ASSERT_FALSE(bundle.empty());
+  // Bump format_version (offset 4..6).
+  bundle[4] = 0x99;
+  bundle[5] = 0x00;
+  BundleReader reader;
+  EXPECT_EQ(reader.Open(bundle, "pw"),
+            BundleReader::Status::kUnsupportedVersion);
+}
+
+TEST(BundleReaderTest, TamperedCiphertextRejected) {
+  BundleWriter writer;
+  std::string s = "x";
+  ASSERT_TRUE(writer.AddFile("Bookmarks", StringSpan(s)));
+  std::vector<uint8_t> bundle = writer.WriteToBytes("pw");
+  ASSERT_FALSE(bundle.empty());
+  // Flip a bit inside the ciphertext.
+  bundle[0x45] ^= 0x01;
+  BundleReader reader;
+  EXPECT_EQ(reader.Open(bundle, "pw"),
+            BundleReader::Status::kBadPassphrase);  // AEAD tag check fails
+}
+
+}  // namespace
+}  // namespace phlink::portability
