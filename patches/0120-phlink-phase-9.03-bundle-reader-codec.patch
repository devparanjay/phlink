diff --git a/chrome/browser/phlink/portability/bundle_reader.cc b/chrome/browser/phlink/portability/bundle_reader.cc
new file mode 100644
index 0000000000000..da5496ea8476f
--- /dev/null
+++ b/chrome/browser/phlink/portability/bundle_reader.cc
@@ -0,0 +1,200 @@
+// Copyright 2026 The phlink Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/phlink/portability/bundle_reader.h"
+
+#include <array>
+#include <cstring>
+#include <optional>
+#include <string>
+#include <vector>
+
+#include "base/files/file_util.h"
+#include "chrome/browser/phlink/portability/phlink_crypto.h"
+#include "third_party/zstd/src/lib/zstd.h"
+
+namespace phlink::portability {
+
+namespace {
+
+constexpr size_t kHeaderLen = 0x45;  // 69 bytes — see profile-bundle-format.md.
+constexpr size_t kSaltLen = 16;
+constexpr size_t kNonceLen = 24;
+constexpr size_t kTagLen = 16;
+
+template <typename T>
+T ReadLE(base::span<const uint8_t> buf, size_t off) {
+  T v = 0;
+  for (size_t i = 0; i < sizeof(T); ++i) {
+    v |= static_cast<T>(buf[off + i]) << (8 * i);
+  }
+  return v;
+}
+
+// Parses an octal NUL/space-padded ustar field of length `len`.
+std::optional<uint64_t> ParseOctal(base::span<const uint8_t> field) {
+  uint64_t v = 0;
+  for (uint8_t c : field) {
+    if (c == 0 || c == ' ') {
+      break;
+    }
+    if (c < '0' || c > '7') {
+      return std::nullopt;
+    }
+    v = (v << 3) | static_cast<uint64_t>(c - '0');
+  }
+  return v;
+}
+
+}  // namespace
+
+BundleReader::BundleReader() = default;
+BundleReader::~BundleReader() = default;
+
+BundleReader::Status BundleReader::Open(
+    base::span<const uint8_t> bundle_bytes, std::string_view passphrase) {
+  // 1. Header presence + magic.
+  if (bundle_bytes.size() < kHeaderLen + kTagLen) {
+    return Status::kTruncated;
+  }
+  if (bundle_bytes[0] != 'P' || bundle_bytes[1] != 'H' ||
+      bundle_bytes[2] != 'L' || bundle_bytes[3] != 'B') {
+    return Status::kBadMagic;
+  }
+
+  // 2. Version + primitive ids.
+  uint16_t version = ReadLE<uint16_t>(bundle_bytes, 4);
+  if (version > kSupportedMaxFormatVersion) {
+    return Status::kUnsupportedVersion;
+  }
+  uint8_t kdf_id = bundle_bytes[6];
+  uint8_t aead_id = bundle_bytes[7];
+  if (kdf_id != 1 || aead_id != 1) {
+    return Status::kUnknownPrimitive;
+  }
+
+  // 3. KDF params.
+  KdfParams params{
+      .m_kib = ReadLE<uint32_t>(bundle_bytes, 8),
+      .t = ReadLE<uint32_t>(bundle_bytes, 12),
+      .p = ReadLE<uint32_t>(bundle_bytes, 16),
+  };
+
+  // 4. Salt + nonce.
+  uint8_t salt_len = bundle_bytes[20];
+  if (salt_len != kSaltLen) {
+    return Status::kUnknownPrimitive;
+  }
+  base::span<const uint8_t> header = bundle_bytes.first(kHeaderLen);
+  base::span<const uint8_t> salt = header.subspan(21u, kSaltLen);
+  base::span<const uint8_t> nonce = header.subspan(37u, kNonceLen);
+
+  // 5. Payload length sanity.
+  uint64_t payload_len = ReadLE<uint64_t>(bundle_bytes, 0x3D);
+  if (bundle_bytes.size() != kHeaderLen + payload_len + kTagLen) {
+    return Status::kTruncated;
+  }
+  base::span<const uint8_t> ct_and_tag = bundle_bytes.subspan(kHeaderLen);
+
+  // 6. KDF.
+  base::span<const uint8_t> pw_span(
+      reinterpret_cast<const uint8_t*>(passphrase.data()), passphrase.size());
+  auto key = DeriveKey(pw_span, salt, params);
+  if (!key.has_value()) {
+    return Status::kUnknownPrimitive;
+  }
+
+  // 7. AEAD open.
+  auto plaintext = AeadOpen(*key, nonce, header, ct_and_tag);
+  if (!plaintext.has_value()) {
+    return Status::kBadPassphrase;
+  }
+
+  // 8. zstd-decompress.
+  unsigned long long expected =
+      ZSTD_getFrameContentSize(plaintext->data(), plaintext->size());
+  if (expected == ZSTD_CONTENTSIZE_ERROR ||
+      expected == ZSTD_CONTENTSIZE_UNKNOWN) {
+    return Status::kIntegrity;
+  }
+  std::vector<uint8_t> tar(static_cast<size_t>(expected));
+  size_t got = ZSTD_decompress(tar.data(), tar.size(), plaintext->data(),
+                               plaintext->size());
+  if (ZSTD_isError(got) || got != tar.size()) {
+    return Status::kIntegrity;
+  }
+
+  // 9. Parse ustar.
+  return ParseTar(tar);
+}
+
+BundleReader::Status BundleReader::OpenFile(const base::FilePath& path,
+                                            std::string_view passphrase) {
+  std::string buf;
+  if (!base::ReadFileToString(path, &buf)) {
+    return Status::kIo;
+  }
+  base::span<const uint8_t> bytes(
+      reinterpret_cast<const uint8_t*>(buf.data()), buf.size());
+  return Open(bytes, passphrase);
+}
+
+BundleReader::Status BundleReader::ParseTar(base::span<const uint8_t> tar) {
+  size_t off = 0;
+  while (off + 512 <= tar.size()) {
+    base::span<const uint8_t> hdr = tar.subspan(off, 512u);
+
+    // Two consecutive zero blocks terminate the archive.
+    bool all_zero = true;
+    for (uint8_t b : hdr) {
+      if (b != 0) {
+        all_zero = false;
+        break;
+      }
+    }
+    if (all_zero) {
+      break;
+    }
+
+    // ustar magic at offset 257.
+    if (std::memcmp(hdr.data() + 257, "ustar", 5) != 0) {
+      return Status::kIntegrity;
+    }
+
+    // name [0..100). NUL-terminated.
+    size_t name_len = 0;
+    while (name_len < 100 && hdr[name_len] != 0) {
+      ++name_len;
+    }
+    std::string name(reinterpret_cast<const char*>(hdr.data()), name_len);
+
+    // size [124..136), 12-byte octal.
+    auto size_opt = ParseOctal(hdr.subspan(124u, 12u));
+    if (!size_opt.has_value()) {
+      return Status::kIntegrity;
+    }
+    uint64_t size = *size_opt;
+
+    off += 512;
+    if (off + size > tar.size()) {
+      return Status::kTruncated;
+    }
+    base::span<const uint8_t> contents = tar.subspan(off, size);
+    if (name == "MANIFEST.json") {
+      manifest_.assign(contents.begin(), contents.end());
+    } else {
+      entries_[name] = std::vector<uint8_t>(contents.begin(), contents.end());
+    }
+    off += size;
+    // pad to 512-byte boundary
+    size_t pad = (512 - (size % 512)) % 512;
+    off += pad;
+  }
+  if (manifest_.empty()) {
+    return Status::kIntegrity;
+  }
+  return Status::kOk;
+}
+
+}  // namespace phlink::portability
