index 0000000000000..24f07f3ee641b
--- /dev/null
+++ b/chrome/browser/phlink/updater/metadata_fetcher.cc
@@ -0,0 +1,158 @@
+// Copyright 2026 The phlink Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/phlink/updater/metadata_fetcher.h"
+
+#include <utility>
+
+#include "base/check.h"
+#include "base/containers/span.h"
+#include "base/functional/bind.h"
+#include "net/base/load_flags.h"
+#include "net/traffic_annotation/network_traffic_annotation.h"
+#include "services/network/public/cpp/resource_request.h"
+#include "services/network/public/cpp/shared_url_loader_factory.h"
+#include "services/network/public/cpp/simple_url_loader.h"
+
+namespace phlink::updater {
+namespace {
+
+// TUF metadata files are tiny (timestamp.json ~ 500 B, snapshot.json
+// usually < 8 KiB, targets.json a few KiB per channel). Cap at 1 MiB so a
+// hostile server can't pin renderer/browser memory.
+constexpr size_t kMaxMetadataBytes = 1 * 1024 * 1024;
+
+constexpr net::NetworkTrafficAnnotationTag kTrafficAnnotation =
+    net::DefineNetworkTrafficAnnotation("phlink_updater_metadata", R"(
+        semantics {
+          sender: "phlink updater"
+          description:
+            "Fetches signed TUF metadata (timestamp.json, snapshot.json, "
+            "targets.json) describing the latest available phlink update. "
+            "Initiated by the browser process on a 24h +/- 6h jittered "
+            "schedule (and once ~5 minutes after startup). All metadata "
+            "is signed; phlink verifies signatures locally before acting "
+            "on it."
+          trigger:
+            "Periodic update check timer."
+          data:
+            "None. Only the metadata file URL is sent. No user identifiers, "
+            "cookies, or auth headers are attached."
+          destination: WEBSITE
+          internal {
+            contacts { email: "updates@phlink.dev" }
+          }
+          user_data { type: NONE }
+          last_reviewed: "2026-04-30"
+        }
+        policy {
+          cookies_allowed: NO
+          setting:
+            "Disable phlink's auto-update by toggling the 'Automatic "
+            "updates' setting under Settings > About phlink."
+          chrome_policy {}
+        })");
+
+const char* StageFile(MetadataFetcher::ResultCallback*) {
+  return "";  // unused; suppresses unused-warning artifact.
+}
+
+}  // namespace
+
+MetadataFetcher::MetadataFetcher(
+    scoped_refptr<network::SharedURLLoaderFactory> factory,
+    GURL base_url)
+    : factory_(std::move(factory)), base_url_(std::move(base_url)) {
+  CHECK(base_url_.is_valid());
+  CHECK(base_url_.spec().back() == '/')
+      << "MetadataFetcher base URL must end with '/'";
+}
+
+MetadataFetcher::~MetadataFetcher() = default;
+
+void MetadataFetcher::Fetch(TufClient* client, ResultCallback callback) {
+  CHECK(client);
+  CHECK(!client_) << "MetadataFetcher is one-shot";
+  client_ = client;
+  callback_ = std::move(callback);
+  StartStage(Stage::kTimestamp);
+}
+
+void MetadataFetcher::StartStage(Stage stage) {
+  const char* relative = nullptr;
+  switch (stage) {
+    case Stage::kTimestamp:
+      relative = "timestamp.json";
+      break;
+    case Stage::kSnapshot:
+      relative = "snapshot.json";
+      break;
+    case Stage::kTargets:
+      relative = "targets.json";
+      break;
+    case Stage::kDone:
+      Finish(TufError::kOk);
+      return;
+  }
+
+  auto request = std::make_unique<network::ResourceRequest>();
+  request->url = base_url_.Resolve(relative);
+  request->method = "GET";
+  // No cookies, no credentials. Strip referer.
+  request->credentials_mode = network::mojom::CredentialsMode::kOmit;
+  request->load_flags =
+      net::LOAD_DISABLE_CACHE | net::LOAD_BYPASS_CACHE | net::LOAD_DO_NOT_SAVE_COOKIES;
+
+  loader_ = network::SimpleURLLoader::Create(std::move(request),
+                                             kTrafficAnnotation);
+  loader_->DownloadToString(
+      factory_.get(),
+      base::BindOnce(&MetadataFetcher::OnDownloaded,
+                     weak_factory_.GetWeakPtr(), stage),
+      kMaxMetadataBytes);
+  // Suppress unused-symbol warning for the helper above (kept as a hook
+  // for future per-stage logging).
+  (void)StageFile;
+}
+
+void MetadataFetcher::OnDownloaded(Stage stage,
+                                   std::optional<std::string> body) {
+  if (!body.has_value()) {
+    Finish(TufError::kBadJson);  // network error -> treat as bad fetch.
+    return;
+  }
+  base::span<const uint8_t> bytes = base::as_byte_span(*body);
+  TufError err = TufError::kOk;
+  Stage next = Stage::kDone;
+  switch (stage) {
+    case Stage::kTimestamp:
+      err = client_->IngestTimestamp(bytes);
+      next = Stage::kSnapshot;
+      break;
+    case Stage::kSnapshot:
+      err = client_->IngestSnapshot(bytes);
+      next = Stage::kTargets;
+      break;
+    case Stage::kTargets:
+      err = client_->IngestTargets(bytes);
+      next = Stage::kDone;
+      break;
+    case Stage::kDone:
+      NOTREACHED();
+  }
+  if (err != TufError::kOk) {
+    Finish(err);
+    return;
+  }
+  StartStage(next);
+}
+
+void MetadataFetcher::Finish(TufError error) {
+  loader_.reset();
+  if (callback_) {
+    std::move(callback_).Run(error);
+  }
+}
+
+}  // namespace phlink::updater
