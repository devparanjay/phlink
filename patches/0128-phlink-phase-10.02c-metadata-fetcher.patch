+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_PHLINK_UPDATER_METADATA_FETCHER_H_
+#define CHROME_BROWSER_PHLINK_UPDATER_METADATA_FETCHER_H_
+
+#include <memory>
+#include <optional>
+#include <string>
+
+#include "base/functional/callback.h"
+#include "base/memory/raw_ptr.h"
+#include "base/memory/scoped_refptr.h"
+#include "base/memory/weak_ptr.h"
+#include "chrome/browser/phlink/updater/metadata_client.h"
+#include "url/gurl.h"
+
+namespace network {
+class SharedURLLoaderFactory;
+class SimpleURLLoader;
+}  // namespace network
+
+namespace phlink::updater {
+
+// Drives a TUF metadata fetch sequence over `network::SimpleURLLoader`:
+// `timestamp.json` -> `snapshot.json` -> `targets.json`. Each downloaded
+// blob is fed to the caller-owned `TufClient`, which performs the TUF
+// signature/expiry/version checks. This object only owns the network
+// plumbing.
+//
+// One-shot. Construct, call `Fetch`, await callback, drop.
+//
+// Out of scope (deferred to plan 10-02d):
+//   * payload (.zip) download.
+//   * staged.json persistence.
+//   * KeyedServiceFactory wiring on the system profile.
+class MetadataFetcher {
+ public:
+  using ResultCallback = base::OnceCallback<void(TufError)>;
+
+  // `base_url` is the directory under which `timestamp.json` etc. live.
+  // A trailing slash is required (asserted at construction).
+  MetadataFetcher(scoped_refptr<network::SharedURLLoaderFactory> factory,
+                  GURL base_url);
+  MetadataFetcher(const MetadataFetcher&) = delete;
+  MetadataFetcher& operator=(const MetadataFetcher&) = delete;
+  ~MetadataFetcher();
+
+  // Starts the fetch. `client` must outlive this `MetadataFetcher`. The
+  // result is reported asynchronously via `callback`. `Fetch` may be
+  // called at most once.
+  void Fetch(TufClient* client, ResultCallback callback);
+
+ private:
+  enum class Stage { kTimestamp, kSnapshot, kTargets, kDone };
+
+  void StartStage(Stage stage);
+  void OnDownloaded(Stage stage, std::optional<std::string> body);
+  void Finish(TufError error);
+
+  scoped_refptr<network::SharedURLLoaderFactory> factory_;
+  const GURL base_url_;
+  std::unique_ptr<network::SimpleURLLoader> loader_;
+  raw_ptr<TufClient> client_ = nullptr;
+  ResultCallback callback_;
+  base::WeakPtrFactory<MetadataFetcher> weak_factory_{this};
+};
+
+}  // namespace phlink::updater
+
+#endif  // CHROME_BROWSER_PHLINK_UPDATER_METADATA_FETCHER_H_
