+class MetadataFetcherTest : public ::testing::Test {
+ protected:
+  MetadataFetcherTest()
+      : shared_factory_(loader_factory_.GetSafeWeakWrapper()) {}
+
+  // Returns a TufClient with the trust root parsed and ready to ingest.
+  TufClient MakeClient(const TestKey& root_key) {
+    std::string root_json =
+        Envelope(BuildRootSigned(root_key, kFutureExpires), {&root_key});
+    auto client = TufClient::CreateWithRoot(Bytes(root_json), SomeNow());
+    CHECK(client.has_value());
+    return std::move(client).value();
+  }
+
+  // Primes the fake URL-loader factory with a valid metadata trio under
+  // `kBaseUrl`.
+  void SeedHappyPath(const TestKey& root_key) {
+    std::string snap_json =
+        Envelope(BuildSnapshotSigned(1, kFutureExpires, 1), {&root_key});
+    std::string ts_json = Envelope(
+        BuildTimestampSigned(1, kFutureExpires, 1, snap_json), {&root_key});
+    std::string tgt_json =
+        Envelope(BuildTargetsSigned(1, kFutureExpires), {&root_key});
+    loader_factory_.AddResponse(GURL("https://updates.example/timestamp.json"),
+                                /*head=*/network::mojom::URLResponseHead::New(),
+                                ts_json,
+                                network::URLLoaderCompletionStatus(net::OK));
+    loader_factory_.AddResponse(GURL("https://updates.example/snapshot.json"),
+                                network::mojom::URLResponseHead::New(),
+                                snap_json,
+                                network::URLLoaderCompletionStatus(net::OK));
+    loader_factory_.AddResponse(GURL("https://updates.example/targets.json"),
+                                network::mojom::URLResponseHead::New(),
+                                tgt_json,
+                                network::URLLoaderCompletionStatus(net::OK));
+  }
+
+  TufError RunFetch(TufClient* client) {
+    MetadataFetcher fetcher(shared_factory_,
+                            GURL("https://updates.example/"));
+    base::RunLoop run_loop;
+    TufError result = TufError::kOk;
+    fetcher.Fetch(client,
+                  base::BindLambdaForTesting([&](TufError err) {
+                    result = err;
+                    run_loop.Quit();
+                  }));
+    run_loop.Run();
+    return result;
+  }
+
+  base::test::TaskEnvironment task_env_;
+  network::TestURLLoaderFactory loader_factory_;
+  scoped_refptr<network::WeakWrapperSharedURLLoaderFactory> shared_factory_;
+};
+
+TEST_F(MetadataFetcherTest, HappyPathIngestsAllThreeRoles) {
+  TestKey root = MakeTestKey();
+  TufClient client = MakeClient(root);
+  SeedHappyPath(root);
+
+  EXPECT_EQ(TufError::kOk, RunFetch(&client));
+  EXPECT_EQ(client.timestamp_version(), 1u);
+  EXPECT_EQ(client.snapshot_version(), 1u);
+  EXPECT_EQ(client.targets_version(), 1u);
+  EXPECT_TRUE(client.LookupTarget("phlink-1.0.0-mac-arm64.zip").has_value());
+}
+
+TEST_F(MetadataFetcherTest, NetworkErrorOnTimestampPropagates) {
+  TestKey root = MakeTestKey();
+  TufClient client = MakeClient(root);
+  // Don't seed timestamp.json -- give it a 500 instead. snapshot/targets
+  // are irrelevant since the fetch should bail out at stage 1.
+  loader_factory_.AddResponse("https://updates.example/timestamp.json",
+                              /*content=*/"",
+                              net::HTTP_INTERNAL_SERVER_ERROR);
+
+  EXPECT_NE(TufError::kOk, RunFetch(&client));
+  EXPECT_EQ(client.timestamp_version(), 0u);
+}
+
+TEST_F(MetadataFetcherTest, BadJsonOnTimestampPropagates) {
+  TestKey root = MakeTestKey();
+  TufClient client = MakeClient(root);
+  loader_factory_.AddResponse("https://updates.example/timestamp.json",
+                              "{not valid json", net::HTTP_OK);
+
+  EXPECT_EQ(TufError::kBadJson, RunFetch(&client));
+  EXPECT_EQ(client.timestamp_version(), 0u);
+}
+
+}  // namespace
+}  // namespace phlink::updater
