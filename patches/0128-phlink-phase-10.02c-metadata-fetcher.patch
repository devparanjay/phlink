+
+#ifndef CHROME_BROWSER_PHLINK_UPDATER_METADATA_TEST_HELPERS_H_
+#define CHROME_BROWSER_PHLINK_UPDATER_METADATA_TEST_HELPERS_H_
+
+#include <array>
+#include <cstdint>
+#include <string>
+#include <vector>
+
+#include "base/containers/span.h"
+#include "base/values.h"
+#include "crypto/keypair.h"
+
+namespace phlink::updater::test_helpers {
+
+// A single Ed25519 keypair plus its TUF-style key_id.
+struct TestKey {
+  TestKey();
+  TestKey(crypto::keypair::PrivateKey priv,
+          std::array<uint8_t, 32> pub,
+          std::string id);
+  TestKey(const TestKey&);
+  TestKey(TestKey&&);
+  TestKey& operator=(const TestKey&);
+  TestKey& operator=(TestKey&&);
+  ~TestKey();
+
+  crypto::keypair::PrivateKey private_key;
+  std::array<uint8_t, 32> public_bytes{};
+  std::string keyid;
+};
+
+std::string ToHex(base::span<const uint8_t> bytes);
+TestKey MakeTestKey();
+
+// Wraps `signed_value` in a `{ signed, signatures }` envelope, signing it
+// with each of `signers`. Returns canonical-JSON of the outer envelope.
+std::string Envelope(const base::DictValue& signed_value,
+                     const std::vector<const TestKey*>& signers);
+
+base::DictValue BuildRootSigned(const TestKey& root_key,
+                                const std::string& expires);
+base::DictValue BuildTimestampSigned(int version,
+                                     const std::string& expires,
+                                     int snapshot_version,
+                                     const std::string& snapshot_bytes);
+base::DictValue BuildSnapshotSigned(int version,
+                                    const std::string& expires,
+                                    int targets_version);
+base::DictValue BuildTargetsSigned(int version, const std::string& expires);
+
+inline base::span<const uint8_t> Bytes(const std::string& s) {
+  return base::as_byte_span(s);
+}
+
+}  // namespace phlink::updater::test_helpers
+
+#endif  // CHROME_BROWSER_PHLINK_UPDATER_METADATA_TEST_HELPERS_H_
