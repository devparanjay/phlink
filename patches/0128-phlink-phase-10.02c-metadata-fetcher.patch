@@ -0,0 +1,178 @@
+// Copyright 2026 The phlink Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/phlink/updater/metadata_test_helpers.h"
+
+#include <utility>
+
+#include "base/strings/string_number_conversions.h"
+#include "base/strings/string_util.h"
+#include "chrome/browser/phlink/updater/canonical_json.h"
+#include "crypto/sign.h"
+#include "third_party/boringssl/src/include/openssl/sha.h"
+
+namespace phlink::updater::test_helpers {
+
+TestKey::TestKey()
+    : private_key(crypto::keypair::PrivateKey::GenerateEd25519()) {}
+
+TestKey::TestKey(crypto::keypair::PrivateKey priv,
+                 std::array<uint8_t, 32> pub,
+                 std::string id)
+    : private_key(std::move(priv)),
+      public_bytes(pub),
+      keyid(std::move(id)) {}
+
+TestKey::TestKey(const TestKey&) = default;
+TestKey::TestKey(TestKey&&) = default;
+TestKey& TestKey::operator=(const TestKey&) = default;
+TestKey& TestKey::operator=(TestKey&&) = default;
+TestKey::~TestKey() = default;
+
+std::string ToHex(base::span<const uint8_t> bytes) {
+  return base::ToLowerASCII(base::HexEncode(bytes));
+}
+
+TestKey MakeTestKey() {
+  crypto::keypair::PrivateKey priv =
+      crypto::keypair::PrivateKey::GenerateEd25519();
+  std::array<uint8_t, 32> pub = priv.ToEd25519PublicKey();
+
+  // Compute keyid = sha256(canonical_json({keytype, keyval{public}, scheme})).
+  base::DictValue keyval;
+  keyval.Set("public", ToHex(pub));
+  base::DictValue key_dict;
+  key_dict.Set("keytype", "ed25519");
+  key_dict.Set("keyval", std::move(keyval));
+  key_dict.Set("scheme", "ed25519");
+  base::Value v(std::move(key_dict));
+  std::string canonical = *EncodeCanonicalJson(v);
+
+  std::array<uint8_t, 32> hash{};
+  ::SHA256(reinterpret_cast<const uint8_t*>(canonical.data()),
+           canonical.size(), hash.data());
+
+  return TestKey(std::move(priv), pub, ToHex(hash));
+}
+
+std::string Envelope(const base::DictValue& signed_value,
+                     const std::vector<const TestKey*>& signers) {
+  base::Value v(signed_value.Clone());
+  std::string canonical = *EncodeCanonicalJson(v);
+  base::span<const uint8_t> message = base::as_byte_span(canonical);
+
+  base::ListValue sigs;
+  for (const TestKey* k : signers) {
+    std::vector<uint8_t> sig =
+        crypto::sign::Sign(crypto::sign::ED25519, k->private_key, message);
+    base::DictValue s;
+    s.Set("keyid", k->keyid);
+    s.Set("sig", ToHex(sig));
+    sigs.Append(std::move(s));
+  }
+
+  base::DictValue outer;
+  outer.Set("signed", signed_value.Clone());
+  outer.Set("signatures", std::move(sigs));
+  return *EncodeCanonicalJson(base::Value(std::move(outer)));
+}
+
+base::DictValue BuildRootSigned(const TestKey& root_key,
+                                const std::string& expires) {
+  base::DictValue keyval;
+  keyval.Set("public", ToHex(root_key.public_bytes));
+  base::DictValue key;
+  key.Set("keytype", "ed25519");
+  key.Set("keyval", std::move(keyval));
+  key.Set("scheme", "ed25519");
+  base::DictValue keys;
+  keys.Set(root_key.keyid, std::move(key));
+
+  auto make_role = [&]() {
+    base::ListValue ids;
+    ids.Append(root_key.keyid);
+    base::DictValue r;
+    r.Set("keyids", std::move(ids));
+    r.Set("threshold", 1);
+    return r;
+  };
+  base::DictValue roles;
+  roles.Set("root", make_role());
+  roles.Set("targets", make_role());
+  roles.Set("snapshot", make_role());
+  roles.Set("timestamp", make_role());
+
+  base::DictValue signed_dict;
+  signed_dict.Set("_type", "root");
+  signed_dict.Set("spec_version", "1.0.32");
+  signed_dict.Set("version", 1);
+  signed_dict.Set("expires", expires);
+  signed_dict.Set("consistent_snapshot", false);
+  signed_dict.Set("keys", std::move(keys));
+  signed_dict.Set("roles", std::move(roles));
+  return signed_dict;
+}
+
+base::DictValue BuildTimestampSigned(int version,
+                                     const std::string& expires,
+                                     int snapshot_version,
+                                     const std::string& snapshot_bytes) {
+  std::array<uint8_t, 32> sha{};
+  ::SHA256(reinterpret_cast<const uint8_t*>(snapshot_bytes.data()),
+           snapshot_bytes.size(), sha.data());
+  base::DictValue hashes;
+  hashes.Set("sha256", ToHex(sha));
+  base::DictValue snap_meta;
+  snap_meta.Set("version", snapshot_version);
+  snap_meta.Set("length", static_cast<int>(snapshot_bytes.size()));
+  snap_meta.Set("hashes", std::move(hashes));
+  base::DictValue meta;
+  meta.Set("snapshot.json", std::move(snap_meta));
+  base::DictValue s;
+  s.Set("_type", "timestamp");
+  s.Set("spec_version", "1.0.32");
+  s.Set("version", version);
+  s.Set("expires", expires);
+  s.Set("meta", std::move(meta));
+  return s;
+}
+
+base::DictValue BuildSnapshotSigned(int version,
+                                    const std::string& expires,
+                                    int targets_version) {
+  base::DictValue tgt_meta;
+  tgt_meta.Set("version", targets_version);
+  base::DictValue meta;
+  meta.Set("targets.json", std::move(tgt_meta));
+  base::DictValue s;
+  s.Set("_type", "snapshot");
+  s.Set("spec_version", "1.0.32");
+  s.Set("version", version);
+  s.Set("expires", expires);
+  s.Set("meta", std::move(meta));
+  return s;
+}
+
+base::DictValue BuildTargetsSigned(int version, const std::string& expires) {
+  std::array<uint8_t, 32> fake_sha{};
+  for (size_t i = 0; i < fake_sha.size(); ++i) {
+    fake_sha[i] = static_cast<uint8_t>(i);
+  }
+  base::DictValue hashes;
+  hashes.Set("sha256", ToHex(fake_sha));
+  base::DictValue tgt;
+  tgt.Set("length", 1024);
+  tgt.Set("hashes", std::move(hashes));
+  base::DictValue targets;
+  targets.Set("phlink-1.0.0-mac-arm64.zip", std::move(tgt));
+  base::DictValue s;
+  s.Set("_type", "targets");
+  s.Set("spec_version", "1.0.32");
+  s.Set("version", version);
+  s.Set("expires", expires);
+  s.Set("targets", std::move(targets));
+  return s;
+}
+
+}  // namespace phlink::updater::test_helpers
