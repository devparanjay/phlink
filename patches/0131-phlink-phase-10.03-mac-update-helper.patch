+// Copyright 2026 The phlink Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/phlink/updater/mac/update_helper_apply.h"
+
+#include <string>
+
+#include "base/files/file_path.h"
+#include "base/files/file_util.h"
+#include "base/files/scoped_temp_dir.h"
+#include "base/time/time.h"
+#include "chrome/browser/phlink/updater/staged_payload.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace phlink::updater::mac {
+namespace {
+
+class UpdateHelperApplyTest : public ::testing::Test {
+ protected:
+  void SetUp() override { ASSERT_TRUE(temp_.CreateUniqueTempDir()); }
+  base::FilePath path() const { return temp_.GetPath(); }
+  base::ScopedTempDir temp_;
+};
+
+TEST_F(UpdateHelperApplyTest, BadArgumentsRejected) {
+  ApplyOptions opts;
+  EXPECT_EQ(ApplyResult::kBadArguments, Apply(opts));
+}
+
+TEST_F(UpdateHelperApplyTest, MissingStagedJsonReturnsKStagedJsonMissing) {
+  ApplyOptions opts;
+  opts.staging_dir = path();
+  opts.target_app_path = path().AppendASCII("Phlink.app");
+  EXPECT_EQ(ApplyResult::kStagedJsonMissing, Apply(opts));
+}
+
+TEST_F(UpdateHelperApplyTest, MissingPayloadReturnsKPayloadMissing) {
+  // Write a valid staged.json that points at a path that doesn't exist.
+  StagedPayload sp;
+  sp.version = "1.2.3";
+  sp.payload_path = path().AppendASCII("payload.zip");  // not created
+  sp.verified_at = base::Time::Now();
+  ASSERT_TRUE(WriteStagedPayloadJson(path(), sp));
+
+  ApplyOptions opts;
+  opts.staging_dir = path();
+  opts.target_app_path = path().AppendASCII("Phlink.app");
+  opts.allow_adhoc = true;
+  opts.skip_signature_check = true;
+  EXPECT_EQ(ApplyResult::kPayloadMissing, Apply(opts));
+}
+
+TEST_F(UpdateHelperApplyTest, SwapAppDirectoriesSwapsContents) {
+  base::FilePath a = path().AppendASCII("a");
+  base::FilePath b = path().AppendASCII("b");
+  ASSERT_TRUE(base::CreateDirectory(a));
+  ASSERT_TRUE(base::CreateDirectory(b));
+  ASSERT_TRUE(base::WriteFile(a.AppendASCII("marker"), "from-a"));
+  ASSERT_TRUE(base::WriteFile(b.AppendASCII("marker"), "from-b"));
+
+  ASSERT_TRUE(SwapAppDirectories(a, b));
+
+  std::string contents;
+  ASSERT_TRUE(base::ReadFileToString(a.AppendASCII("marker"), &contents));
+  EXPECT_EQ("from-b", contents);
+  contents.clear();
+  ASSERT_TRUE(base::ReadFileToString(b.AppendASCII("marker"), &contents));
+  EXPECT_EQ("from-a", contents);
+}
+
+}  // namespace
+}  // namespace phlink::updater::mac
