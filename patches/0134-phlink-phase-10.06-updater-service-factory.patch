diff --git a/chrome/browser/phlink/updater/updater_service_factory.cc b/chrome/browser/phlink/updater/updater_service_factory.cc
new file mode 100644
index 0000000000000..4679c85e6de3a
--- /dev/null
+++ b/chrome/browser/phlink/updater/updater_service_factory.cc
@@ -0,0 +1,89 @@
+// Copyright 2026 The phlink Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/phlink/updater/updater_service_factory.h"
+
+#include "base/functional/bind.h"
+#include "base/logging.h"
+#include "base/no_destructor.h"
+#include "chrome/browser/browser_process.h"
+#include "chrome/browser/phlink/updater/updater_service.h"
+#include "chrome/browser/profiles/profile.h"
+#include "components/prefs/pref_service.h"
+
+namespace phlink::updater {
+
+namespace {
+
+// No-op production CheckCallback. Phase 10-06b will replace this with
+// `UpdateCheckPipeline::Run` once the settings WebUI handler is in
+// place; the pipeline + helpers already exist (10-02e / 10-03 / 04 /
+// 05) but binding them at factory time would require a profile-scoped
+// SharedURLLoaderFactory and trust-pinned root.json which we don't
+// want to plumb until there's a user-visible "Check for updates"
+// button.
+void NoopCheck() {
+  VLOG(1) << "phlink updater: scheduled tick (no-op stub).";
+}
+
+}  // namespace
+
+// static
+UpdaterService* UpdaterServiceFactory::GetForProfile(Profile* profile) {
+  return static_cast<UpdaterService*>(
+      GetInstance()->GetServiceForBrowserContext(profile, /*create=*/true));
+}
+
+// static
+UpdaterServiceFactory* UpdaterServiceFactory::GetInstance() {
+  static base::NoDestructor<UpdaterServiceFactory> instance;
+  return instance.get();
+}
+
+// static
+void UpdaterServiceFactory::EnsureFactoryBuilt() {
+  GetInstance();
+}
+
+UpdaterServiceFactory::UpdaterServiceFactory()
+    : ProfileKeyedServiceFactory(
+          "PhlinkUpdaterService",
+          ProfileSelections::Builder()
+              .WithRegular(ProfileSelection::kOriginalOnly)
+              .WithGuest(ProfileSelection::kNone)
+              .WithSystem(ProfileSelection::kNone)
+              .WithAshInternals(ProfileSelection::kNone)
+              .Build()) {}
+
+UpdaterServiceFactory::~UpdaterServiceFactory() = default;
+
+std::unique_ptr<KeyedService>
+UpdaterServiceFactory::BuildServiceInstanceForBrowserContext(
+    content::BrowserContext* context) const {
+  PrefService* local_state = g_browser_process->local_state();
+  if (!local_state) {
+    return nullptr;
+  }
+  auto service = std::make_unique<UpdaterService>(
+      local_state, base::BindRepeating(&NoopCheck));
+  service->Start();
+  return service;
+}
+
+void UpdaterServiceFactory::RegisterProfilePrefs(
+    user_prefs::PrefRegistrySyncable* registry) {
+  // Updater prefs live in local state, not profile prefs; nothing to
+  // register here. Local-state registration happens in
+  // ChromeBrowserMainExtraPartsProfiles via UpdaterService::RegisterPrefs
+  // (deferred to 10-06b).
+}
+
+bool UpdaterServiceFactory::ServiceIsCreatedWithBrowserContext() const {
+  // Lazy: only built when GetForProfile() is called. The settings WebUI
+  // handler will trigger that the first time a user opens the Help
+  // page.
+  return false;
+}
+
+}  // namespace phlink::updater
diff --git a/chrome/browser/phlink/updater/updater_service_factory.h b/chrome/browser/phlink/updater/updater_service_factory.h
new file mode 100644
index 0000000000000..a89d23d01a3ae
--- /dev/null
+++ b/chrome/browser/phlink/updater/updater_service_factory.h
@@ -0,0 +1,53 @@
+// Copyright 2026 The phlink Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_PHLINK_UPDATER_UPDATER_SERVICE_FACTORY_H_
+#define CHROME_BROWSER_PHLINK_UPDATER_UPDATER_SERVICE_FACTORY_H_
+
+#include "base/no_destructor.h"
+#include "chrome/browser/profiles/profile_keyed_service_factory.h"
+
+class Profile;
+
+namespace phlink::updater {
+
+class UpdaterService;
+
+// One UpdaterService per regular Profile. Off-the-record / Guest /
+// System profiles get nullptr (we never run an updater on them).
+//
+// The factory is *not* registered from
+// chrome_browser_main_extra_parts_profiles.cc on purpose -- that file
+// is huge and rebase-fragile. Callers that need the service (e.g. the
+// future settings WebUI handler) must call EnsureFactoryBuilt() once
+// per process before GetForProfile().
+class UpdaterServiceFactory : public ProfileKeyedServiceFactory {
+ public:
+  static UpdaterService* GetForProfile(Profile* profile);
+  static UpdaterServiceFactory* GetInstance();
+
+  // Idempotent: forces the factory to be created so that profile
+  // teardown will clean it up. Tests call this in SetUp().
+  static void EnsureFactoryBuilt();
+
+  UpdaterServiceFactory(const UpdaterServiceFactory&) = delete;
+  UpdaterServiceFactory& operator=(const UpdaterServiceFactory&) = delete;
+
+ private:
+  friend class base::NoDestructor<UpdaterServiceFactory>;
+
+  UpdaterServiceFactory();
+  ~UpdaterServiceFactory() override;
+
+  // BrowserContextKeyedServiceFactory:
+  std::unique_ptr<KeyedService> BuildServiceInstanceForBrowserContext(
+      content::BrowserContext* context) const override;
+  void RegisterProfilePrefs(
+      user_prefs::PrefRegistrySyncable* registry) override;
+  bool ServiceIsCreatedWithBrowserContext() const override;
+};
+
+}  // namespace phlink::updater
+
+#endif  // CHROME_BROWSER_PHLINK_UPDATER_UPDATER_SERVICE_FACTORY_H_
diff --git a/chrome/browser/phlink/updater/updater_service_factory_unittest.cc b/chrome/browser/phlink/updater/updater_service_factory_unittest.cc
new file mode 100644
index 0000000000000..b68495a6701bd
--- /dev/null
+++ b/chrome/browser/phlink/updater/updater_service_factory_unittest.cc
@@ -0,0 +1,31 @@
+// Copyright 2026 The phlink Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/phlink/updater/updater_service_factory.h"
+
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace phlink::updater {
+namespace {
+
+// Smoke test: the factory can be obtained, is a singleton, and
+// EnsureFactoryBuilt is idempotent. Profile-keyed behavior (regular
+// vs OTR vs guest) is enforced by ProfileKeyedServiceFactory itself
+// and is exercised by Chromium's own keyed-service tests; we don't
+// duplicate them here to keep the unit-test target standalone (no
+// TestingProfile dependency).
+TEST(UpdaterServiceFactoryTest, IsSingleton) {
+  auto* a = UpdaterServiceFactory::GetInstance();
+  auto* b = UpdaterServiceFactory::GetInstance();
+  EXPECT_EQ(a, b);
+}
+
+TEST(UpdaterServiceFactoryTest, EnsureFactoryBuiltIsIdempotent) {
+  UpdaterServiceFactory::EnsureFactoryBuilt();
+  UpdaterServiceFactory::EnsureFactoryBuilt();
+  EXPECT_NE(nullptr, UpdaterServiceFactory::GetInstance());
+}
+
+}  // namespace
+}  // namespace phlink::updater
