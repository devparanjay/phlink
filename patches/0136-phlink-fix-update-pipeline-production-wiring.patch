+std::vector<uint8_t> ReadTrustRoot() {
+  base::FilePath exe_dir;
+  if (!base::PathService::Get(base::DIR_EXE, &exe_dir)) {
+    return {};
+  }
+  const base::FilePath root_paths[] = {
+      exe_dir.AppendASCII("resources")
+          .AppendASCII("phlink")
+          .AppendASCII("keys")
+          .AppendASCII("root.json"),
+      exe_dir.DirName()
+          .AppendASCII("Resources")
+          .AppendASCII("phlink")
+          .AppendASCII("keys")
+          .AppendASCII("root.json"),
+  };
+  for (const base::FilePath& root_path : root_paths) {
+    std::string root_json;
+    if (base::ReadFileToString(root_path, &root_json)) {
+      return std::vector<uint8_t>(root_json.begin(), root_json.end());
+    }
+  }
+  LOG(ERROR) << "phlink updater: trust root missing near " << exe_dir;
+  return {};
