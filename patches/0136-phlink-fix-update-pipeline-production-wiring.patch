+TEST(TufClientTest, ParsesDottedVersionTargetFromFilename) {
+  TestKey root = MakeTestKey();
+  std::string root_json =
+      Envelope(BuildRootSigned(root, kFutureExpires), {&root});
+  auto client = TufClient::CreateWithRoot(Bytes(root_json), SomeNow());
+  ASSERT_TRUE(client.has_value());
+
+  std::array<uint8_t, 32> sha{};
+  std::string tgt_json =
+      Envelope(test_helpers::BuildTargetsSignedWithEntry(
+                   1, kFutureExpires, "phlink-0.1.0-mac-arm64.zip", 1024, sha),
+               {&root});
+  std::string snap_json =
+      Envelope(BuildSnapshotSigned(1, kFutureExpires, 1, tgt_json), {&root});
+  std::string ts_json =
+      Envelope(BuildTimestampSigned(1, kFutureExpires, 1, snap_json), {&root});
+
+  ASSERT_EQ(TufError::kOk, client->IngestTimestamp(Bytes(ts_json)));
+  ASSERT_EQ(TufError::kOk, client->IngestSnapshot(Bytes(snap_json)));
+  ASSERT_EQ(TufError::kOk, client->IngestTargets(Bytes(tgt_json)));
+
+  std::optional<TargetMeta> target =
+      client->FindLatestTarget("mac", "arm64", "stable");
+  ASSERT_TRUE(target.has_value());
+  EXPECT_EQ(target->version, "0.1.0");
+  EXPECT_EQ(target->platform, "mac");
+  EXPECT_EQ(target->arch, "arm64");
+}
+
+TEST(TufClientTest, ParsesExtensionlessLinuxUpdateTargetFromFilename) {
+  TestKey root = MakeTestKey();
+  std::string root_json =
+      Envelope(BuildRootSigned(root, kFutureExpires), {&root});
+  auto client = TufClient::CreateWithRoot(Bytes(root_json), SomeNow());
+  ASSERT_TRUE(client.has_value());
+
+  std::array<uint8_t, 32> sha{};
+  std::string tgt_json = Envelope(
+      test_helpers::BuildTargetsSignedWithEntry(
+          1, kFutureExpires, "phlink-0.1.0-linux-x86_64-update", 1024, sha),
+      {&root});
+  std::string snap_json =
+      Envelope(BuildSnapshotSigned(1, kFutureExpires, 1, tgt_json), {&root});
+  std::string ts_json =
+      Envelope(BuildTimestampSigned(1, kFutureExpires, 1, snap_json), {&root});
+
+  ASSERT_EQ(TufError::kOk, client->IngestTimestamp(Bytes(ts_json)));
+  ASSERT_EQ(TufError::kOk, client->IngestSnapshot(Bytes(snap_json)));
+  ASSERT_EQ(TufError::kOk, client->IngestTargets(Bytes(tgt_json)));
+
+  std::optional<TargetMeta> target =
+      client->FindLatestTarget("linux", "x86_64", "stable");
+  ASSERT_TRUE(target.has_value());
+  EXPECT_EQ(target->version, "0.1.0");
+  EXPECT_EQ(target->platform, "linux");
+  EXPECT_EQ(target->arch, "x86_64");
+}
+
+TEST(TufClientTest, RejectsTargetsBytesNotPinnedBySnapshot) {
+  TestKey root = MakeTestKey();
+  std::string root_json =
+      Envelope(BuildRootSigned(root, kFutureExpires), {&root});
+  auto client = TufClient::CreateWithRoot(Bytes(root_json), SomeNow());
+  ASSERT_TRUE(client.has_value());
+
+  std::array<uint8_t, 32> sha{};
+  std::string pinned_tgt_json =
+      Envelope(test_helpers::BuildTargetsSignedWithEntry(
+                   1, kFutureExpires, "phlink-0.1.0-mac-arm64.zip", 1024, sha),
+               {&root});
+  std::string served_tgt_json =
+      Envelope(test_helpers::BuildTargetsSignedWithEntry(
+                   1, kFutureExpires, "phlink-0.2.0-mac-arm64.zip", 1024, sha),
+               {&root});
+  std::string snap_json = Envelope(
+      BuildSnapshotSigned(1, kFutureExpires, 1, pinned_tgt_json), {&root});
+  std::string ts_json =
+      Envelope(BuildTimestampSigned(1, kFutureExpires, 1, snap_json), {&root});
+
+  ASSERT_EQ(TufError::kOk, client->IngestTimestamp(Bytes(ts_json)));
