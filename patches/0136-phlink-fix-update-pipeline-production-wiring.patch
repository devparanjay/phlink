 #include "crypto/keypair.h"
 #include "crypto/sign.h"
@@ -53,6 +55,37 @@ bool ParseUint64(const base::Value& v, uint64_t* out) {
   return true;
 }

+void FillTargetFieldsFromName(std::string_view name, TargetMeta* target) {
+  std::string base_name(name);
+  constexpr std::string_view kSuffixes[] = {
+      ".AppImage", ".deb", ".dmg", ".exe", ".rpm", ".zip", "-update"};
+  bool stripped = true;
+  while (stripped) {
+    stripped = false;
+    for (std::string_view suffix : kSuffixes) {
+      if (base::EndsWith(base_name, suffix, base::CompareCase::SENSITIVE)) {
+        base_name.resize(base_name.size() - suffix.size());
+        stripped = true;
+        break;
+      }
+    }
+  }
+  std::vector<std::string> parts = base::SplitString(
+      base_name, "-", base::TRIM_WHITESPACE, base::SPLIT_WANT_NONEMPTY);
+  if (parts.size() < 4 || parts[0] != "phlink") {
+    return;
+  }
+  if (target->version.empty()) {
+    target->version = parts[1];
+  }
+  if (target->platform.empty()) {
+    target->platform = parts[2];
+  }
+  if (target->arch.empty()) {
+    target->arch = parts[3];
+  }
+}
+
 }  // namespace

