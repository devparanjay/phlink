-    if (!crypto::sign::Verify(crypto::sign::ED25519, pub, message,
-                              sig_bytes)) {
+    if (!crypto::sign::Verify(crypto::sign::ED25519, pub, message, sig_bytes)) {
       return TufError::kBadSignature;
     }
     valid_keyids.insert(*keyid);
@@ -415,14 +446,26 @@ TufError TufClient::IngestSnapshot(base::span<const uint8_t> json_bytes) {
     return TufError::kMissingField;
   }
   const base::Value* tgt_version_v = tgt_meta->Find("version");
-  if (!tgt_version_v) {
+  std::optional<int> tgt_length = tgt_meta->FindInt("length");
+  const base::DictValue* tgt_hashes = tgt_meta->FindDict("hashes");
+  if (!tgt_version_v || !tgt_length || *tgt_length < 0 || !tgt_hashes) {
     return TufError::kMissingField;
   }
   uint64_t tv = 0;
   if (!ParseUint64(*tgt_version_v, &tv)) {
     return TufError::kBadJson;
   }
+  const std::string* sha256_hex = tgt_hashes->FindString("sha256");
+  if (!sha256_hex) {
+    return TufError::kMissingField;
+  }
+  std::array<uint8_t, kSha256Len> sha{};
+  if (!DecodeHexFixed(*sha256_hex, sha)) {
+    return TufError::kBadJson;
+  }
   expected_targets_version_ = tv;
+  expected_targets_length_ = static_cast<uint64_t>(*tgt_length);
+  expected_targets_sha256_ = sha;
   targets_pin_set_ = true;
   return TufError::kOk;
 }
@@ -431,6 +474,14 @@ TufError TufClient::IngestTargets(base::span<const uint8_t> json_bytes) {
   if (!targets_pin_set_) {
     return TufError::kVersionMismatch;
   }
+  if (json_bytes.size() != expected_targets_length_) {
+    return TufError::kLengthMismatch;
+  }
+  std::array<uint8_t, kSha256Len> actual{};
+  ::SHA256(json_bytes.data(), json_bytes.size(), actual.data());
+  if (actual != expected_targets_sha256_) {
+    return TufError::kHashMismatch;
+  }
   std::optional<base::DictValue> outer = ParseTopLevel(json_bytes);
   if (!outer) {
     return TufError::kBadJson;
@@ -499,6 +550,9 @@ TufError TufClient::IngestTargets(base::span<const uint8_t> json_bytes) {
       return TufError::kBadJson;
     }
     if (const base::DictValue* custom = t->FindDict("custom")) {
+      if (const std::string* v = custom->FindString("version")) {
+        tm.version = *v;
+      }
       if (const std::string* p = custom->FindString("platform")) {
         tm.platform = *p;
       }
@@ -509,6 +563,7 @@ TufError TufClient::IngestTargets(base::span<const uint8_t> json_bytes) {
         tm.channel = *c;
       }
     }
+    FillTargetFieldsFromName(kv.first, &tm);
     parsed[kv.first] = std::move(tm);
   }
   targets_ = std::move(parsed);
@@ -523,4 +578,31 @@ std::optional<TargetMeta> TufClient::LookupTarget(std::string_view name) const {
   return it->second;
 }

+std::optional<TargetMeta> TufClient::FindLatestTarget(
+    std::string_view platform,
+    std::string_view arch,
+    std::string_view channel) const {
+  std::optional<TargetMeta> best;
+  base::Version best_version;
+  for (const auto& kv : targets_) {
+    const TargetMeta& target = kv.second;
+    if (target.platform != platform || target.arch != arch) {
+      continue;
+    }
+    if (!channel.empty() && !target.channel.empty() &&
+        target.channel != channel) {
+      continue;
+    }
+    base::Version target_version(target.version);
+    if (!target_version.IsValid()) {
+      continue;
+    }
+    if (!best.has_value() || target_version.CompareTo(best_version) > 0) {
+      best = target;
+      best_version = target_version;
+    }
+  }
+  return best;
+}
+
 }  // namespace phlink::updater
