 enum class TufError {
   kOk,
-  kBadJson,           // not parseable as JSON, or wrong shape.
-  kBadSignature,      // signature did not verify under the role's keyset.
-  kThresholdNotMet,   // fewer valid signatures than the role's threshold.
-  kExpired,           // metadata `expires` is in the past.
-  kRollback,          // server tried to serve a lower version than cached.
-  kVersionMismatch,   // snapshot/timestamp pinned a version that does
-                      // not match the role we just parsed.
-  kLengthMismatch,    // snapshot.json declared length != actual bytes.
-  kHashMismatch,      // snapshot.json declared sha256 != actual bytes.
-  kUnsupportedSpec,   // spec_version outside what we implement.
-  kUnknownRole,       // referenced role was not declared in root.
-  kMissingField,      // required JSON field absent.
+  kBadJson,          // not parseable as JSON, or wrong shape.
