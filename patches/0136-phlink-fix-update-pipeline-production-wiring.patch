+    config.metadata_base_url = GURL(kMetadataBaseUrl);
+    config.payload_base_url = GURL(kPayloadBaseUrl);
+    config.current_version = PHLINK_PRODUCT_VERSION;
+    config.target_platform = TargetPlatform();
+    config.target_arch = TargetArch();
+    config.channel = kChannel;
+    config.staging_dir = profile_path_.AppendASCII("Phlink Updates");
+
+    pipeline_ = std::make_unique<UpdateCheckPipeline>(url_loader_factory_,
+                                                      std::move(config));
+    pipeline_->Run(base::BindOnce(&UpdateCheckRunner::OnPipelineFinished,
+                                  base::RetainedRef(this)));
