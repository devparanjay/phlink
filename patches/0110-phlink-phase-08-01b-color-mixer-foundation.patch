+// Copyright 2026 The phlink Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/color/phlink_color_mixer.h"
+
+#include "chrome/browser/ui/color/chrome_color_id.h"
+#include "chrome/browser/ui/color/phlink_palette.h"
+#include "ui/color/color_mixer.h"
+#include "ui/color/color_provider.h"
+#include "ui/color/color_provider_key.h"
+#include "ui/color/color_recipe.h"
+
+void AddPhlinkColorMixer(ui::ColorProvider* provider,
+                         const ui::ColorProviderKey& key) {
+  const bool dark =
+      key.color_mode == ui::ColorProviderKey::ColorMode::kDark;
+  const SkColor* p = dark ? phlink::kPhlinkDark : phlink::kPhlinkLight;
+  ui::ColorMixer& mixer = provider->AddMixer();
+  mixer[kColorPhlinkCanvas]     = {p[phlink::kCanvas]};
+  mixer[kColorPhlinkSurface]    = {p[phlink::kSurface]};
+  mixer[kColorPhlinkSurfaceAlt] = {p[phlink::kSurfaceAlt]};
+  mixer[kColorPhlinkCard]       = {p[phlink::kCard]};
+  mixer[kColorPhlinkText]       = {p[phlink::kText]};
+  mixer[kColorPhlinkTextMuted]  = {p[phlink::kTextMuted]};
+  mixer[kColorPhlinkHairline]   = {p[phlink::kHairline]};
+  mixer[kColorPhlinkAccent]     = {p[phlink::kAccent]};
+  mixer[kColorPhlinkOnAccent]   = {p[phlink::kOnAccent]};
+  mixer[kColorPhlinkDanger]     = {p[phlink::kDanger]};
+  mixer[kColorPhlinkSuccess]    = {p[phlink::kSuccess]};
+}
