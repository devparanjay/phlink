+// Copyright 2026 The phlink Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_COLOR_PHLINK_PALETTE_H_
+#define CHROME_BROWSER_UI_COLOR_PHLINK_PALETTE_H_
+
+#include <array>
+#include <cstddef>
+#include <utility>
+
+#include "third_party/skia/include/core/SkColor.h"
+#include "ui/color/color_id.h"
+
+// phlink palette tables (CONTEXT D-08). Patch 0110 ships zero-filled
+// placeholders; patch 0111 fills Light hex, patch 0112 fills Dark hex.
+
+namespace phlink {
+
+inline constexpr size_t kPhlinkPaletteSize = 11;
+
+// Index aliases for the palette arrays. Order must match PHLINK_COLOR_IDS in
+// phlink_color_id.h and the recipe wiring in phlink_color_mixer.cc.
+enum PhlinkToken : size_t {
+  kCanvas = 0,
+  kSurface,
+  kSurfaceAlt,
+  kCard,
+  kText,
+  kTextMuted,
+  kHairline,
+  kAccent,
+  kOnAccent,
+  kDanger,
+  kSuccess,
+};
+
+extern const SkColor kPhlinkLight[kPhlinkPaletteSize];
+extern const SkColor kPhlinkDark[kPhlinkPaletteSize];
+
+// WCAG-AA contrast pair tables (D-07). Sizes are zero in patch 0110; patch
+// 0114 wires the gtest gate using these arrays.
+extern const std::array<std::pair<ui::ColorId, ui::ColorId>, 0>
+    kPhlinkContrastNormalText;
+extern const std::array<std::pair<ui::ColorId, ui::ColorId>, 0>
+    kPhlinkContrastNonText;
+
+}  // namespace phlink
+
+#endif  // CHROME_BROWSER_UI_COLOR_PHLINK_PALETTE_H_
