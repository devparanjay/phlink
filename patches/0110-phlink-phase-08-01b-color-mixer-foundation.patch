+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_COLOR_PHLINK_COLOR_MIXER_H_
+#define CHROME_BROWSER_UI_COLOR_PHLINK_COLOR_MIXER_H_
+
+namespace ui {
+class ColorProvider;
+struct ColorProviderKey;
+}  // namespace ui
+
+// Adds the phlink color mixer to `provider`. Per CONTEXT D-02 this is
+// registered in AddChromeColorMixers AFTER AddNativeChromeColorMixer and
+// BEFORE the key.custom_theme block: phlink brand identity overrides native
+// vibrancy, but a user-installed community theme still wins.
+void AddPhlinkColorMixer(ui::ColorProvider* provider,
+                         const ui::ColorProviderKey& key);
+
+#endif  // CHROME_BROWSER_UI_COLOR_PHLINK_COLOR_MIXER_H_
diff --git a/chrome/browser/ui/color/phlink_color_mixer_unittests.cc b/chrome/browser/ui/color/phlink_color_mixer_unittests.cc
new file mode 100644
index 0000000000000..a379d8d31821a
--- /dev/null
+++ b/chrome/browser/ui/color/phlink_color_mixer_unittests.cc
@@ -0,0 +1,59 @@
+// Copyright 2026 The phlink Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/color/phlink_color_mixer.h"
+
+#include "chrome/browser/ui/color/chrome_color_id.h"
+#include "testing/gtest/include/gtest/gtest.h"
+#include "third_party/skia/include/core/SkColor.h"
+#include "ui/color/color_provider.h"
+#include "ui/color/color_provider_key.h"
+#include "ui/gfx/color_palette.h"
+
+namespace {
+
+constexpr ui::ColorId kPhlinkIds[] = {
+    kColorPhlinkCanvas,    kColorPhlinkSurface,   kColorPhlinkSurfaceAlt,
+    kColorPhlinkCard,      kColorPhlinkText,      kColorPhlinkTextMuted,
+    kColorPhlinkHairline,  kColorPhlinkAccent,    kColorPhlinkOnAccent,
+    kColorPhlinkDanger,    kColorPhlinkSuccess,
+};
+
+class PhlinkColorMixerTest
+    : public testing::TestWithParam<ui::ColorProviderKey::ColorMode> {};
+
+TEST_P(PhlinkColorMixerTest, ResolvesAllPhlinkIds) {
+  ui::ColorProvider provider;
+  ui::ColorProviderKey key;
+  key.color_mode = GetParam();
+  AddPhlinkColorMixer(&provider, key);
+  provider.GenerateColorMapForTesting();
+
+  for (ui::ColorId id : kPhlinkIds) {
+    SkColor color = provider.GetColor(id);
+    EXPECT_NE(color, gfx::kPlaceholderColor)
+        << "phlink color id " << id << " did not resolve";
+  }
+}
+
+TEST_P(PhlinkColorMixerTest, IdempotentRegistration) {
+  ui::ColorProvider provider;
+  ui::ColorProviderKey key;
+  key.color_mode = GetParam();
+  AddPhlinkColorMixer(&provider, key);
+  AddPhlinkColorMixer(&provider, key);
+  provider.GenerateColorMapForTesting();
+
+  for (ui::ColorId id : kPhlinkIds) {
+    EXPECT_NE(provider.GetColor(id), gfx::kPlaceholderColor);
+  }
+}
+
+INSTANTIATE_TEST_SUITE_P(
+    Modes,
+    PhlinkColorMixerTest,
+    testing::Values(ui::ColorProviderKey::ColorMode::kLight,
+                    ui::ColorProviderKey::ColorMode::kDark));
+
+}  // namespace
