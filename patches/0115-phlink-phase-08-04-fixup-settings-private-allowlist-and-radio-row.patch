+++ b/chrome/browser/resources/settings/appearance_page/appearance_page.html
@@ -46,22 +46,24 @@
             $i18n{phlinkThemeRowTitle}
           </div>
         </div>
-        <settings-radio-group id="phlinkThemeRadioGroup"
-            pref="{{prefs.phlink.appearance_mode}}"
-            aria-labelledby="phlinkThemeRowLabel">
-          <controlled-radio-button name="0"
+        <div class="cr-row continuation">
+          <settings-radio-group id="phlinkThemeRadioGroup"
               pref="{{prefs.phlink.appearance_mode}}"
-              label="$i18n{phlinkThemeLight}">
-          </controlled-radio-button>
-          <controlled-radio-button name="1"
-              pref="{{prefs.phlink.appearance_mode}}"
-              label="$i18n{phlinkThemeDark}">
-          </controlled-radio-button>
-          <controlled-radio-button name="2"
-              pref="{{prefs.phlink.appearance_mode}}"
-              label="$i18n{phlinkThemeFollowSystem}">
-          </controlled-radio-button>
-        </settings-radio-group>
+              aria-labelledby="phlinkThemeRowLabel">
+            <controlled-radio-button name="0"
+                pref="{{prefs.phlink.appearance_mode}}"
+                label="$i18n{phlinkThemeLight}">
+            </controlled-radio-button>
+            <controlled-radio-button name="1"
+                pref="{{prefs.phlink.appearance_mode}}"
+                label="$i18n{phlinkThemeDark}">
+            </controlled-radio-button>
+            <controlled-radio-button name="2"
+                pref="{{prefs.phlink.appearance_mode}}"
+                label="$i18n{phlinkThemeFollowSystem}">
+            </controlled-radio-button>
+          </settings-radio-group>
+        </div>
         <div class="settings-row" id="themeRow"
             hidden="[[!pageVisibility.setTheme]]">
           <cr-link-row id="openTheme" class="first"
