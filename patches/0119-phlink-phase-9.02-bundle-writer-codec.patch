+// Copyright 2026 The phlink Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_PHLINK_PORTABILITY_BUNDLE_WRITER_H_
+#define CHROME_BROWSER_PHLINK_PORTABILITY_BUNDLE_WRITER_H_
+
+#include <array>
+#include <cstdint>
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include "base/containers/span.h"
+#include "base/files/file_path.h"
+
+namespace phlink::portability {
+
+// Encodes a phlink profile bundle (`.phlinkbundle`) per
+// docs/dev/profile-bundle-format.md.
+//
+// Lifecycle:
+//   BundleWriter writer;
+//   writer.AddFile("Bookmarks", bookmarks_bytes);
+//   writer.AddFile("Preferences", prefs_bytes);
+//   bool ok = writer.WriteToFile(path, passphrase);
+//
+// The writer collects entries in memory, prepends a synthesized
+// `MANIFEST.json`, packs everything as a POSIX ustar archive, compresses with
+// zstd, and AEAD-seals the result with a key derived from `passphrase` via
+// Argon2id. Header bytes (the 69-byte preamble) are bound to the ciphertext as
+// AAD.
+class BundleWriter {
+ public:
+  BundleWriter();
+  ~BundleWriter();
+
+  BundleWriter(const BundleWriter&) = delete;
+  BundleWriter& operator=(const BundleWriter&) = delete;
+
+  // Adds a virtual file under `virtual_path` (forward-slash, UTF-8, ≤100
+  // bytes per ustar). Bytes are copied. Returns false if `virtual_path` is
+  // invalid or exceeds 100 bytes.
+  bool AddFile(std::string_view virtual_path,
+               base::span<const uint8_t> contents);
+
+  // Finalizes and writes the bundle to `path`. Overwrites any existing file.
+  // Returns true on success. On failure, `path` may be left in a partially
+  // written state; callers should write to a temp file and rename on success.
+  bool WriteToFile(const base::FilePath& path, std::string_view passphrase);
+
+  // For tests: produces the sealed bundle bytes without touching disk.
+  // Returned vector is empty on failure.
+  std::vector<uint8_t> WriteToBytes(std::string_view passphrase);
+
+ private:
+  struct Entry {
+    Entry();
+    Entry(const Entry&);
+    Entry(Entry&&);
+    ~Entry();
+    std::string path;
+    std::vector<uint8_t> bytes;
+    std::array<uint8_t, 32> sha256;
+  };
+
+  // Builds the manifest JSON from the current entries plus a deterministic
+  // `exported_at_utc` (taken from base::Time::Now()).
+  std::vector<uint8_t> BuildManifestJson() const;
+
+  // Emits a POSIX ustar archive containing `MANIFEST.json` (first) and then
+  // every entry in insertion order.
+  std::vector<uint8_t> BuildTar(base::span<const uint8_t> manifest) const;
+
+  std::vector<Entry> entries_;
+};
+
+}  // namespace phlink::portability
+
+#endif  // CHROME_BROWSER_PHLINK_PORTABILITY_BUNDLE_WRITER_H_
diff --git a/chrome/browser/phlink/portability/bundle_writer_unittest.cc b/chrome/browser/phlink/portability/bundle_writer_unittest.cc
new file mode 100644
index 0000000000000..00aa2c9ee72b1
