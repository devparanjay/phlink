@@ -0,0 +1,144 @@
+// Copyright 2026 The phlink Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/phlink/portability/bundle_writer.h"
+
+#include <array>
+#include <cstring>
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include "base/containers/span.h"
+#include "chrome/browser/phlink/portability/phlink_crypto.h"
+#include "testing/gtest/include/gtest/gtest.h"
+#include "third_party/zstd/src/lib/zstd.h"
+
+namespace phlink::portability {
+namespace {
+
+// Reads a little-endian integer of width sizeof(T) at offset `off` of `buf`.
+template <typename T>
+T ReadLE(base::span<const uint8_t> buf, size_t off) {
+  T v = 0;
+  for (size_t i = 0; i < sizeof(T); ++i) {
+    v |= static_cast<T>(buf[off + i]) << (8 * i);
+  }
+  return v;
+}
+
+TEST(BundleWriterTest, ProducesParseableSealedHeader) {
+  BundleWriter writer;
+  std::string content = "hello phlink";
+  base::span<const uint8_t> bytes(
+      reinterpret_cast<const uint8_t*>(content.data()), content.size());
+  ASSERT_TRUE(writer.AddFile("Bookmarks", bytes));
+
+  // Use fast KDF for tests by overriding via a sealed bundle written with
+  // default params. (KDF cost is paid once; the test takes < 1s.)
+  std::vector<uint8_t> bundle = writer.WriteToBytes("hunter2");
+  ASSERT_FALSE(bundle.empty());
+
+  // Magic and format version.
+  EXPECT_EQ(bundle[0], 'P');
+  EXPECT_EQ(bundle[1], 'H');
+  EXPECT_EQ(bundle[2], 'L');
+  EXPECT_EQ(bundle[3], 'B');
+  EXPECT_EQ((ReadLE<uint16_t>(bundle, 4)), 1u);
+  EXPECT_EQ(bundle[6], 1u);  // kdf_id = Argon2id
+  EXPECT_EQ(bundle[7], 1u);  // aead_id = XChaCha20-Poly1305
+  EXPECT_EQ(bundle[20], 16u);  // salt_len
+
+  uint64_t payload_len = ReadLE<uint64_t>(bundle, 0x3D);
+  ASSERT_EQ(bundle.size(), 0x45 + payload_len + 16u);
+}
+
+TEST(BundleWriterTest, RoundTripDecryptDecompress) {
+  BundleWriter writer;
+  std::string content_a = "alpha";
+  std::string content_b = R"({"key":"value"})";
+  ASSERT_TRUE(writer.AddFile(
+      "Bookmarks",
+      base::span<const uint8_t>(
+          reinterpret_cast<const uint8_t*>(content_a.data()),
+          content_a.size())));
+  ASSERT_TRUE(writer.AddFile(
+      "Preferences",
+      base::span<const uint8_t>(
+          reinterpret_cast<const uint8_t*>(content_b.data()),
+          content_b.size())));
+
+  std::string passphrase = "correct horse battery staple";
+  std::vector<uint8_t> bundle = writer.WriteToBytes(passphrase);
+  ASSERT_FALSE(bundle.empty());
+
+  // Parse header.
+  base::span<const uint8_t> bspan(bundle.data(), bundle.size());
+  base::span<const uint8_t> header = bspan.first(0x45u);
+  base::span<const uint8_t> salt = header.subspan(21u, 16u);
+  base::span<const uint8_t> nonce = header.subspan(37u, 24u);
+  uint64_t payload_len = ReadLE<uint64_t>(bspan, 0x3D);
+  ASSERT_EQ(bspan.size(), 0x45u + payload_len + 16u);
+  base::span<const uint8_t> ct_and_tag = bspan.subspan(0x45u);
+
+  KdfParams params{
+      .m_kib = ReadLE<uint32_t>(bspan, 8),
+      .t = ReadLE<uint32_t>(bspan, 12),
+      .p = ReadLE<uint32_t>(bspan, 16),
+  };
+  base::span<const uint8_t> pw_span(
+      reinterpret_cast<const uint8_t*>(passphrase.data()), passphrase.size());
+  auto key = DeriveKey(pw_span, salt, params);
+  ASSERT_TRUE(key.has_value());
+
+  auto plaintext = AeadOpen(*key, nonce, header, ct_and_tag);
+  ASSERT_TRUE(plaintext.has_value());
+
+  // Decompress zstd.
+  unsigned long long expected =
+      ZSTD_getFrameContentSize(plaintext->data(), plaintext->size());
+  ASSERT_NE(expected, ZSTD_CONTENTSIZE_ERROR);
+  ASSERT_NE(expected, ZSTD_CONTENTSIZE_UNKNOWN);
+  std::vector<uint8_t> tar(static_cast<size_t>(expected));
+  size_t got = ZSTD_decompress(tar.data(), tar.size(), plaintext->data(),
+                               plaintext->size());
+  ASSERT_FALSE(ZSTD_isError(got));
+  ASSERT_EQ(got, tar.size());
+
+  // Verify first ustar entry is MANIFEST.json.
+  ASSERT_GE(tar.size(), 512u);
+  std::string first_name(reinterpret_cast<const char*>(tar.data()), 13);
+  EXPECT_EQ(first_name, std::string("MANIFEST.json"));
+  // ustar magic at offset 257.
+  ASSERT_GE(tar.size(), 257u + 5u);
+  EXPECT_EQ(0, std::memcmp(tar.data() + 257, "ustar", 5));
+}
+
+TEST(BundleWriterTest, WrongPassphraseFailsAead) {
+  BundleWriter writer;
+  std::string content = "secret";
+  ASSERT_TRUE(writer.AddFile(
+      "Bookmarks",
+      base::span<const uint8_t>(
+          reinterpret_cast<const uint8_t*>(content.data()), content.size())));
+  std::vector<uint8_t> bundle = writer.WriteToBytes("right");
+  ASSERT_FALSE(bundle.empty());
+
+  base::span<const uint8_t> bspan(bundle.data(), bundle.size());
+  base::span<const uint8_t> header = bspan.first(0x45u);
+  base::span<const uint8_t> salt = header.subspan(21u, 16u);
+  base::span<const uint8_t> nonce = header.subspan(37u, 24u);
+  base::span<const uint8_t> ct_and_tag = bspan.subspan(0x45u);
+
+  std::string wrong = "wrong";
+  base::span<const uint8_t> pw_span(
+      reinterpret_cast<const uint8_t*>(wrong.data()), wrong.size());
+  auto key = DeriveKey(pw_span, salt, kDefaultKdfParams);
+  ASSERT_TRUE(key.has_value());
+  auto plaintext = AeadOpen(*key, nonce, header, ct_and_tag);
+  EXPECT_FALSE(plaintext.has_value());
+}
+
+}  // namespace
+}  // namespace phlink::portability
