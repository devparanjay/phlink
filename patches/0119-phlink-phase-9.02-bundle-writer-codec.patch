new file mode 100644
index 0000000000000..07c81c3ad2013
--- /dev/null
+++ b/chrome/browser/phlink/portability/bundle_writer.cc
@@ -0,0 +1,256 @@
+// Copyright 2026 The phlink Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/phlink/portability/bundle_writer.h"
+
+#include <array>
+#include <cstring>
+#include <string>
+
+#include "base/containers/span.h"
+#include "base/files/file_util.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/strings/string_util.h"
+#include "base/strings/stringprintf.h"
+#include "base/time/time.h"
+#include "chrome/browser/phlink/portability/phlink_crypto.h"
+#include "crypto/hash.h"
+#include "crypto/random.h"
+#include "third_party/zstd/src/lib/zstd.h"
+
+namespace phlink::portability {
+
+namespace {
+
+constexpr uint8_t kMagic[4] = {'P', 'H', 'L', 'B'};
+constexpr uint16_t kFormatVersion = 1;
+constexpr uint8_t kKdfArgon2id = 1;
+constexpr uint8_t kAeadXChaCha20Poly1305 = 1;
+constexpr size_t kSaltLen = 16;
+constexpr size_t kNonceLen = 24;
+constexpr size_t kTagLen = 16;
+constexpr size_t kHeaderLen = 0x45;  // 69 bytes — see profile-bundle-format.md §4.
+
+// Writes a little-endian integer to `out` at `offset`. Caller must ensure
+// `out` has space for sizeof(T) bytes starting at `offset`.
+template <typename T>
+void WriteLE(std::vector<uint8_t>& out, size_t offset, T value) {
+  for (size_t i = 0; i < sizeof(T); ++i) {
+    out[offset + i] = static_cast<uint8_t>((value >> (8 * i)) & 0xff);
+  }
+}
+
+// Encodes a non-negative integer as a NUL-terminated octal string of exactly
+// `width` characters (including the trailing NUL).
+void WriteOctalField(uint8_t* dst, size_t width, uint64_t value) {
+  // width includes trailing NUL.
+  std::string s = base::StringPrintf("%0*llo", static_cast<int>(width - 1),
+                                     static_cast<unsigned long long>(value));
+  std::memcpy(dst, s.data(), width - 1);
+  dst[width - 1] = '\0';
+}
+
+// Builds a single ustar 512-byte header for `path` of size `size`.
+std::array<uint8_t, 512> UstarHeader(std::string_view path, uint64_t size,
+                                     int64_t mtime) {
+  std::array<uint8_t, 512> hdr{};
+  // name [0..100). ustar limits to 100 bytes.
+  std::memcpy(hdr.data(), path.data(),
+              std::min<size_t>(path.size(), 100));
+  // mode [100..108). Set 0644.
+  WriteOctalField(hdr.data() + 100, 8, 0644);
+  // uid [108..116). 0.
+  WriteOctalField(hdr.data() + 108, 8, 0);
+  // gid [116..124). 0.
+  WriteOctalField(hdr.data() + 116, 8, 0);
+  // size [124..136). 12-byte octal.
+  WriteOctalField(hdr.data() + 124, 12, size);
+  // mtime [136..148). 12-byte octal.
+  WriteOctalField(hdr.data() + 136, 12, static_cast<uint64_t>(mtime));
+  // chksum [148..156). Initially spaces, then computed.
+  std::memset(hdr.data() + 148, ' ', 8);
+  // typeflag [156]. '0' = regular file.
+  hdr[156] = '0';
+  // linkname [157..257). zero.
+  // magic "ustar\0" [257..263).
+  std::memcpy(hdr.data() + 257, "ustar", 6);
+  // version "00" [263..265).
+  hdr[263] = '0';
+  hdr[264] = '0';
+  // uname/gname/devmajor/devminor/prefix — leave zero.
+
+  // Compute chksum: sum of all 512 bytes interpreting checksum field as
+  // spaces.
+  uint32_t sum = 0;
+  for (uint8_t b : hdr) {
+    sum += b;
+  }
+  WriteOctalField(hdr.data() + 148, 7, sum);
+  // The 8th byte of the checksum field must be a space per ustar spec.
+  hdr[155] = ' ';
+  return hdr;
+}
+
+std::string ToHex(base::span<const uint8_t> data) {
+  static const char kHex[] = "0123456789abcdef";
+  std::string out;
+  out.resize(data.size() * 2);
+  for (size_t i = 0; i < data.size(); ++i) {
+    out[2 * i] = kHex[data[i] >> 4];
+    out[2 * i + 1] = kHex[data[i] & 0x0f];
+  }
+  return out;
+}
+
+std::string FormatTimeUtc(base::Time t) {
+  base::Time::Exploded e;
+  t.UTCExplode(&e);
+  return base::StringPrintf("%04d-%02d-%02dT%02d:%02d:%02dZ", e.year, e.month,
+                            e.day_of_month, e.hour, e.minute, e.second);
+}
+
+}  // namespace
+
+BundleWriter::BundleWriter() = default;
+BundleWriter::~BundleWriter() = default;
+
+BundleWriter::Entry::Entry() = default;
+BundleWriter::Entry::Entry(const Entry&) = default;
+BundleWriter::Entry::Entry(Entry&&) = default;
+BundleWriter::Entry::~Entry() = default;
+
+bool BundleWriter::AddFile(std::string_view virtual_path,
+                           base::span<const uint8_t> contents) {
+  if (virtual_path.empty() || virtual_path.size() > 100) {
+    return false;
+  }
+  if (virtual_path == "MANIFEST.json") {
+    // Reserved — synthesized by Finalize.
+    return false;
+  }
+  Entry entry;
+  entry.path.assign(virtual_path);
+  entry.bytes.assign(contents.begin(), contents.end());
+  auto hash = crypto::hash::Sha256(contents);
+  std::copy(hash.begin(), hash.end(), entry.sha256.begin());
+  entries_.push_back(std::move(entry));
+  return true;
+}
+
+std::vector<uint8_t> BundleWriter::BuildManifestJson() const {
+  std::string json = "{\n  \"format_version\": 1,\n";
+  json += "  \"exporter_version\": \"phlink/0.1.0\",\n";
+  json += "  \"exported_at_utc\": \"" + FormatTimeUtc(base::Time::Now()) +
+          "\",\n";
+  json += "  \"categories\": [],\n";
+  json += "  \"entries\": [\n";
+  for (size_t i = 0; i < entries_.size(); ++i) {
+    const Entry& e = entries_[i];
+    json += "    {\"path\": \"" + e.path + "\", \"sha256\": \"" +
+            ToHex(e.sha256) + "\", \"size\": " +
+            base::NumberToString(e.bytes.size()) + "}";
+    if (i + 1 < entries_.size()) {
+      json += ",";
+    }
+    json += "\n";
+  }
+  json += "  ]\n}\n";
+  return std::vector<uint8_t>(json.begin(), json.end());
+}
+
+std::vector<uint8_t> BundleWriter::BuildTar(
+    base::span<const uint8_t> manifest) const {
+  std::vector<uint8_t> tar;
+  // mtime: zero (deterministic across hosts).
+  const int64_t mtime = 0;
+
+  auto append_entry = [&](std::string_view path,
+                          base::span<const uint8_t> data) {
+    auto hdr = UstarHeader(path, data.size(), mtime);
+    tar.insert(tar.end(), hdr.begin(), hdr.end());
+    tar.insert(tar.end(), data.begin(), data.end());
+    // Pad content to 512-byte boundary.
+    size_t pad = (512 - (data.size() % 512)) % 512;
+    tar.insert(tar.end(), pad, 0);
+  };
+
+  append_entry("MANIFEST.json", manifest);
+  for (const Entry& e : entries_) {
+    append_entry(e.path, e.bytes);
+  }
+  // Two zero blocks terminate a ustar archive.
+  tar.insert(tar.end(), 1024, 0);
+  return tar;
+}
+
+std::vector<uint8_t> BundleWriter::WriteToBytes(std::string_view passphrase) {
+  // Build manifest + tar.
+  std::vector<uint8_t> manifest = BuildManifestJson();
+  std::vector<uint8_t> tar = BuildTar(manifest);
+
+  // zstd-compress.
+  size_t bound = ZSTD_compressBound(tar.size());
+  std::vector<uint8_t> compressed(bound);
+  size_t compressed_size =
+      ZSTD_compress(compressed.data(), compressed.size(), tar.data(),
+                    tar.size(), /*compressionLevel=*/3);
+  if (ZSTD_isError(compressed_size)) {
+    return {};
+  }
+  compressed.resize(compressed_size);
+
+  // Generate salt + nonce.
+  std::array<uint8_t, kSaltLen> salt;
+  std::array<uint8_t, kNonceLen> nonce;
+  crypto::RandBytes(salt);
+  crypto::RandBytes(nonce);
+
+  // Build the 69-byte AAD header.
+  std::vector<uint8_t> header(kHeaderLen, 0);
+  std::memcpy(header.data(), kMagic, 4);
+  WriteLE<uint16_t>(header, 4, kFormatVersion);
+  header[6] = kKdfArgon2id;
+  header[7] = kAeadXChaCha20Poly1305;
+  WriteLE<uint32_t>(header, 8, kDefaultKdfParams.m_kib);
+  WriteLE<uint32_t>(header, 12, kDefaultKdfParams.t);
+  WriteLE<uint32_t>(header, 16, kDefaultKdfParams.p);
+  header[20] = static_cast<uint8_t>(kSaltLen);
+  std::memcpy(header.data() + 21, salt.data(), kSaltLen);
+  std::memcpy(header.data() + 37, nonce.data(), kNonceLen);
+  // payload_len at 0x3D (61): ciphertext length, EXCLUDING tag.
+  WriteLE<uint64_t>(header, 0x3D,
+                    static_cast<uint64_t>(compressed.size()));
+
+  // Derive key.
+  base::span<const uint8_t> pw_span(
+      reinterpret_cast<const uint8_t*>(passphrase.data()), passphrase.size());
+  auto key = DeriveKey(pw_span, salt, kDefaultKdfParams);
+  if (!key.has_value()) {
+    return {};
+  }
+
+  // AEAD seal.
+  auto sealed = AeadSeal(*key, nonce, header, compressed);
+  if (!sealed.has_value() || sealed->size() != compressed.size() + kTagLen) {
+    return {};
+  }
+
+  // Concatenate: header || ciphertext || tag.
+  std::vector<uint8_t> out;
+  out.reserve(header.size() + sealed->size());
+  out.insert(out.end(), header.begin(), header.end());
+  out.insert(out.end(), sealed->begin(), sealed->end());
+  return out;
+}
+
+bool BundleWriter::WriteToFile(const base::FilePath& path,
+                               std::string_view passphrase) {
+  std::vector<uint8_t> bytes = WriteToBytes(passphrase);
+  if (bytes.empty()) {
+    return false;
+  }
+  return base::WriteFile(path, bytes);
+}
+
+}  // namespace phlink::portability
