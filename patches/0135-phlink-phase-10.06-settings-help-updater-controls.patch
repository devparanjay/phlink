+void AboutHandler::HandleGetPhlinkUpdateStatus(const base::ListValue& args) {
+  AllowJavascript();
+  CHECK_EQ(1U, args.size());
+  ResolveJavascriptCallback(args[0], GetPhlinkUpdateStatus());
+}
+
+void AboutHandler::HandleSetPhlinkAutoCheckEnabled(
+    const base::ListValue& args) {
+  AllowJavascript();
+  CHECK_EQ(2U, args.size());
+  const std::string& callback_id = args[0].GetString();
+  const bool enabled = args[1].GetBool();
+
+  PrefService* local_state = g_browser_process->local_state();
+  if (local_state) {
+    local_state->SetBoolean(phlink::updater::prefs::kAutoCheckEnabled, enabled);
+    phlink::updater::UpdaterServiceFactory::EnsureFactoryBuilt();
+    if (phlink::updater::UpdaterService* service =
+            phlink::updater::UpdaterServiceFactory::GetForProfile(profile_)) {
+      if (enabled) {
+        service->Start();
+      } else {
+        service->Stop();
+      }
+    }
+  }
+
+  base::DictValue status = GetPhlinkUpdateStatus();
+  ResolveJavascriptCallback(base::Value(callback_id), status.Clone());
+  FireWebUIListener("phlink-update-status-changed", status);
+}
+
+void AboutHandler::HandleCheckPhlinkUpdatesNow(const base::ListValue& args) {
+  DCHECK(args.empty());
+  AllowJavascript();
+  base::DictValue checking = GetPhlinkUpdateStatus();
+  checking.Set("status", "checking");
+  FireWebUIListener("phlink-update-status-changed", checking);
+
+  if (g_browser_process->local_state()) {
+    phlink::updater::UpdaterServiceFactory::EnsureFactoryBuilt();
+    if (phlink::updater::UpdaterService* service =
+            phlink::updater::UpdaterServiceFactory::GetForProfile(profile_)) {
+      service->CheckNow();
+    }
+  }
+
+  FirePhlinkUpdateStatusChanged();
+}
+
+base::DictValue AboutHandler::GetPhlinkUpdateStatus() const {
+  base::DictValue status;
+  PrefService* local_state = g_browser_process->local_state();
+  if (!local_state) {
+    status.Set("status", "unavailable");
+    status.Set("enabled", false);
+    status.Set("canCheck", false);
+    return status;
+  }
+
+  const bool enabled =
+      local_state->GetBoolean(phlink::updater::prefs::kAutoCheckEnabled);
+  const double last_check_time = static_cast<double>(
+      local_state->GetInt64(phlink::updater::prefs::kLastCheckTime));
+  const double next_check_time = static_cast<double>(
+      local_state->GetInt64(phlink::updater::prefs::kNextCheckTime));
+  status.Set("status", enabled ? "updated" : "disabled");
+  status.Set("enabled", enabled);
+  status.Set("canCheck", true);
+  status.Set("lastCheckTime", last_check_time);
+  status.Set("nextCheckTime", next_check_time);
+  return status;
+}
+
+void AboutHandler::FirePhlinkUpdateStatusChanged() {
+  FireWebUIListener("phlink-update-status-changed", GetPhlinkUpdateStatus());
+}
