+namespace phlink::adblock {
+
+// Boolean. When false, phlink does not block requests, does not inject
+// cosmetic CSS, and does not run scriptlets. Default: true.
+inline constexpr char kAdblockEnabled[] = "phlink.adblock.enabled";
+
+// List<string>. Each entry is a registrable domain (eTLD+1) on which
+// adblock is fully disabled (request blocking + cosmetic). Default: [].
+inline constexpr char kAdblockExceptions[] = "phlink.adblock.exceptions";
+
+// Registers the phlink-adblock profile prefs with their defaults.
+// Called from `chrome/browser/prefs/browser_prefs.cc::RegisterProfilePrefs`.
+void RegisterProfilePrefs(user_prefs::PrefRegistrySyncable* registry);
+
+}  // namespace phlink::adblock
