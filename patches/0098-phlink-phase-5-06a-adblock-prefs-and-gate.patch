+// Copyright 2026 The phlink Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/phlink/adblock/adblock_settings_service.h"
+
+#include <string>
+#include <unordered_set>
+#include <utility>
+
+#include "base/functional/bind.h"
+#include "base/strings/string_util.h"
+#include "base/values.h"
+#include "chrome/browser/phlink/adblock/engine_provider.h"
+#include "chrome/browser/phlink/adblock/phlink_adblock_prefs.h"
+#include "components/prefs/pref_service.h"
+
+namespace phlink::adblock {
+
+AdblockSettingsService::AdblockSettingsService(PrefService* prefs)
+    : prefs_(prefs) {
+  registrar_.Init(prefs_);
+  registrar_.Add(
+      kAdblockEnabled,
+      base::BindRepeating(&AdblockSettingsService::PushPrefsToEngineProvider,
+                          base::Unretained(this)));
+  registrar_.Add(
+      kAdblockExceptions,
+      base::BindRepeating(&AdblockSettingsService::PushPrefsToEngineProvider,
+                          base::Unretained(this)));
+  PushPrefsToEngineProvider();
+}
+
+AdblockSettingsService::~AdblockSettingsService() = default;
+
+void AdblockSettingsService::PushPrefsToEngineProvider() {
+  EngineProvider* provider = EngineProvider::GetInstance();
+  provider->SetEnabled(prefs_->GetBoolean(kAdblockEnabled));
+
+  std::unordered_set<std::string> domains;
+  for (const base::Value& entry : prefs_->GetList(kAdblockExceptions)) {
+    if (!entry.is_string()) {
+      continue;
+    }
+    std::string domain = base::ToLowerASCII(entry.GetString());
+    if (!domain.empty()) {
+      domains.insert(std::move(domain));
+    }
+  }
+  provider->SetExceptionDomains(std::move(domains));
+}
+
+}  // namespace phlink::adblock
