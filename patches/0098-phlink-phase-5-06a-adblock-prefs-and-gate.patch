@@ -111,8 +111,14 @@ void PhlinkAdblockThrottle::WillStartRequest(network::ResourceRequest* request,
   if (!engine_ || !request) {
     return;
   }
-  if (ShouldBlock(request->url, DeriveSourceUrl(*request),
-                  request->destination)) {
+  const GURL source_url = DeriveSourceUrl(*request);
+  // Master switch + per-site exception gate. We check the *source*
+  // (initiator / page) URL so the user's "disable on this site"
+  // exception correctly applies to all sub-resources of that page.
+  if (!EngineProvider::GetInstance()->IsActiveForUrl(source_url)) {
+    return;
+  }
+  if (ShouldBlock(request->url, source_url, request->destination)) {
     delegate_->CancelWithError(net::ERR_BLOCKED_BY_CLIENT,
