diff --git a/chrome/browser/phlink/adblock/engine_provider.cc b/chrome/browser/phlink/adblock/engine_provider.cc
index 450c138e1fab6..b88550a5587ad 100644
--- a/chrome/browser/phlink/adblock/engine_provider.cc
+++ b/chrome/browser/phlink/adblock/engine_provider.cc
@@ -9,7 +9,9 @@
 
 #include "base/no_destructor.h"
 #include "chrome/browser/phlink/adblock/phlink_adblock.h"
+#include "net/base/registry_controlled_domains/registry_controlled_domain.h"
 #include "third_party/phlink_filter_lists/bundled_rules.h"
+#include "url/gurl.h"
 
 namespace phlink::adblock {
 
@@ -41,4 +43,38 @@ void EngineProvider::SetEngineFromRulesForTesting(std::string_view rules) {
   engine_ = std::move(fresh);
 }
 
+bool EngineProvider::IsActiveForUrl(const GURL& url) const {
+  if (!enabled_.load(std::memory_order_relaxed)) {
+    return false;
+  }
+  if (!url.is_valid() || !url.SchemeIsHTTPOrHTTPS()) {
+    return false;
+  }
+  const std::string domain =
+      net::registry_controlled_domains::GetDomainAndRegistry(
+          url, net::registry_controlled_domains::INCLUDE_PRIVATE_REGISTRIES);
+  if (domain.empty()) {
+    // Hosts like raw IPs / localhost don't have a registrable domain.
+    // Fall through to "active" — exception list is keyed on eTLD+1
+    // and can't represent these.
+    return true;
+  }
+  std::lock_guard<std::mutex> lock(exceptions_mutex_);
+  return exception_domains_.find(domain) == exception_domains_.end();
+}
+
+void EngineProvider::SetEnabled(bool enabled) {
+  enabled_.store(enabled, std::memory_order_relaxed);
+}
+
+bool EngineProvider::IsEnabled() const {
+  return enabled_.load(std::memory_order_relaxed);
+}
+
+void EngineProvider::SetExceptionDomains(
+    std::unordered_set<std::string> domains) {
+  std::lock_guard<std::mutex> lock(exceptions_mutex_);
+  exception_domains_ = std::move(domains);
+}
+
 }  // namespace phlink::adblock
