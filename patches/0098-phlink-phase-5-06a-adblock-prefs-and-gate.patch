+// Copyright 2026 The phlink Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_PHLINK_ADBLOCK_ADBLOCK_SETTINGS_SERVICE_H_
+#define CHROME_BROWSER_PHLINK_ADBLOCK_ADBLOCK_SETTINGS_SERVICE_H_
+
+#include "base/memory/raw_ptr.h"
+#include "components/keyed_service/core/keyed_service.h"
+#include "components/prefs/pref_change_registrar.h"
+
+class PrefService;
+
+namespace phlink::adblock {
+
+// Per-profile bridge that mirrors the user's adblock prefs
+// (`phlink.adblock.enabled`, `phlink.adblock.exceptions`) into the
+// process-global `EngineProvider` runtime gate. With phlink's
+// single-profile-per-session expectation in v1, the most-recently
+// initialized profile wins — sufficient for the master switch and
+// per-site exceptions, both of which are user-facing toggles. A
+// future profile-aware gate can replace this without touching
+// throttle / cosmetic-host code.
+class AdblockSettingsService : public KeyedService {
+ public:
+  explicit AdblockSettingsService(PrefService* prefs);
+
+  AdblockSettingsService(const AdblockSettingsService&) = delete;
+  AdblockSettingsService& operator=(const AdblockSettingsService&) = delete;
+
+  ~AdblockSettingsService() override;
+
+ private:
+  void PushPrefsToEngineProvider();
+
+  const raw_ptr<PrefService> prefs_;
+  PrefChangeRegistrar registrar_;
+};
+
+}  // namespace phlink::adblock
+
+#endif  // CHROME_BROWSER_PHLINK_ADBLOCK_ADBLOCK_SETTINGS_SERVICE_H_
