@@ -0,0 +1,47 @@
+// Copyright 2026 The phlink Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_PHLINK_UPDATER_WIN_UPDATE_HELPER_APPLY_H_
+#define CHROME_BROWSER_PHLINK_UPDATER_WIN_UPDATE_HELPER_APPLY_H_
+
+#include "base/files/file_path.h"
+
+namespace phlink::updater::win {
+
+enum class ApplyResult {
+  kOk = 0,
+  kBadArguments = 2,
+  kStagedJsonMissing = 3,
+  kStagedJsonInvalid = 4,
+  kPayloadMissing = 5,
+  kSignatureInvalid = 8,
+  kSwapFailed = 10,
+};
+
+struct ApplyOptions {
+  // Directory containing `staged.json` and the verified payload exe.
+  base::FilePath staging_dir;
+
+  // Path to the currently-running `phlink.exe` to be replaced.
+  base::FilePath target_exe_path;
+
+  // If true, skip the WinVerifyTrust Authenticode check (tests only).
+  bool skip_signature_check = false;
+
+  // The expected EV-cert subject CN to pin against; empty disables
+  // pinning (tests only).
+  std::wstring expected_subject_cn;
+};
+
+// Applies the staged update:
+//   1. Read staged.json.
+//   2. WinVerifyTrust Authenticode check on the payload exe.
+//   3. Verify the signing cert subject CN matches the pinned value.
+//   4. MoveFileExW(MOVEFILE_REPLACE_EXISTING | MOVEFILE_DELAY_UNTIL_REBOOT)
+//      to swap the running exe at next reboot.
+ApplyResult Apply(const ApplyOptions& opts);
+
+}  // namespace phlink::updater::win
+
+#endif  // CHROME_BROWSER_PHLINK_UPDATER_WIN_UPDATE_HELPER_APPLY_H_
