+// found in the LICENSE file.
+
+#include "chrome/browser/phlink/updater/win/update_helper_apply.h"
+
+#include "base/files/file_path.h"
+#include "base/files/file_util.h"
+#include "base/files/scoped_temp_dir.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace phlink::updater::win {
+namespace {
+
+class UpdateHelperApplyWinTest : public ::testing::Test {
+ protected:
+  void SetUp() override { ASSERT_TRUE(temp_.CreateUniqueTempDir()); }
+  base::FilePath path() const { return temp_.GetPath(); }
+  base::ScopedTempDir temp_;
+};
+
+TEST_F(UpdateHelperApplyWinTest, BadArgumentsRejected) {
+  ApplyOptions opts;
+  EXPECT_EQ(ApplyResult::kBadArguments, Apply(opts));
+}
+
+TEST_F(UpdateHelperApplyWinTest, MissingStagedJsonReturnsKStagedJsonMissing) {
+  ApplyOptions opts;
+  opts.staging_dir = path();
+  opts.target_exe_path = path().AppendASCII("phlink.exe");
+  EXPECT_EQ(ApplyResult::kStagedJsonMissing, Apply(opts));
+}
+
+}  // namespace
+}  // namespace phlink::updater::win
