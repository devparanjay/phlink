+    SkColorSetRGB(0xA0, 0xA0, 0xA0),  // [5] kTextMuted    — #A0A0A0
+    SkColorSetRGB(0x2A, 0x2A, 0x2A),  // [6] kHairline     — #2A2A2A
+    SkColorSetRGB(0xF5, 0xE6, 0x8A),  // [7] kAccent       — #F5E68A (Pastel Yellow)
+    SkColorSetRGB(0x00, 0x00, 0x00),  // [8] kOnAccent     — #000000 ← CRITICAL: never white. 16:1 contrast.
+    SkColorSetRGB(0xF5, 0x73, 0x6B),  // [9] kDanger       — #F5736B (lightened for dark)
+    SkColorSetRGB(0x6F, 0xE3, 0x8A),  // [10] kSuccess     — #6FE38A
 };
 
