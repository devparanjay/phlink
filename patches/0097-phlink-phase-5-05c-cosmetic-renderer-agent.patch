@@ -0,0 +1,118 @@
+// Copyright 2026 The phlink Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/renderer/phlink/adblock/cosmetic_filter_agent.h"
+
+#include <string>
+#include <utility>
+
+#include "base/strings/strcat.h"
+#include "base/strings/string_util.h"
+#include "content/public/renderer/render_frame.h"
+#include "third_party/blink/public/platform/browser_interface_broker_proxy.h"
+#include "third_party/blink/public/platform/web_string.h"
+#include "third_party/blink/public/web/web_document.h"
+#include "third_party/blink/public/web/web_local_frame.h"
+#include "third_party/blink/public/web/web_script_source.h"
+#include "url/gurl.h"
+
+namespace phlink::adblock {
+
+namespace {
+
+// Concatenates selectors into a single stylesheet rule. Phlink uses
+// `display: none !important;` rather than `visibility: hidden` to match
+// uBlock Origin's default behavior so existing element-hide rules don't
+// behave differently under phlink.
+std::string BuildStyleSheet(const std::vector<std::string>& selectors) {
+  if (selectors.empty()) {
+    return std::string();
+  }
+  std::string css = base::JoinString(selectors, ", ");
+  css += " { display: none !important; }";
+  return css;
+}
+
+}  // namespace
+
+CosmeticFilterAgent::CosmeticFilterAgent(content::RenderFrame* render_frame)
+    : content::RenderFrameObserver(render_frame) {}
+
+CosmeticFilterAgent::~CosmeticFilterAgent() = default;
+
+void CosmeticFilterAgent::OnDestruct() {
+  delete this;
+}
+
+void CosmeticFilterAgent::DidCommitProvisionalLoad(
+    ui::PageTransition /*transition*/) {
+  blink::WebLocalFrame* frame = render_frame()->GetWebFrame();
+  if (!frame) {
+    return;
+  }
+  const GURL document_url = frame->GetDocument().Url();
+  // Skip empty / unsupported URLs — the browser-side host applies the
+  // same scheme guard, but short-circuiting here avoids the round-trip
+  // entirely for chrome:// and devtools:// navigations.
+  if (!document_url.is_valid() ||
+      !(document_url.SchemeIs("http") || document_url.SchemeIs("https"))) {
+    return;
+  }
+
+  mojom::AdblockCosmeticFilter* host = GetHost();
+  if (!host) {
+    return;
+  }
+  host->GetCosmeticResources(
+      document_url,
+      base::BindOnce(&CosmeticFilterAgent::OnCosmeticResources,
+                     weak_factory_.GetWeakPtr()));
+}
+
+mojom::AdblockCosmeticFilter* CosmeticFilterAgent::GetHost() {
+  if (host_.is_bound() && host_.is_connected()) {
+    return host_.get();
+  }
+  host_.reset();
+  if (!render_frame()) {
+    return nullptr;
+  }
+  render_frame()->GetBrowserInterfaceBroker().GetInterface(
+      host_.BindNewPipeAndPassReceiver());
+  return host_.get();
+}
+
+void CosmeticFilterAgent::OnCosmeticResources(
+    mojom::AdblockCosmeticResourcesPtr resources) {
+  if (!resources || !render_frame()) {
+    return;
+  }
+  blink::WebLocalFrame* frame = render_frame()->GetWebFrame();
+  if (!frame) {
+    return;
+  }
+
+  std::vector<std::string> selectors;
+  if (!resources->generichide) {
+    selectors = std::move(resources->hide_selectors);
+  } else {
+    // `$generichide` exception: drop generic selectors. adblock-rust
+    // already partitions them on the browser side; in this v1 surface
+    // we simply skip the entire bundle when generichide is set, which
+    // matches Brave's renderer-side behavior for $generichide on a
+    // top-level frame and is conservative for sub-frames.
+  }
+
+  std::string css = BuildStyleSheet(selectors);
+  if (!css.empty()) {
+    frame->GetDocument().InsertStyleSheet(blink::WebString::FromUtf8(css));
+  }
+
+  if (!resources->injected_script.empty()) {
+    frame->ExecuteScript(blink::WebScriptSource(
+        blink::WebString::FromUtf8(resources->injected_script)));
+  }
+}
+
+}  // namespace phlink::adblock
