+
+#ifndef CHROME_RENDERER_PHLINK_ADBLOCK_COSMETIC_FILTER_AGENT_H_
+#define CHROME_RENDERER_PHLINK_ADBLOCK_COSMETIC_FILTER_AGENT_H_
+
+#include "base/memory/weak_ptr.h"
+#include "chrome/common/phlink_adblock.mojom.h"
+#include "content/public/renderer/render_frame_observer.h"
+#include "mojo/public/cpp/bindings/remote.h"
+
+namespace content {
+class RenderFrame;
+}  // namespace content
+
+namespace phlink::adblock {
+
+// Renderer-side agent that pulls per-URL cosmetic resources from the
+// browser process at document-start (`DidCommitProvisionalLoad`) and
+// applies them to the current `WebDocument`:
+//
+//   * concatenates `hide_selectors` into a `display: none !important;`
+//     stylesheet inserted via `WebDocument::InsertStyleSheet`;
+//   * runs `injected_script` through `WebLocalFrame::ExecuteScript`
+//     (uBO-style `+js(...)` scriptlets).
+//
+// The agent self-deletes when its `RenderFrame` is destroyed. It is
+// instantiated once per RenderFrame in
+// `ChromeContentRendererClient::RenderFrameCreated`.
+class CosmeticFilterAgent : public content::RenderFrameObserver {
+ public:
+  explicit CosmeticFilterAgent(content::RenderFrame* render_frame);
+
+  CosmeticFilterAgent(const CosmeticFilterAgent&) = delete;
+  CosmeticFilterAgent& operator=(const CosmeticFilterAgent&) = delete;
+
+  ~CosmeticFilterAgent() override;
+
+ private:
+  // content::RenderFrameObserver:
+  void DidCommitProvisionalLoad(ui::PageTransition transition) override;
+  void OnDestruct() override;
+
+  // Lazily binds (or rebinds on disconnect) `host_` to the browser
+  // process's `phlink::mojom::AdblockCosmeticFilter` implementation
+  // and returns it. Returns null if the frame is in a state where
+  // interface acquisition is not possible (e.g. detached).
+  mojom::AdblockCosmeticFilter* GetHost();
+
+  // Mojo response handler.
+  void OnCosmeticResources(mojom::AdblockCosmeticResourcesPtr resources);
+
+  mojo::Remote<mojom::AdblockCosmeticFilter> host_;
+  base::WeakPtrFactory<CosmeticFilterAgent> weak_factory_{this};
+};
+
+}  // namespace phlink::adblock
+
+#endif  // CHROME_RENDERER_PHLINK_ADBLOCK_COSMETIC_FILTER_AGENT_H_
