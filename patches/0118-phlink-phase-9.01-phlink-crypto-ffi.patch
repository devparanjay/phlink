+impl<Alg: BlockEncrypt> BlockEncryptMut for Alg {
+    fn encrypt_with_backend_mut(&mut self, f: impl BlockClosure<BlockSize = Self::BlockSize>) {
+        self.encrypt_with_backend(f);
+    }
+}
+
+impl<Alg: BlockDecrypt> BlockDecryptMut for Alg {
