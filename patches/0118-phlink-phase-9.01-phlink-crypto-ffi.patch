+            _mm256_unpackhi_epi64(blocks_01, blocks_23),
+            set02(3, 1, 2, 0),
+        );
+        let a1 = _mm256_permute4x64_epi64(
+            _mm256_unpacklo_epi64(blocks_01, blocks_23),
+            set02(3, 1, 2, 0),
+        );
