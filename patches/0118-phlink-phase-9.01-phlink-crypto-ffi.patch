+    #[inline]
+    fn to_i8() -> i8 {
+        Self::I8
+    }
+    #[inline]
+    fn to_i16() -> i16 {
+        Self::I16
+    }
+    #[inline]
+    fn to_i32() -> i32 {
+        Self::I32
+    }
+    #[inline]
+    fn to_i64() -> i64 {
+        Self::I64
+    }
+    #[cfg(feature = "i128")]
+    #[inline]
+    fn to_i128() -> i128 {
+        Self::I128
+    }
+    #[inline]
+    fn to_isize() -> isize {
+        Self::ISIZE
+    }
