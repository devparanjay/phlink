+            $($name $bs;)*
+        );
+    };
+    (
+        Key: $cipher:ty;
+        $($name:ident $bs:expr;)*
+    ) => {
+        $crate::stream_cipher_bench!(
+            Init: {
+                use $crate::KeyInit;
+                let key = test::black_box(Default::default());
+                let iv = test::black_box(Default::default());
+                <$cipher>::new(&key, &iv)
+            };
+            $($name $bs;)*
+        );
+    };
+    (
+        Init: $init:expr;
+        $($name:ident $bs:expr;)*
+    ) => {
+        $(
+            #[bench]
+            fn $name(b: &mut test::Bencher) {
+                use $crate::StreamCipher;
+
+                let mut cipher = $init;
+                let mut buf = vec![0; $bs];
+
+                b.iter(|| {
+                    cipher.apply_keystream(&mut buf);
+                    test::black_box(&buf);
+                });
+
+                b.bytes = $bs;
+            }
