+        unsafe {
+            Aligned4x130 {
+                v0: _mm256_add_epi32(self.v0, other.v0),
+                v1: _mm256_add_epi32(self.v1, other.v1),
+                v2: _mm256_add_epi32(self.v2, other.v2),
+            }
+        }
+    }
