+        // [
+        //     b33[14..0] || b32[32..14] || b31[26..0] || b30[32..26],
+        //     b23[14..0] || b22[32..14] || b21[26..0] || b20[32..26],
+        //     b13[14..0] || b12[32..14] || b11[26..0] || b10[32..26],
