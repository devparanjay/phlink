@@ -0,0 +1,70 @@
+// Copyright 2026 The phlink Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/phlink/portability/phlink_crypto.h"
+
+#include "chrome/browser/phlink/portability/phlink_crypto_ffi.rs.h"
+
+namespace phlink::portability {
+
+namespace {
+
+rust::Slice<const uint8_t> AsSlice(base::span<const uint8_t> s) {
+  return rust::Slice<const uint8_t>(s.data(), s.size());
+}
+
+rust::Slice<uint8_t> AsMutSlice(base::span<uint8_t> s) {
+  return rust::Slice<uint8_t>(s.data(), s.size());
+}
+
+}  // namespace
+
+std::optional<std::array<uint8_t, 32>> DeriveKey(
+    base::span<const uint8_t> passphrase,
+    base::span<const uint8_t> salt,
+    const KdfParams& params) {
+  std::array<uint8_t, 32> out{};
+  bool ok = phlink::crypto::phlink_kdf_argon2id(
+      AsSlice(passphrase), AsSlice(salt), params.m_kib, params.t, params.p,
+      AsMutSlice(base::span(out)));
+  if (!ok) {
+    return std::nullopt;
+  }
+  return out;
+}
+
+std::optional<std::vector<uint8_t>> AeadSeal(
+    base::span<const uint8_t> key,
+    base::span<const uint8_t> nonce,
+    base::span<const uint8_t> aad,
+    base::span<const uint8_t> plaintext) {
+  std::vector<uint8_t> out(plaintext.size() + 16);
+  bool ok = phlink::crypto::phlink_aead_seal(
+      AsSlice(key), AsSlice(nonce), AsSlice(aad), AsSlice(plaintext),
+      AsMutSlice(base::span(out)));
+  if (!ok) {
+    return std::nullopt;
+  }
+  return out;
+}
+
+std::optional<std::vector<uint8_t>> AeadOpen(
+    base::span<const uint8_t> key,
+    base::span<const uint8_t> nonce,
+    base::span<const uint8_t> aad,
+    base::span<const uint8_t> ciphertext) {
+  if (ciphertext.size() < 16) {
+    return std::nullopt;
+  }
+  std::vector<uint8_t> out(ciphertext.size() - 16);
+  bool ok = phlink::crypto::phlink_aead_open(
+      AsSlice(key), AsSlice(nonce), AsSlice(aad), AsSlice(ciphertext),
+      AsMutSlice(base::span(out)));
+  if (!ok) {
+    return std::nullopt;
+  }
+  return out;
+}
+
+}  // namespace phlink::portability
