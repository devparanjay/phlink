+            pub fn rotate_right_const(vec: $vec, n: u32) -> $vec {
+                $vec::new(
+                    vec.0.rotate_right(n),
+                    vec.1.rotate_right(n),
+                    vec.2.rotate_right(n),
+                    vec.3.rotate_right(n),
+                )
+            }
+        }
+    };
+}
