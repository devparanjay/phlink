+++ b/chrome/browser/phlink/portability/phlink_crypto.h
@@ -0,0 +1,53 @@
+// Copyright 2026 The phlink Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_PHLINK_PORTABILITY_PHLINK_CRYPTO_H_
+#define CHROME_BROWSER_PHLINK_PORTABILITY_PHLINK_CRYPTO_H_
+
+#include <array>
+#include <cstdint>
+#include <string_view>
+#include <vector>
+
+#include "base/containers/span.h"
+
+namespace phlink::portability {
+
+// Argon2id parameters used by phlink profile bundles (v1).
+struct KdfParams {
+  uint32_t m_kib = 65536;  // 64 MiB
+  uint32_t t = 3;
+  uint32_t p = 1;
+};
+
+// Default v1 KDF parameters.
+inline constexpr KdfParams kDefaultKdfParams = {};
+
+// Derives a 32-byte key from `passphrase` + `salt` using Argon2id
+// (RFC 9106). Returns `std::nullopt` on parameter rejection.
+[[nodiscard]] std::optional<std::array<uint8_t, 32>> DeriveKey(
+    base::span<const uint8_t> passphrase,
+    base::span<const uint8_t> salt,
+    const KdfParams& params = kDefaultKdfParams);
+
+// XChaCha20-Poly1305 AEAD seal. `key` must be 32 bytes, `nonce` 24 bytes.
+// Returns ciphertext+tag (length = plaintext.size() + 16) on success.
+[[nodiscard]] std::optional<std::vector<uint8_t>> AeadSeal(
+    base::span<const uint8_t> key,
+    base::span<const uint8_t> nonce,
+    base::span<const uint8_t> aad,
+    base::span<const uint8_t> plaintext);
+
+// XChaCha20-Poly1305 AEAD open. `ciphertext` must include trailing tag
+// (‚â•16 bytes). Returns plaintext on success, `std::nullopt` on tag
+// failure (wrong passphrase or tampering) or parameter rejection.
+[[nodiscard]] std::optional<std::vector<uint8_t>> AeadOpen(
+    base::span<const uint8_t> key,
+    base::span<const uint8_t> nonce,
+    base::span<const uint8_t> aad,
+    base::span<const uint8_t> ciphertext);
+
+}  // namespace phlink::portability
+
+#endif  // CHROME_BROWSER_PHLINK_PORTABILITY_PHLINK_CRYPTO_H_
diff --git a/chrome/browser/phlink/portability/phlink_crypto_ffi.rs b/chrome/browser/phlink/portability/phlink_crypto_ffi.rs
new file mode 100644
index 0000000000000..6853edfb7fe15
--- /dev/null
+++ b/chrome/browser/phlink/portability/phlink_crypto_ffi.rs
@@ -0,0 +1,143 @@
+// Copyright 2026 The phlink Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+//
+// Rust‚ÜîC++ bridge for the phlink profile-bundle crypto primitives.
+// See docs/dev/profile-bundle-format.md and Phase 9 plan 09-01.
+
+use argon2::{Algorithm, Argon2, Params, Version};
+use chacha20poly1305::aead::{Aead, KeyInit, Payload};
+use chacha20poly1305::{Key, XChaCha20Poly1305, XNonce};
+use zeroize::Zeroize;
+
+#[cxx::bridge(namespace = "phlink::crypto")]
+mod ffi {
+    // Argon2id parameters. Output `key_out` MUST be exactly 32 bytes.
+    extern "Rust" {
+        // Derive a 32-byte key from `passphrase` + `salt` using Argon2id.
+        // `m_kib`, `t`, `p` map to RFC 9106 m_cost (KiB), t_cost, parallelism.
+        // Returns `true` on success and writes 32 bytes to `key_out`.
+        fn phlink_kdf_argon2id(
+            passphrase: &[u8],
+            salt: &[u8],
+            m_kib: u32,
+            t: u32,
+            p: u32,
+            key_out: &mut [u8],
+        ) -> bool;
+
+        // XChaCha20-Poly1305 seal. `key` MUST be 32 bytes, `nonce` 24 bytes.
+        // Output `out` MUST be `plaintext.len() + 16` bytes (tag appended).
+        fn phlink_aead_seal(
+            key: &[u8],
+            nonce: &[u8],
+            aad: &[u8],
+            plaintext: &[u8],
+            out: &mut [u8],
+        ) -> bool;
+
+        // XChaCha20-Poly1305 open. `key` MUST be 32 bytes, `nonce` 24 bytes.
+        // `ciphertext` includes the trailing 16-byte tag. Output `out` MUST
+        // be `ciphertext.len() - 16` bytes. Returns `true` iff the tag
+        // verifies; on `false` the importer MUST treat the bundle as
+        // corrupt or wrong-passphrase.
+        fn phlink_aead_open(
+            key: &[u8],
+            nonce: &[u8],
+            aad: &[u8],
+            ciphertext: &[u8],
+            out: &mut [u8],
+        ) -> bool;
+    }
+}
+
+fn phlink_kdf_argon2id(
+    passphrase: &[u8],
+    salt: &[u8],
+    m_kib: u32,
+    t: u32,
+    p: u32,
+    key_out: &mut [u8],
+) -> bool {
+    if key_out.len() != 32 {
+        return false;
+    }
+    let params = match Params::new(m_kib, t, p, Some(32)) {
+        Ok(p) => p,
+        Err(_) => return false,
+    };
+    let argon = Argon2::new(Algorithm::Argon2id, Version::V0x13, params);
+    let mut tmp = [0u8; 32];
+    let ok = argon.hash_password_into(passphrase, salt, &mut tmp).is_ok();
+    if ok {
+        key_out.copy_from_slice(&tmp);
+    }
+    tmp.zeroize();
+    ok
+}
+
+fn phlink_aead_seal(
+    key: &[u8],
+    nonce: &[u8],
+    aad: &[u8],
+    plaintext: &[u8],
+    out: &mut [u8],
+) -> bool {
+    if key.len() != 32 || nonce.len() != 24 {
+        return false;
+    }
+    if out.len() != plaintext.len() + 16 {
+        return false;
+    }
+    let cipher = XChaCha20Poly1305::new(Key::from_slice(key));
+    let nonce_obj = XNonce::from_slice(nonce);
+    let payload = Payload {
+        msg: plaintext,
+        aad,
+    };
+    match cipher.encrypt(nonce_obj, payload) {
+        Ok(mut ct) => {
+            if ct.len() != out.len() {
+                ct.zeroize();
+                return false;
+            }
+            out.copy_from_slice(&ct);
+            ct.zeroize();
+            true
+        }
+        Err(_) => false,
+    }
+}
+
+fn phlink_aead_open(
+    key: &[u8],
+    nonce: &[u8],
+    aad: &[u8],
+    ciphertext: &[u8],
+    out: &mut [u8],
+) -> bool {
+    if key.len() != 32 || nonce.len() != 24 || ciphertext.len() < 16 {
+        return false;
+    }
+    if out.len() != ciphertext.len() - 16 {
+        return false;
+    }
+    let cipher = XChaCha20Poly1305::new(Key::from_slice(key));
+    let nonce_obj = XNonce::from_slice(nonce);
+    let payload = Payload {
+        msg: ciphertext,
+        aad,
+    };
+    match cipher.decrypt(nonce_obj, payload) {
+        Ok(mut pt) => {
+            if pt.len() != out.len() {
+                pt.zeroize();
+                return false;
+            }
+            out.copy_from_slice(&pt);
+            pt.zeroize();
+            true
+        }
+        Err(_) => false,
+    }
+}
diff --git a/chrome/browser/phlink/portability/phlink_crypto_unittest.cc b/chrome/browser/phlink/portability/phlink_crypto_unittest.cc
new file mode 100644
index 0000000000000..4e00c3c134916
--- /dev/null
+++ b/chrome/browser/phlink/portability/phlink_crypto_unittest.cc
@@ -0,0 +1,83 @@
+// Copyright 2026 The phlink Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/phlink/portability/phlink_crypto.h"
+
+#include <array>
+#include <vector>
+
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace phlink::portability {
+namespace {
+
+// AEAD round-trip: seal then open returns the original plaintext, and a
+// flipped-tag attack is rejected.
+TEST(PhlinkCryptoTest, XChaCha20Poly1305RoundTrip) {
+  std::array<uint8_t, 32> key{};
+  std::array<uint8_t, 24> nonce{};
+  for (size_t i = 0; i < key.size(); ++i) {
+    key[i] = static_cast<uint8_t>(i);
+  }
+  for (size_t i = 0; i < nonce.size(); ++i) {
+    nonce[i] = static_cast<uint8_t>(0x40 + i);
+  }
+  const std::string aad_str = "phlink-bundle-v1";
+  const std::string plaintext_str = "the quick brown fox jumps over the lazy dog";
+  base::span<const uint8_t> aad(reinterpret_cast<const uint8_t*>(aad_str.data()),
+                                aad_str.size());
+  base::span<const uint8_t> plaintext(
+      reinterpret_cast<const uint8_t*>(plaintext_str.data()),
+      plaintext_str.size());
+
+  auto sealed = AeadSeal(key, nonce, aad, plaintext);
+  ASSERT_TRUE(sealed.has_value());
+  ASSERT_EQ(sealed->size(), plaintext.size() + 16);
+
+  auto opened = AeadOpen(key, nonce, aad, *sealed);
+  ASSERT_TRUE(opened.has_value());
+  ASSERT_EQ(opened->size(), plaintext.size());
+  EXPECT_TRUE(std::equal(opened->begin(), opened->end(), plaintext.begin()));
+
+  // Tag tamper ‚Üí reject.
+  std::vector<uint8_t> tampered = *sealed;
+  tampered.back() ^= 0x01;
+  EXPECT_FALSE(AeadOpen(key, nonce, aad, tampered).has_value());
+
+  // AAD tamper ‚Üí reject.
+  std::string bad_aad_str = "phlink-bundle-v2";
+  base::span<const uint8_t> bad_aad(
+      reinterpret_cast<const uint8_t*>(bad_aad_str.data()), bad_aad_str.size());
+  EXPECT_FALSE(AeadOpen(key, nonce, bad_aad, *sealed).has_value());
+}
+
+// Argon2id determinism + same-input-same-output.
+TEST(PhlinkCryptoTest, Argon2idDeterministic) {
+  const std::string pass_str = "correct horse battery staple";
+  const std::string salt_str = "phlink-salt-1234";  // 16 bytes
+  base::span<const uint8_t> passphrase(
+      reinterpret_cast<const uint8_t*>(pass_str.data()), pass_str.size());
+  base::span<const uint8_t> salt(
+      reinterpret_cast<const uint8_t*>(salt_str.data()), salt_str.size());
+
+  // Use lowered cost params for unit-test speed.
+  KdfParams fast{.m_kib = 8 * 1024, .t = 2, .p = 1};
+
+  auto k1 = DeriveKey(passphrase, salt, fast);
+  auto k2 = DeriveKey(passphrase, salt, fast);
+  ASSERT_TRUE(k1.has_value());
+  ASSERT_TRUE(k2.has_value());
+  EXPECT_EQ(*k1, *k2);
+
+  // Different passphrase ‚Üí different key.
+  const std::string other_str = "incorrect horse battery staple";
+  base::span<const uint8_t> other_pass(
+      reinterpret_cast<const uint8_t*>(other_str.data()), other_str.size());
+  auto k3 = DeriveKey(other_pass, salt, fast);
+  ASSERT_TRUE(k3.has_value());
+  EXPECT_NE(*k1, *k3);
+}
+
+}  // namespace
+}  // namespace phlink::portability
