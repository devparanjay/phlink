+
+    /// Pad input and encrypt. Returns resulting ciphertext slice.
+    ///
+    /// Returns [`PadError`] if length of output buffer is not sufficient.
+    #[cfg(feature = "block-padding")]
+    #[cfg_attr(docsrs, doc(cfg(feature = "block-padding")))]
