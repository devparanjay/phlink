+
+import("//build/rust/rust_static_library.gni")
+import("//testing/test.gni")
+
+# Rust‚ÜîC++ bridge over the vendored Argon2id + XChaCha20-Poly1305 crates.
+# See docs/dev/profile-bundle-format.md and Phase 9 plan 09-01.
+rust_static_library("phlink_crypto_ffi") {
+  allow_unsafe = true  # cxx underpinning.
+  crate_root = "phlink_crypto_ffi.rs"
+  sources = [ "phlink_crypto_ffi.rs" ]
+  cxx_bindings = [ "phlink_crypto_ffi.rs" ]
+  visibility = [ ":*" ]
+  deps = [
+    "//third_party/rust/argon2/v0_5:lib",
+    "//third_party/rust/chacha20poly1305/v0_10:lib",
+    "//third_party/rust/zeroize/v1:lib",
+  ]
+}
+
+# C++ surface. Plans 09-02 / 09-03 layer BundleWriter / BundleReader on top.
+source_set("phlink_crypto") {
+  sources = [
+    "phlink_crypto.cc",
+    "phlink_crypto.h",
+  ]
+  public_deps = [ ":phlink_crypto_ffi" ]
+  deps = [ "//base" ]
+}
+
+source_set("unit_tests") {
+  testonly = true
+  sources = [ "phlink_crypto_unittest.cc" ]
