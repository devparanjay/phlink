+    let hash = "$argon2i$p=2,m=256,t=2$c29tZXNhbHQ$tsEVYKap1h6scGt5ovl9aLRGOqOth+AMB+KwHpDFZPs";
+    let hash = PasswordHash::new(hash).unwrap();
+    assert!(Argon2::default()
+        .verify_password(b"password", &hash)
