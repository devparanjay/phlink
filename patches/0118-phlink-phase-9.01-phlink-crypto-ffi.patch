+        // v2 = [
+        //     [0; 7] || 1 || [0; 31] || 1 || b33[32..8],
+        //     [0; 7] || 1 || [0; 31] || 1 || b23[32..8],
+        //     [0; 7] || 1 || [0; 31] || 1 || b13[32..8],
+        //     [0; 7] || 1 || [0; 31] || 1 || b03[32..8],
