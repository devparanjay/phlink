+where
+    UInt<Ul, Bl>: PrivateXor<Ur>,
+    PrivateXorOut<UInt<Ul, Bl>, Ur>: Trim,
+{
+    type Output = TrimOut<PrivateXorOut<UInt<Ul, Bl>, Ur>>;
+    #[inline]
+    fn bitxor(self, rhs: Ur) -> Self::Output {
+        self.private_xor(rhs).trim()
+    }
+}
