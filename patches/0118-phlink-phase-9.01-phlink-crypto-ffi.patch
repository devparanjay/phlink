+/// Length of `UTerm` by itself is 0
+impl Len for UTerm {
+    type Output = U0;
+    #[inline]
+    fn len(&self) -> Self::Output {
+        UTerm
+    }
+}
+
+/// Length of a bit is 1
+impl<U: Unsigned, B: Bit> Len for UInt<U, B>
+where
+    U: Len,
