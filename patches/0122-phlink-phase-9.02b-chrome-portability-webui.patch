diff --git a/chrome/browser/resources/portability/app.ts b/chrome/browser/resources/portability/app.ts
new file mode 100644
index 0000000000000..4652e5c42464f
--- /dev/null
+++ b/chrome/browser/resources/portability/app.ts
@@ -0,0 +1,98 @@
+// Copyright 2026 The phlink Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+import 'chrome://resources/cr_elements/cr_button/cr_button.js';
+import 'chrome://resources/cr_elements/cr_input/cr_input.js';
+
+import {CrLitElement} from 'chrome://resources/lit/v3_0/lit.rollup.js';
+
+import {getCss} from './app.css.js';
+import {getHtml} from './app.html.js';
+import {getExporter} from './browser_proxy.js';
+import {ExportStatus} from './portability.mojom-webui.js';
+
+export class AppElement extends CrLitElement {
+  static get is() {
+    return 'portability-app';
+  }
+
+  static override get styles() {
+    return getCss();
+  }
+
+  override render() {
+    return getHtml.bind(this)();
+  }
+
+  static override get properties() {
+    return {
+      passphrase_: {type: String},
+      confirm_: {type: String},
+      busy_: {type: Boolean, reflect: true},
+      lastStatus_: {type: String},
+      lastPath_: {type: String},
+    };
+  }
+
+  protected accessor passphrase_: string = '';
+  protected accessor confirm_: string = '';
+  protected accessor busy_: boolean = false;
+  protected accessor lastStatus_: string = '';
+  protected accessor lastPath_: string = '';
+
+  protected onPassphraseValueChanged_(e: CustomEvent<{value: string}>) {
+    this.passphrase_ = e.detail.value;
+  }
+
+  protected onConfirmValueChanged_(e: CustomEvent<{value: string}>) {
+    this.confirm_ = e.detail.value;
+  }
+
+  protected canExport_(): boolean {
+    return !this.busy_ && this.passphrase_.length > 0 &&
+        this.passphrase_ === this.confirm_;
+  }
+
+  protected async onExportClick_() {
+    if (!this.canExport_()) {
+      return;
+    }
+    this.busy_ = true;
+    this.lastStatus_ = '';
+    this.lastPath_ = '';
+    try {
+      const {status, path} = await getExporter().exportToPickedFile(
+          this.passphrase_);
+      this.lastStatus_ = this.statusToString_(status);
+      this.lastPath_ = path.path || '';
+    } finally {
+      this.busy_ = false;
+      this.passphrase_ = '';
+      this.confirm_ = '';
+    }
+  }
+
+  private statusToString_(status: ExportStatus): string {
+    switch (status) {
+      case ExportStatus.kOk:
+        return 'Export complete.';
+      case ExportStatus.kBadPassphrase:
+        return 'Passphrase rejected.';
+      case ExportStatus.kCodecFailure:
+        return 'Bundle codec failed.';
+      case ExportStatus.kIoFailure:
+        return 'Cancelled or filesystem write failed.';
+      default:
+        return 'Unknown error.';
+    }
+  }
+}
+
+declare global {
+  interface HTMLElementTagNameMap {
+    'portability-app': AppElement;
+  }
+}
+
+customElements.define(AppElement.is, AppElement);
