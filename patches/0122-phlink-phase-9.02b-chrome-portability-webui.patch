@@ -0,0 +1,46 @@
+// Copyright 2026 The phlink Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_WEBUI_PORTABILITY_PORTABILITY_UI_H_
+#define CHROME_BROWSER_UI_WEBUI_PORTABILITY_PORTABILITY_UI_H_
+
+#include <memory>
+
+#include "chrome/browser/phlink/portability/portability.mojom.h"
+#include "chrome/common/webui_url_constants.h"
+#include "content/public/browser/internal_webui_config.h"
+#include "mojo/public/cpp/bindings/pending_receiver.h"
+#include "ui/webui/mojo_web_ui_controller.h"
+
+namespace phlink::portability {
+class ExporterImpl;
+}  // namespace phlink::portability
+
+class PortabilityUI;
+
+class PortabilityUIConfig
+    : public content::DefaultInternalWebUIConfig<PortabilityUI> {
+ public:
+  PortabilityUIConfig()
+      : DefaultInternalWebUIConfig(chrome::kChromeUIPortabilityHost) {}
+};
+
+// Controller for chrome://portability — phlink's profile export/import UI.
+class PortabilityUI : public ui::MojoWebUIController {
+ public:
+  explicit PortabilityUI(content::WebUI* web_ui);
+  PortabilityUI(const PortabilityUI&) = delete;
+  PortabilityUI& operator=(const PortabilityUI&) = delete;
+  ~PortabilityUI() override;
+
+  void BindInterface(
+      mojo::PendingReceiver<phlink::portability::mojom::Exporter> receiver);
+
+ private:
+  std::unique_ptr<phlink::portability::ExporterImpl> exporter_;
+
+  WEB_UI_CONTROLLER_TYPE_DECL();
+};
+
+#endif  // CHROME_BROWSER_UI_WEBUI_PORTABILITY_PORTABILITY_UI_H_
