diff --git a/chrome/browser/phlink/portability/exporter_impl.cc b/chrome/browser/phlink/portability/exporter_impl.cc
new file mode 100644
index 0000000000000..8432e3916a3d8
--- /dev/null
+++ b/chrome/browser/phlink/portability/exporter_impl.cc
@@ -0,0 +1,158 @@
+// Copyright 2026 The phlink Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/phlink/portability/exporter_impl.h"
+
+#include <string>
+#include <utility>
+
+#include "base/functional/bind.h"
+#include "base/task/task_traits.h"
+#include "base/task/thread_pool.h"
+#include "chrome/browser/phlink/portability/export_service.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/select_file_policy/chrome_select_file_policy.h"
+#include "content/public/browser/browser_thread.h"
+#include "content/public/browser/web_contents.h"
+#include "ui/shell_dialogs/select_file_dialog.h"
+#include "ui/shell_dialogs/selected_file_info.h"
+
+namespace phlink::portability {
+namespace {
+
+mojom::ExportStatus ToMojom(ExportStatus s) {
+  switch (s) {
+    case ExportStatus::kOk:
+      return mojom::ExportStatus::kOk;
+    case ExportStatus::kCodecFailure:
+      return mojom::ExportStatus::kCodecFailure;
+    case ExportStatus::kIoFailure:
+      return mojom::ExportStatus::kIoFailure;
+    case ExportStatus::kBadPassphrase:
+      return mojom::ExportStatus::kBadPassphrase;
+  }
+}
+
+ExportStatus RunExportOnWorker(base::FilePath profile_dir,
+                               base::FilePath dest,
+                               std::string passphrase) {
+  return ExportProfileToBundle(profile_dir, dest, passphrase);
+}
+
+}  // namespace
+
+ExporterImpl::ExporterImpl(content::WebContents* web_contents,
+                           mojo::PendingReceiver<mojom::Exporter> receiver)
+    : content::WebContentsObserver(web_contents),
+      receiver_(this, std::move(receiver)) {
+  Profile* profile =
+      Profile::FromBrowserContext(web_contents->GetBrowserContext());
+  profile_dir_ = profile->GetPath();
+}
+
+ExporterImpl::~ExporterImpl() {
+  if (select_file_dialog_) {
+    select_file_dialog_->ListenerDestroyed();
+  }
+  if (pending_picker_callback_) {
+    std::move(pending_picker_callback_)
+        .Run(mojom::ExportStatus::kIoFailure, base::FilePath());
+  }
+}
+
+void ExporterImpl::ObserveProgress(
+    mojo::PendingRemote<mojom::ProgressObserver> observer) {
+  progress_observer_.reset();
+  progress_observer_.Bind(std::move(observer));
+}
+
+void ExporterImpl::Export(const std::string& passphrase,
+                          const base::FilePath& path,
+                          ExportCallback callback) {
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE,
+      {base::MayBlock(), base::TaskPriority::USER_BLOCKING,
+       base::TaskShutdownBehavior::SKIP_ON_SHUTDOWN},
+      base::BindOnce(&RunExportOnWorker, profile_dir_, path, passphrase),
+      base::BindOnce(
+          [](ExportCallback cb, ExportStatus s) {
+            std::move(cb).Run(ToMojom(s));
+          },
+          std::move(callback)));
+}
+
+void ExporterImpl::ExportToPickedFile(const std::string& passphrase,
+                                      ExportToPickedFileCallback callback) {
+  if (pending_picker_callback_) {
+    // Reject overlapping picks.
+    std::move(callback).Run(mojom::ExportStatus::kIoFailure, base::FilePath());
+    return;
+  }
+  if (passphrase.empty()) {
+    std::move(callback).Run(mojom::ExportStatus::kBadPassphrase,
+                            base::FilePath());
+    return;
+  }
+
+  content::WebContents* wc = web_contents();
+  if (!wc) {
+    std::move(callback).Run(mojom::ExportStatus::kIoFailure, base::FilePath());
+    return;
+  }
+
+  pending_picker_callback_ = std::move(callback);
+  pending_passphrase_ = passphrase;
+
+  select_file_dialog_ = ui::SelectFileDialog::Create(
+      this, std::make_unique<ChromeSelectFilePolicy>(wc));
+  ui::SelectFileDialog::FileTypeInfo file_types;
+  file_types.extensions = {{FILE_PATH_LITERAL("phlinkbundle")}};
+  file_types.include_all_files = true;
+
+  base::FilePath default_path =
+      base::FilePath(FILE_PATH_LITERAL("phlink-profile.phlinkbundle"));
+
+  select_file_dialog_->SelectFile(
+      ui::SelectFileDialog::SELECT_SAVEAS_FILE,
+      /*title=*/std::u16string(), default_path, &file_types,
+      /*file_type_index=*/1, FILE_PATH_LITERAL("phlinkbundle"),
+      wc->GetTopLevelNativeWindow());
+}
+
+void ExporterImpl::FileSelected(const ui::SelectedFileInfo& file, int index) {
+  select_file_dialog_.reset();
+  base::FilePath path = file.path();
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE,
+      {base::MayBlock(), base::TaskPriority::USER_BLOCKING,
+       base::TaskShutdownBehavior::SKIP_ON_SHUTDOWN},
+      base::BindOnce(&RunExportOnWorker, profile_dir_, path,
+                     std::move(pending_passphrase_)),
+      base::BindOnce(
+          [](base::WeakPtr<ExporterImpl> self, base::FilePath p,
+             ExportStatus s) {
+            if (self) {
+              self->OnPickedExportFinished(std::move(p), ToMojom(s));
+            }
+          },
+          weak_factory_.GetWeakPtr(), path));
+}
+
+void ExporterImpl::FileSelectionCanceled() {
+  select_file_dialog_.reset();
+  pending_passphrase_.clear();
+  if (pending_picker_callback_) {
+    std::move(pending_picker_callback_)
+        .Run(mojom::ExportStatus::kIoFailure, base::FilePath());
+  }
+}
+
+void ExporterImpl::OnPickedExportFinished(base::FilePath path,
+                                          mojom::ExportStatus status) {
+  if (pending_picker_callback_) {
+    std::move(pending_picker_callback_).Run(status, path);
+  }
+}
+
+}  // namespace phlink::portability
