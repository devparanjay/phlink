+// Copyright 2026 The phlink Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_PHLINK_PORTABILITY_EXPORTER_IMPL_H_
+#define CHROME_BROWSER_PHLINK_PORTABILITY_EXPORTER_IMPL_H_
+
+#include <string>
+
+#include "base/files/file_path.h"
+#include "base/memory/weak_ptr.h"
+#include "chrome/browser/phlink/portability/portability.mojom.h"
+#include "content/public/browser/web_contents_observer.h"
+#include "mojo/public/cpp/bindings/pending_receiver.h"
+#include "mojo/public/cpp/bindings/pending_remote.h"
+#include "mojo/public/cpp/bindings/receiver.h"
+#include "mojo/public/cpp/bindings/remote.h"
+#include "ui/shell_dialogs/select_file_dialog.h"
+
+namespace content {
+class WebContents;
+}  // namespace content
+
+namespace phlink::portability {
+
+// Browser-process implementation of `phlink.portability.mojom.Exporter`,
+// backed by `ExportProfileToBundle`. One instance per chrome://portability
+// WebUI tab; lifetime is bounded by the mojo receiver pipe.
+class ExporterImpl : public mojom::Exporter,
+                     public ui::SelectFileDialog::Listener,
+                     public content::WebContentsObserver {
+ public:
+  ExporterImpl(content::WebContents* web_contents,
+               mojo::PendingReceiver<mojom::Exporter> receiver);
+  ExporterImpl(const ExporterImpl&) = delete;
+  ExporterImpl& operator=(const ExporterImpl&) = delete;
+  ~ExporterImpl() override;
+
+  // mojom::Exporter:
+  void ObserveProgress(
+      mojo::PendingRemote<mojom::ProgressObserver> observer) override;
+  void Export(const std::string& passphrase,
+              const base::FilePath& path,
+              ExportCallback callback) override;
+  void ExportToPickedFile(const std::string& passphrase,
+                          ExportToPickedFileCallback callback) override;
+
+  // ui::SelectFileDialog::Listener:
+  void FileSelected(const ui::SelectedFileInfo& file, int index) override;
+  void FileSelectionCanceled() override;
+
+ private:
+  void OnPickedExportFinished(base::FilePath path,
+                              mojom::ExportStatus status);
+
+  base::FilePath profile_dir_;
+  mojo::Receiver<mojom::Exporter> receiver_;
+  mojo::Remote<mojom::ProgressObserver> progress_observer_;
+
+  // State for the in-flight ExportToPickedFile round-trip.
+  scoped_refptr<ui::SelectFileDialog> select_file_dialog_;
+  ExportToPickedFileCallback pending_picker_callback_;
+  std::string pending_passphrase_;
+
+  base::WeakPtrFactory<ExporterImpl> weak_factory_{this};
+};
+
+}  // namespace phlink::portability
+
+#endif  // CHROME_BROWSER_PHLINK_PORTABILITY_EXPORTER_IMPL_H_
