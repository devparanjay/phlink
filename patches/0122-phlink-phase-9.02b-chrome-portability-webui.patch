@@ -0,0 +1,58 @@
+// Copyright 2026 The phlink Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/webui/portability/portability_ui.h"
+
+#include "chrome/browser/phlink/portability/exporter_impl.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/grit/portability_resources.h"
+#include "chrome/grit/portability_resources_map.h"
+#include "content/public/browser/web_contents.h"
+#include "content/public/browser/web_ui.h"
+#include "content/public/browser/web_ui_data_source.h"
+#include "ui/webui/webui_util.h"
+
+PortabilityUI::PortabilityUI(content::WebUI* web_ui)
+    : ui::MojoWebUIController(web_ui) {
+  Profile* profile = Profile::FromWebUI(web_ui);
+  content::WebUIDataSource* source = content::WebUIDataSource::CreateAndAdd(
+      profile, chrome::kChromeUIPortabilityHost);
+
+  static constexpr struct {
+    const char* name;
+    const char* value;
+  } kStrings[] = {
+      {"title", "phlink Profile Portability"},
+      {"description",
+       "Export your phlink profile to an encrypted bundle, or import a "
+       "previously exported bundle."},
+      {"exportHeading", "Export"},
+      {"exportBlurb",
+       "Pack your bookmarks, preferences, and history into a single sealed "
+       "file. The bundle is encrypted with your passphrase using Argon2id and "
+       "XChaCha20-Poly1305."},
+      {"includesSummary", "What's included"},
+      {"passphraseLabel", "Passphrase"},
+      {"confirmLabel", "Confirm passphrase"},
+      {"exportButton", "Save bundle…"},
+      {"importHeading", "Import"},
+      {"importBlurb", "Import support is coming in a follow-up release."},
+  };
+  for (const auto& s : kStrings) {
+    source->AddString(s.name, s.value);
+  }
+
+  webui::SetupWebUIDataSource(source, kPortabilityResources,
+                              IDR_PORTABILITY_PORTABILITY_HTML);
+}
+
+PortabilityUI::~PortabilityUI() = default;
+
+void PortabilityUI::BindInterface(
+    mojo::PendingReceiver<phlink::portability::mojom::Exporter> receiver) {
+  exporter_ = std::make_unique<phlink::portability::ExporterImpl>(
+      web_ui()->GetWebContents(), std::move(receiver));
+}
+
+WEB_UI_CONTROLLER_TYPE_IMPL(PortabilityUI)
diff --git a/chrome/browser/ui/webui/portability/portability_ui.h b/chrome/browser/ui/webui/portability/portability_ui.h
