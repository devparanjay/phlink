   Export(string passphrase, mojo_base.mojom.FilePath path)
       => (ExportStatus status);
+
+  // Convenience entry point for the chrome://portability WebUI: opens
+  // the platform Save-As dialog (anchored to the WebUI's window),
+  // then runs the same export. If the user cancels, replies with
+  // `kIoFailure` and `path` empty. The picked path is returned so the
+  // UI can display it (the WebUI never invents filenames).
+  ExportToPickedFile(string passphrase)
+      => (ExportStatus status, mojo_base.mojom.FilePath path);
 };
