diff --git a/chrome/browser/phlink/portability/export_service.cc b/chrome/browser/phlink/portability/export_service.cc
new file mode 100644
index 0000000000000..cb725547ab20e
--- /dev/null
+++ b/chrome/browser/phlink/portability/export_service.cc
@@ -0,0 +1,57 @@
+// Copyright 2026 The phlink Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/phlink/portability/export_service.h"
+
+#include <string>
+#include <vector>
+
+#include "base/files/file_util.h"
+#include "chrome/browser/phlink/portability/bundle_writer.h"
+
+namespace phlink::portability {
+
+ExportStatus ExportProfileToBundle(const base::FilePath& profile_dir,
+                                   const base::FilePath& dest_path,
+                                   std::string_view passphrase) {
+  std::vector<std::string> include_list;
+  for (const char* name : kDefaultIncludeList) {
+    include_list.emplace_back(name);
+  }
+  return ExportProfileToBundleWithIncludeList(profile_dir, dest_path,
+                                              passphrase, include_list);
+}
+
+ExportStatus ExportProfileToBundleWithIncludeList(
+    const base::FilePath& profile_dir,
+    const base::FilePath& dest_path,
+    std::string_view passphrase,
+    const std::vector<std::string>& include_list) {
+  if (passphrase.empty()) {
+    return ExportStatus::kBadPassphrase;
+  }
+
+  BundleWriter writer;
+  for (const std::string& name : include_list) {
+    base::FilePath src = profile_dir.AppendASCII(name);
+    std::string contents;
+    if (!base::ReadFileToString(src, &contents)) {
+      // Missing file is OK — Chromium does not always create every file
+      // in every profile (e.g. an empty profile may not have History).
+      continue;
+    }
+    base::span<const uint8_t> bytes(
+        reinterpret_cast<const uint8_t*>(contents.data()), contents.size());
+    if (!writer.AddFile(name, bytes)) {
+      return ExportStatus::kCodecFailure;
+    }
+  }
+
+  if (!writer.WriteToFile(dest_path, passphrase)) {
+    return ExportStatus::kIoFailure;
+  }
+  return ExportStatus::kOk;
+}
+
+}  // namespace phlink::portability
