new file mode 100644
index 0000000000000..41b429d290b52
--- /dev/null
+++ b/chrome/browser/phlink/portability/portability.mojom
@@ -0,0 +1,45 @@
+// Copyright 2026 The phlink Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// WebUI ↔ browser plumbing for phlink's profile portability surface
+// (chrome://settings/portability and the phlink:// alias).
+//
+// All bundle codec work stays in the browser process; the WebUI never
+// sees the user passphrase after handing it to `Export` / `Import`,
+// and never sees the derived AEAD key at all.
+module phlink.portability.mojom;
+
+import "mojo/public/mojom/base/file_path.mojom";
+
+// Mirrors phlink::portability::ExportStatus in C++.
+enum ExportStatus {
+  kOk,
+  // Bundle codec failed (out of memory, KDF rejection, AEAD seal error).
+  kCodecFailure,
+  // Filesystem write failed (permissions, full disk, …).
+  kIoFailure,
+  // The supplied passphrase was empty or malformed.
+  kBadPassphrase,
+};
+
+// One-shot progress notification from the export worker.
+interface ProgressObserver {
+  // `percent` ∈ [0, 100]. `step_name` is a stable English identifier
+  // (e.g. "snapshot_history", "build_tar", "encrypt", "write") so the
+  // WebUI can localize via its own message catalog.
+  OnProgress(uint32 percent, string step_name);
+};
+
+// Browser-side service driving a single `.phlinkbundle` export.
+//
+// Lifetime: created per WebUI binding. Cancelled on disconnect.
+interface Exporter {
+  // Streams progress updates while the export runs.
+  ObserveProgress(pending_remote<ProgressObserver> observer);
+
+  // Writes the bundle to `path` using `passphrase` for KDF + AEAD.
+  // Replies once the file is fully on disk (or a failure occurred).
+  Export(string passphrase, mojo_base.mojom.FilePath path)
+      => (ExportStatus status);
+};
