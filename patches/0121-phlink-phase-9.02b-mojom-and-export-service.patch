+// Copyright 2026 The phlink Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_PHLINK_PORTABILITY_EXPORT_SERVICE_H_
+#define CHROME_BROWSER_PHLINK_PORTABILITY_EXPORT_SERVICE_H_
+
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include "base/files/file_path.h"
+
+namespace phlink::portability {
+
+enum class ExportStatus {
+  kOk,
+  kCodecFailure,
+  kIoFailure,
+  kBadPassphrase,
+};
+
+// Default v1 include-list per CONTEXT D-04 + format spec §5.
+// Any entry that is missing from `profile_dir` is silently skipped
+// (Chromium does not always create every file in every profile until
+// first use; missing != error).
+inline constexpr const char* const kDefaultIncludeList[] = {
+    "Bookmarks",
+    "Preferences",
+    "History",
+    "Web Data",
+};
+
+// Collects the default include-list from `profile_dir`, packs it into a
+// `.phlinkbundle` via `BundleWriter`, and writes the result to
+// `dest_path`. Blocking — call on a `base::ThreadPool` worker.
+//
+// `profile_dir` is the directory that contains files like `Bookmarks`
+// (typically `Profile->GetPath()` from a `Profile*`). The service does
+// **not** depend on `Profile` so it stays unit-testable without a
+// `TestingProfile`.
+ExportStatus ExportProfileToBundle(const base::FilePath& profile_dir,
+                                   const base::FilePath& dest_path,
+                                   std::string_view passphrase);
+
+// Same as above, but the caller chooses the include-list (used by tests
+// and by 09-03b's round-trip browser-test).
+ExportStatus ExportProfileToBundleWithIncludeList(
+    const base::FilePath& profile_dir,
+    const base::FilePath& dest_path,
+    std::string_view passphrase,
+    const std::vector<std::string>& include_list);
+
+}  // namespace phlink::portability
+
+#endif  // CHROME_BROWSER_PHLINK_PORTABILITY_EXPORT_SERVICE_H_
