--- /dev/null
+++ b/chrome/browser/phlink/portability/export_service_unittest.cc
@@ -0,0 +1,54 @@
+// Copyright 2026 The phlink Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/phlink/portability/export_service.h"
+
+#include <string>
+
+#include "base/files/file_util.h"
+#include "base/files/scoped_temp_dir.h"
+#include "chrome/browser/phlink/portability/bundle_reader.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace phlink::portability {
+namespace {
+
+TEST(ExportServiceTest, EmptyPassphraseRejected) {
+  base::ScopedTempDir tmp;
+  ASSERT_TRUE(tmp.CreateUniqueTempDir());
+  base::FilePath dest = tmp.GetPath().AppendASCII("out.phlinkbundle");
+  EXPECT_EQ(ExportProfileToBundle(tmp.GetPath(), dest, ""),
+            ExportStatus::kBadPassphrase);
+  EXPECT_FALSE(base::PathExists(dest));
+}
+
+TEST(ExportServiceTest, RoundTripFromTempProfileDir) {
+  base::ScopedTempDir profile;
+  ASSERT_TRUE(profile.CreateUniqueTempDir());
+  ASSERT_TRUE(base::WriteFile(profile.GetPath().AppendASCII("Bookmarks"),
+                              "{\"roots\":\"x\"}"));
+  ASSERT_TRUE(base::WriteFile(profile.GetPath().AppendASCII("Preferences"),
+                              "{\"theme\":\"dark\"}"));
+  // Web Data + History intentionally missing — service must skip them.
+
+  base::ScopedTempDir out;
+  ASSERT_TRUE(out.CreateUniqueTempDir());
+  base::FilePath dest = out.GetPath().AppendASCII("out.phlinkbundle");
+
+  ASSERT_EQ(ExportProfileToBundle(profile.GetPath(), dest, "pw"),
+            ExportStatus::kOk);
+  ASSERT_TRUE(base::PathExists(dest));
+
+  BundleReader reader;
+  ASSERT_EQ(reader.OpenFile(dest, "pw"), BundleReader::Status::kOk);
+  const auto& entries = reader.Entries();
+  EXPECT_EQ(entries.size(), 2u);
+  ASSERT_TRUE(entries.count("Bookmarks"));
+  ASSERT_TRUE(entries.count("Preferences"));
+  EXPECT_EQ(0u, entries.count("History"));
+  EXPECT_EQ(0u, entries.count("Web Data"));
+}
+
+}  // namespace
+}  // namespace phlink::portability
