+// Copyright 2026 The phlink Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_PHLINK_APPEARANCE_PHLINK_APPEARANCE_PREFS_H_
+#define CHROME_BROWSER_PHLINK_APPEARANCE_PHLINK_APPEARANCE_PREFS_H_
+
+namespace user_prefs {
+class PrefRegistrySyncable;
+}  // namespace user_prefs
+
+namespace phlink::appearance {
+
+// Integer. Selected phlink theme mode.
+//   0 = Light
+//   1 = Dark
+//   2 = Follow System (default per Phase 8 D-04 / D-06)
+// Any out-of-range value is treated as 2 (Follow System).
+inline constexpr char kAppearanceMode[] = "phlink.appearance_mode";
+
+// Pref values. Kept in lock-step with `kAppearanceMode` semantics.
+inline constexpr int kAppearanceModeLight = 0;
+inline constexpr int kAppearanceModeDark = 1;
+inline constexpr int kAppearanceModeFollowSystem = 2;
+
+// Registers the phlink-appearance profile prefs with their defaults.
+// Called from `chrome/browser/prefs/browser_prefs.cc::RegisterProfilePrefs`.
+void RegisterProfilePrefs(user_prefs::PrefRegistrySyncable* registry);
+
+}  // namespace phlink::appearance
+
+#endif  // CHROME_BROWSER_PHLINK_APPEARANCE_PHLINK_APPEARANCE_PREFS_H_
