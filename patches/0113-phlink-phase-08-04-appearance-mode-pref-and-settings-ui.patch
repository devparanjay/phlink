+++ b/chrome/browser/themes/phlink_appearance_observer.h
@@ -0,0 +1,64 @@
+// Copyright 2026 The phlink Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_THEMES_PHLINK_APPEARANCE_OBSERVER_H_
+#define CHROME_BROWSER_THEMES_PHLINK_APPEARANCE_OBSERVER_H_
+
+#include "base/memory/raw_ptr.h"
+#include "base/scoped_observation.h"
+#include "components/keyed_service/core/keyed_service.h"
+#include "components/prefs/pref_change_registrar.h"
+#include "ui/native_theme/native_theme.h"
+#include "ui/native_theme/native_theme_observer.h"
+
+class Profile;
+
+namespace phlink::appearance {
+
+// Bridges the integer pref `phlink.appearance_mode` to the chrome-side color
+// system (Phase 8 D-04, D-10).
+//
+// Subscribes to:
+//   * PrefChangeRegistrar on `kAppearanceMode` — user-driven changes from
+//     chrome://settings/appearance.
+//   * ui::NativeTheme — OS-level dark-mode flips, only relevant when the
+//     pref is set to Follow System (default).
+//
+// On any actionable change, calls
+// `ui::ColorProviderManager::Get().ResetColorProviderCache()` and asks every
+// open browser window for this profile to rebuild its views. Per Phase 8
+// CONTEXT §5 (carry-forward from Phase 6), no UMA / UKM / log-to-disk happens
+// on theme switches — this is a hard constraint.
+class PhlinkAppearanceObserver : public KeyedService,
+                                 public ui::NativeThemeObserver {
+ public:
+  explicit PhlinkAppearanceObserver(Profile* profile);
+
+  PhlinkAppearanceObserver(const PhlinkAppearanceObserver&) = delete;
+  PhlinkAppearanceObserver& operator=(const PhlinkAppearanceObserver&) = delete;
+
+  ~PhlinkAppearanceObserver() override;
+
+  // ui::NativeThemeObserver:
+  void OnNativeThemeUpdated(ui::NativeTheme* observed_theme) override;
+
+  // Test seam — observer keeps a monotonically increasing counter so unit
+  // tests can assert that `Invalidate()` fired exactly N times without
+  // standing up a real BrowserView.
+  int invalidation_count_for_testing() const { return invalidation_count_; }
+
+ private:
+  void OnPrefChanged();
+  void Invalidate();
+
+  raw_ptr<Profile> profile_;
+  PrefChangeRegistrar pref_change_registrar_;
+  base::ScopedObservation<ui::NativeTheme, ui::NativeThemeObserver>
+      theme_observation_{this};
+  int invalidation_count_ = 0;
+};
+
+}  // namespace phlink::appearance
+
+#endif  // CHROME_BROWSER_THEMES_PHLINK_APPEARANCE_OBSERVER_H_
