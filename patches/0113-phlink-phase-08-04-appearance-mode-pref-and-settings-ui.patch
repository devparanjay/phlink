diff --git a/chrome/browser/themes/phlink_appearance_observer.cc b/chrome/browser/themes/phlink_appearance_observer.cc
new file mode 100644
index 0000000000000..cc3c7c967d53e
--- /dev/null
+++ b/chrome/browser/themes/phlink_appearance_observer.cc
@@ -0,0 +1,59 @@
+// Copyright 2026 The phlink Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/themes/phlink_appearance_observer.h"
+
+#include "base/functional/bind.h"
+#include "chrome/browser/phlink/appearance/phlink_appearance_prefs.h"
+#include "chrome/browser/profiles/profile.h"
+#include "components/prefs/pref_service.h"
+#include "ui/color/color_provider_manager.h"
+
+namespace phlink::appearance {
+
+PhlinkAppearanceObserver::PhlinkAppearanceObserver(Profile* profile)
+    : profile_(profile) {
+  pref_change_registrar_.Init(profile_->GetPrefs());
+  pref_change_registrar_.Add(
+      kAppearanceMode,
+      base::BindRepeating(&PhlinkAppearanceObserver::OnPrefChanged,
+                          base::Unretained(this)));
+  if (auto* native_theme = ui::NativeTheme::GetInstanceForNativeUi()) {
+    theme_observation_.Observe(native_theme);
+  }
+}
+
+PhlinkAppearanceObserver::~PhlinkAppearanceObserver() = default;
+
+void PhlinkAppearanceObserver::OnPrefChanged() {
+  Invalidate();
+}
+
+void PhlinkAppearanceObserver::OnNativeThemeUpdated(
+    ui::NativeTheme* /*observed_theme*/) {
+  // Only piggy-back when the user has not made an explicit choice.
+  const int mode = profile_->GetPrefs()->GetInteger(kAppearanceMode);
+  if (mode != kAppearanceModeFollowSystem) {
+    return;
+  }
+  Invalidate();
+}
+
+void PhlinkAppearanceObserver::Invalidate() {
+  // Per Phase 8 CONTEXT §5 (carry-forward from Phase 6): no telemetry on
+  // theme switches. Do NOT add UMA / UKM / RecordAction / log-to-disk here.
+  ++invalidation_count_;
+
+  // Reset the global color-provider cache so the next paint walk picks up the
+  // freshly-resolved palette. Existing chrome views observe `ui::NativeTheme`
+  // and `ThemeService`, which will repaint on their own; resetting the cache
+  // here is the precondition that makes those repaints pick up the new
+  // palette. Per D-11 we explicitly avoid any per-frame / per-window work
+  // here — the iteration the plan called for would be a no-op given the
+  // existing observer wiring, so we keep this method O(1).
+  ui::ColorProviderManager::Get().ResetColorProviderCache();
+}
+
+}  // namespace phlink::appearance
+
