+// Copyright 2026 The phlink Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/themes/phlink_appearance_observer_factory.h"
+
+#include <memory>
+
+#include "base/no_destructor.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/themes/phlink_appearance_observer.h"
+
+namespace phlink::appearance {
+
+// static
+PhlinkAppearanceObserver* PhlinkAppearanceObserverFactory::GetForProfile(
+    Profile* profile) {
+  return static_cast<PhlinkAppearanceObserver*>(
+      GetInstance()->GetServiceForBrowserContext(profile, /*create=*/true));
+}
+
+// static
+PhlinkAppearanceObserverFactory*
+PhlinkAppearanceObserverFactory::GetInstance() {
+  static base::NoDestructor<PhlinkAppearanceObserverFactory> instance;
+  return instance.get();
+}
+
+PhlinkAppearanceObserverFactory::PhlinkAppearanceObserverFactory()
+    : ProfileKeyedServiceFactory(
+          "PhlinkAppearanceObserver",
+          ProfileSelections::Builder()
+              .WithRegular(ProfileSelection::kOwnInstance)
+              // Incognito inherits from regular: incognito sessions track
+              // the regular profile's choice.
+              .WithGuest(ProfileSelection::kNone)
+              .Build()) {}
+
+PhlinkAppearanceObserverFactory::~PhlinkAppearanceObserverFactory() = default;
+
+std::unique_ptr<KeyedService>
+PhlinkAppearanceObserverFactory::BuildServiceInstanceForBrowserContext(
+    content::BrowserContext* context) const {
+  Profile* profile = Profile::FromBrowserContext(context);
+  return std::make_unique<PhlinkAppearanceObserver>(profile);
+}
+
+bool PhlinkAppearanceObserverFactory::ServiceIsCreatedWithBrowserContext()
+    const {
+  return true;
+}
+
+}  // namespace phlink::appearance
