@@ -5,6 +5,7 @@
 #include "chrome/browser/phlink/adblock/phlink_adblock.h"
 
 #include <memory>
+#include <iterator>
 
 #include "chrome/browser/phlink/adblock/engine_provider.h"
 #include "testing/gtest/include/gtest/gtest.h"
@@ -113,6 +114,41 @@ TEST(PhlinkAdblockBundledRulesTest, BlocksKnownAdHost) {
       << "bundled lists should not block first-party scripts";
 }
 
+TEST(PhlinkAdblockBundledRulesTest, BlocksTenSpotCheckHosts) {
+  // PRD §6 / phase 5-08 verification gate: the bundled engine must block
+  // a curated 10-URL spot-check list spanning the ad/tracking/analytics
+  // categories covered by EasyList + EasyPrivacy + Brave's MPL lists.
+  // These are not exhaustive — they are a regression canary.
+  auto engine = Engine::CreateFromRules(PhlinkBundledFilterRules());
+  ASSERT_TRUE(engine);
+
+  struct Spot { const char* url; const char* type; };
+  const Spot spots[] = {
+      {"https://doubleclick.net/ad/banner.js", "script"},
+      {"https://pagead2.googlesyndication.com/pagead/show_ads.js", "script"},
+      {"https://securepubads.g.doubleclick.net/tag/js/gpt.js", "script"},
+      {"https://www.google-analytics.com/analytics.js", "script"},
+      {"https://www.googletagmanager.com/gtm.js?id=GTM-XXX", "script"},
+      {"https://www.googletagservices.com/tag/js/gpt.js", "script"},
+      {"https://stats.g.doubleclick.net/dc.js", "script"},
+      {"https://adservice.google.com/adsid/integrator.js", "script"},
+      {"https://www.facebook.com/tr?id=1234567890&ev=PageView", "image"},
+      {"https://connect.facebook.net/en_US/fbevents.js", "script"},
+  };
+  const char* tab = "https://news.example.test/";
+  size_t blocked_count = 0;
+  for (const auto& s : spots) {
+    auto r = engine->ShouldBlock(s.url, tab, s.type);
+    if (r.matched) {
+      ++blocked_count;
+    } else {
+      ADD_FAILURE() << "spot-check URL not blocked: " << s.url;
+    }
+  }
+  EXPECT_EQ(blocked_count, std::size(spots))
+      << "phase 5-08 acceptance: all 10 spot-check URLs must block";
+}
+
 TEST(PhlinkAdblockCosmeticTest, HostScopedHideSelector) {
