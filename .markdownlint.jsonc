{
  // Markdownlint config for phlink.
  // PRD has its own conventions and is excluded.
  "default": true,
  "MD013": false,   // line length — let the prose breathe
  "MD024": { "siblings_only": true }, // duplicate headers OK in different sections
  "MD033": false,   // inline HTML allowed (we use <details>, etc.)
  "MD041": false,   // first line need not be H1 (some files start with quotes)
  "ignores": [
    "docs/dev/PRD.md",
    "CHANGELOG.md",
    ".refs/**",
    ".planning/**",
    ".github/skills/**",
    "node_modules/**"
  ]
}
